Cell["Solution", "Subsubsection",ExpressionUUID->"ddf27fdb-e3af-49ce-95fe-54069c5ae256"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"c1", "[", 
     RowBox[{"m_", ",", "l_", ",", "lp_"}], "]"}], "/;", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"l", "-", "lp"}], "]"}], "<=", "1"}], "&&", 
     RowBox[{
      RowBox[{"Min", "[", 
       RowBox[{"l", ",", "lp"}], "]"}], ">=", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "s", "]"}], ",", 
        RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}]}]}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "lp"}], "+", "1"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}], ")"}]}], "]"}], 
    RowBox[{"ClebschGordan", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lp", ",", "m"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "m"}], "}"}]}], "]"}], 
    RowBox[{"ClebschGordan", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lp", ",", 
        RowBox[{"-", "s"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", 
        RowBox[{"-", "s"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c1", "[", 
    RowBox[{"m_", ",", "l_", ",", "lp_"}], "]"}], ":=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"c2", "[", 
    RowBox[{"m_", ",", "l_", ",", "lp_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c1", "[", 
       RowBox[{"m", ",", "l", ",", "k"}], "]"}], 
      RowBox[{"c1", "[", 
       RowBox[{"m", ",", "k", ",", "lp"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "s", "]"}], ",", 
         RowBox[{"Abs", "[", "m", "]"}], ",", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"l", ",", "lp"}], "]"}], "-", "1"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"l", ",", "lp"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[2533]:=",ExpressionUUID->"9335f07a-7e45-4b7c-9673-99f4935e352e"],

