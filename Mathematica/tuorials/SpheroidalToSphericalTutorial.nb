Cell["Solution", "Subsubsection",ExpressionUUID->"750621e5-10e5-4ddb-ae89-8019d12c9acc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"muCol", "[", 
    RowBox[{"lp_", ",", "m_", ",", "\[Gamma]_", ",", "lmaxRow_", ",", 
     RowBox[{"n_", ":", "10"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lmin", "=", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "s", "]"}], ",", 
          RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ",", "Sf", ",", "c", ",",
        "l0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"\[Gamma]", "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"l", "==", "lp"}], ",", "1", ",", "0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"l", ",", "lmin", ",", "lmaxRow"}], "}"}]}], "]"}], 
         "]"}]}], "]"}], ";", 
      RowBox[{"Sf", "=", 
       RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
        RowBox[{"s", ",", "lp", ",", "m", ",", "\[Gamma]", ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<SphericalExpansion\>\"", ",", 
            RowBox[{"\"\<NumTerms\>\"", "->", "n"}]}], "}"}]}]}], "]"}]}], 
      ";", 
      RowBox[{"c", "=", 
       RowBox[{
        RowBox[{"Association", "[", 
         RowBox[{"Rest", "[", 
          RowBox[{
           RowBox[{"Sf", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Method\>\"", "]"}], 
          "]"}], "]"}], "[", "\"\<Coefficients\>\"", "]"}]}], ";", 
      RowBox[{"l0", "=", 
       RowBox[{"lp", "-", 
        RowBox[{"Min", "[", 
         RowBox[{
