Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"specMatrix", "[", 
    RowBox[{"m_", ",", "\[Gamma]_", ",", "lmaxB_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L", "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"Abs", "[", "s", "]"}], ",", 
           RowBox[{"Abs", "[", "m", "]"}]}], "]"}], ",", "lmaxB"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"l", "==", "lp"}], ",", 
          RowBox[{
           RowBox[{"l", 
            RowBox[{"(", 
             RowBox[{"l", "+", "1"}], ")"}]}], "-", 
           RowBox[{"s", 
            RowBox[{"(", 
             RowBox[{"s", "+", "1"}], ")"}]}]}], ",", "0"}], "]"}], "-", 
        RowBox[{
         RowBox[{"\[Gamma]", "^", "2"}], 
         RowBox[{"c2", "[", 
          RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}], "+", 
        RowBox[{"2", "\[Gamma]", "s", 
         RowBox[{"c1", "[", 
          RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"lp", ",", "L"}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"ev", ",", "vec"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"specMatrix", "[", 
     RowBox[{"2", ",", "g", ",", "20"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ord", "=", 
   RowBox[{"Ordering", "[", "ev", "]"}]}], ";", 
  RowBox[{"ev", "=", 
   RowBox[{"ev", "[", 
    RowBox[{"[", "ord", "]"}], "]"}]}], ";", 
  RowBox[{"vec", "=", 
   RowBox[{"vec", "[", 
    RowBox[{"[", "ord", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vec", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"vec", "[", 
        RowBox[{"[", 
         RowBox[{"k", ",", "k"}], "]"}], "]"}], "]"}], 
      RowBox[{"vec", "[", 
       RowBox[{"[", "k", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{"Length", "[", "vec", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SpinWeightedSpheroidalEigenvalue", "[", 
     RowBox[{"s", ",", "l", ",", "2", ",", "g"}], "]"}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"ev", "[", 
       RowBox[{"[", 
        RowBox[{"l", "-", "1"}], "]"}], "]"}], "+", 
      RowBox[{"g", "^", "2"}], "-", 
      RowBox[{"2", "*", "2", "*", "g"}]}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"l", ",", "2", ",", "5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{4.003915618648232*^9, 4.003918962659149*^9},
 CellLabel->
  "In[2549]:=",ExpressionUUID->"cac8f057-caf0-4e64-8a79-cca8157c2c18"],

