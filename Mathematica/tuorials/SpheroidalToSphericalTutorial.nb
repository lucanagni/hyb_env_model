   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "\"\<orbit\>\"", ",", " ", "\"\<|chi| v\>\"", ",", " ", 
