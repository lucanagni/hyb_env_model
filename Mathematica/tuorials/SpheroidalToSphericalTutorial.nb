       RowBox[{"muCol", "[", 
        RowBox[{"l", ",", "m", ",", "\[Gamma]", ",", "lmaxRow", ",", "n"}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Abs", "[", "m", "]"}]}], "]"}], ",", "lmaxCol"}], "}"}]}],
       "]"}], "]"}]}], "\[IndentingNewLine]", 
