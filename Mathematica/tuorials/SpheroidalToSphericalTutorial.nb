 RowBox[{
  RowBox[{"ip", "[", 
   RowBox[{"f_", ",", "g_"}], "]"}], ":=", 
  RowBox[{"2", "\[Pi]", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"f", "[", "\[Theta]", "]"}], "]"}], 
      RowBox[{"g", "[", "\[Theta]", "]"}], 
