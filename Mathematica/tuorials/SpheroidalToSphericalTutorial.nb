Cell["\<\
The deviation sits in the last column(s): S\:2086\:2082 has components on Y\
\:2087\:2082, Y\:2088\:2082, ... that the 5\[Times]5 table leaves out. \
Truncating rows loses norm. Keep this in mind for Section 7.\
\>", "Text",ExpressionUUID->"c53d2dd8-1211-471a-b908-c01248bcf69b"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. \[Mu] by the spectral method", "Section",ExpressionUUID->"7da2becb-c07d-462c-bd78-4092127fbaa3"],

Cell["\<\
Section 3 computed \[Mu] from overlap integrals of S. The spectral method \
never evaluates S at all. It rewrites the angular Teukolsky equation as an \
eigenvalue problem for a matrix in the Y basis, and the eigenvectors of that \
matrix are the columns of \[Mu].\
\>", "Text",ExpressionUUID->"96c8003c-2a96-4bc2-9e36-63208ab88113"],

Cell["\<\
Split the angular operator of Section 1 as L\:2080 + \[Gamma]\.b2 cos\.b2\
\[Theta] - 2\[Gamma]s cos\[Theta], where L\:2080 is the \[Gamma] = 0 part. L\
\:2080 is diagonal on the Y's: L\:2080 Y_\[ScriptL] = \
-(\[ScriptL](\[ScriptL]+1) - s(s+1)) Y_\[ScriptL]. The two \[Gamma] terms are \
multiplications by cos\[Theta] and cos\.b2\[Theta]. These are not diagonal: \
cos\[Theta] Y_\[ScriptL] is a combination of Y_{\[ScriptL]-1}, Y_\[ScriptL] \
and Y_{\[ScriptL]+1}. Their matrix elements in the Y basis are called c1 and \
c2:\
\>", "Text",ExpressionUUID->"36db0ee8-88b6-45a6-95a0-80fdbc94870a"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["c1", 
      RowBox[{"\[ScriptL]", ",", 
       SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
        MultilineFunction->None]}]], "\[LongEqual]", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["Y", 
             RowBox[{"\[ScriptL]", " ", "m"}]], ")"}]},
         "Conjugate"], " ", 
        RowBox[{"cos", "(", "\[Theta]", ")"}], " ", 
        SubscriptBox["Y", 
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], " ", "m"}]]}], 
       RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"da75f73b-b938-4a24-ab35-\
a45cbbabf4d8"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["c2", 
      RowBox[{"\[ScriptL]", ",", 
       SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
        MultilineFunction->None]}]], "\[LongEqual]", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["Y", 
             RowBox[{"\[ScriptL]", " ", "m"}]], ")"}]},
         "Conjugate"], " ", 
        RowBox[{
         SuperscriptBox["cos", "2"], "(", "\[Theta]", ")"}], " ", 
        SubscriptBox["Y", 
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], " ", "m"}]]}], 
       RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"316db8c5-4bc0-45e2-bce1-\
92ada7d10407"],

Cell["\<\
So c1 is the matrix of cos\[Theta] and c2 the matrix of cos\.b2\[Theta], at \
fixed m and s. Both are real and symmetric and do not depend on \[Gamma]: all \
the \[Gamma] dependence sits in the explicit factors \[Gamma] and \
\[Gamma]\.b2.\
\>", "Text",ExpressionUUID->"ca17f5a4-3bc9-49d0-9f85-cb618aa4e8a5"],

Cell["\<\
Now insert S_\[ScriptL]' = \[CapitalSigma]_\[ScriptL]'' \[Mu]_\[ScriptL]''\
\[ScriptL]' Y_\[ScriptL]'' into the angular equation (eigenvalue \
A_\[ScriptL]'), multiply by Y_\[ScriptL]* and integrate over the sphere. L\
\:2080 gives the diagonal term, the \[Gamma] terms give c1 and c2:\
\>", "Text",ExpressionUUID->"49a0029c-24db-4aeb-ba42-109db922d5bb"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
         MultilineFunction->None], "=", 
        RowBox[{"max", "(", 
         RowBox[{"2", ",", 
          TemplateBox[{"m"},
           "Abs"]}], ")"}]}], "\[Infinity]"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[ScriptL]", " ", 
             RowBox[{"(", 
              RowBox[{"\[ScriptL]", "+", "1"}], ")"}]}], "-", 
            RowBox[{"s", " ", 
             RowBox[{"(", 
              RowBox[{"s", "+", "1"}], ")"}]}]}], ")"}], " ", 
          TemplateBox[{
            RowBox[{"\[ScriptL]", ",", 
              SuperscriptBox[
              "\[ScriptL]", "\[Prime]\[Prime]", MultilineFunction -> None]}]},
           
           "KroneckerDeltaSeq"]}], "-", 
         RowBox[{
          SuperscriptBox["\[Gamma]", "2"], " ", 
          SubscriptBox["c2", 
           RowBox[{"\[ScriptL]", ",", 
            SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
             MultilineFunction->None]}]]}], "+", 
         RowBox[{"2", " ", "\[Gamma]", " ", "s", " ", 
          SubscriptBox["c1", 
           RowBox[{"\[ScriptL]", ",", 
            SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
             MultilineFunction->None]}]]}]}], ")"}], " ", 
       SubscriptBox["\[Mu]", 
        RowBox[{
         SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
          MultilineFunction->None], ",", 
         SuperscriptBox["\[ScriptL]", "\[Prime]",
          MultilineFunction->None]}]]}]}], "\[LongEqual]", 
     RowBox[{
      SubscriptBox["A", 
       SuperscriptBox["\[ScriptL]", "\[Prime]",
        MultilineFunction->None]], " ", 
      SubscriptBox["\[Mu]", 
       RowBox[{"\[ScriptL]", ",", 
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None]}]]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"6c367ae4-7c0b-47d7-9c25-\
5f5dea5ce3a4"],

Cell["\<\
In words: build the matrix M = diag(\[ScriptL](\[ScriptL]+1) - s(s+1)) - \
\[Gamma]\.b2 c2 + 2\[Gamma]s c1. Its eigenvalues are the spheroidal \
eigenvalues A_\[ScriptL]' and its eigenvectors are the columns of \[Mu]. At \
\[Gamma] = 0, M is diagonal and \[Mu] = 1, as it should be. What is left is \
to compute c1 and c2.\
\>", "Text",ExpressionUUID->"d02fd7a3-1a4d-48fb-93ad-38b771f2daae"],

Cell["\<\
c1 has a closed form. Write cos\[Theta] = \[Sqrt](4\[Pi]/3) \:2080Y\:2081\
\:2080. The integral of three spin-weighted harmonics is a product of two \
Clebsch\[Dash]Gordan coefficients, one carrying m and one carrying the spin \
weight -s:\
\>", "Text",ExpressionUUID->"47048a5c-ba80-4850-9506-cd4a42cb78bb"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["c1", 
      RowBox[{"\[ScriptL]", ",", 
       SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
        MultilineFunction->None]}]], "\[LongEqual]", 
     RowBox[{
      SqrtBox[
       FractionBox[
        RowBox[{
         RowBox[{"2", " ", 
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None]}], "+", "1"}], 
        RowBox[{
         RowBox[{"2", " ", "\[ScriptL]"}], "+", "1"}]]], " ", 
      TagBox[
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], "\[MediumSpace]", "1", "\[MediumSpace]", 
          "m", "\[MediumSpace]", "0"}], "\[MediumSpace]", 
         "\[VerticalSeparator]", "\[MediumSpace]", 
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], "\[MediumSpace]", "1", "\[MediumSpace]", 
          "\[ScriptL]", "\[MediumSpace]", "m"}]}], "\[RightAngleBracket]"}],
       ClebschGordan,
       StripWrapperBoxes->True], " ", 
      TagBox[
       RowBox[{"\[LeftAngleBracket]", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], "\[MediumSpace]", "1", "\[MediumSpace]", 
          
          RowBox[{"-", "s"}], "\[MediumSpace]", "0"}], "\[MediumSpace]", 
         "\[VerticalSeparator]", "\[MediumSpace]", 
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
           MultilineFunction->None], "\[MediumSpace]", "1", "\[MediumSpace]", 
          "\[ScriptL]", "\[MediumSpace]", 
          RowBox[{"-", "s"}]}]}], "\[RightAngleBracket]"}],
       ClebschGordan,
       StripWrapperBoxes->True]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"a08c0a52-060d-447a-82ab-\
dfe0fff13d34"],

Cell["\<\
The first Clebsch\[Dash]Gordan coefficient vanishes unless |\[ScriptL] - \
\[ScriptL]''| \[LessEqual] 1, so c1 is tridiagonal. Its diagonal is c1_\
\[ScriptL]\[ScriptL] = -ms/(\[ScriptL](\[ScriptL]+1)), nonzero because s \
\[NotEqual] 0. For c2, use cos\.b2\[Theta] = cos\[Theta] \[CenterDot] cos\
\[Theta] and insert a complete set of Y_k in between: c2 is the matrix \
product of c1 with itself.\
\>", "Text",ExpressionUUID->"34c4cf28-64d8-4947-8be0-627c571003c8"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["c2", 
      RowBox[{"\[ScriptL]", ",", 
       SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
        MultilineFunction->None]}]], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"k", "=", 
        RowBox[{"max", "(", 
         RowBox[{"2", ",", 
          TemplateBox[{"m"},
           "Abs"]}], ")"}]}], "\[Infinity]"], 
      RowBox[{
       SubscriptBox["c1", 
        RowBox[{"\[ScriptL]", ",", "k"}]], " ", 
       SubscriptBox["c1", 
        RowBox[{"k", ",", 
         SuperscriptBox["\[ScriptL]", "\[Prime]\[Prime]",
          MultilineFunction->None]}]]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"12d69d36-d5e0-4599-8382-\
202b9ebd7932"],

Cell["\<\
c2 couples \[ScriptL] to \[ScriptL]'' up to \[ScriptL] \[PlusMinus] 2, so M \
is pentadiagonal. Careful when truncating: in practice M is built on a finite \
range \[ScriptL] = \[ScriptL]min \[Ellipsis] \[ScriptL]max. Squaring the \
truncated c1 matrix does not give c2 there: in the last rows the intermediate \
state k = \[ScriptL]max + 1 is missing and the entries come out wrong. \
Compute each c2 entry with the sum over k running up to max(\[ScriptL], \
\[ScriptL]'') + 1, wherever the matrix is cut (the solution's c2 does this).\
\>", "Text",ExpressionUUID->"da9d3d56-592b-46d1-827f-d6b53e89d40b"],

Cell["\<\
Two bookkeeping choices fix \[Mu] completely. Labels: which eigenvector is \
which \[ScriptL]'? For real \[Gamma] the angular equation is a 1D \
Sturm\[Dash]Liouville problem, whose eigenvalues are non-degenerate, so they \
cannot cross as \[Gamma] grows from 0. At \[Gamma] = 0 they are ordered by \
\[ScriptL]. So sort the eigenvalues in increasing order and assign \
\[ScriptL]' = \[ScriptL]min, \[ScriptL]min+1, \[Ellipsis] Signs: each \
eigenvector is defined only up to an overall sign. The package picks the sign \
that makes the diagonal entry \[Mu]_\[ScriptL]'\[ScriptL]' positive, so that \
S_\[ScriptL]' \[RightArrow] +Y_\[ScriptL]' as \[Gamma] \[RightArrow] 0. \
Section 5 checks that this matches the S used for the Teukolsky amplitudes.\
\>", "Text",ExpressionUUID->"28df32c1-1e96-412d-ad3c-585fef203659"],

Cell["\<\
This is what the package does in SWSHSSpectral \
(SpinWeightedSpheroidalHarmonics.m, around line 519). Its matrix is -(M + \
s(s+1)\[CenterDot]1), which has the same eigenvectors: kHat is the diagonal, \
kTilde2 the \[PlusMinus]1 and k2 the \[PlusMinus]2 off-diagonal entries. For \
S_\[ScriptL]' it truncates to a window \[ScriptL] = \[ScriptL]' - nDown \
\[Ellipsis] \[ScriptL]' + nUp around \[ScriptL]', not to a fixed range \
starting at \[ScriptL]min.\
\>", "Text",ExpressionUUID->"08de1671-5a13-47a1-a8f3-159078b4ffcd"],

Cell[CellGroupData[{

Cell["Exercise 3", "Subsection",ExpressionUUID->"f1f195da-451b-4231-b70a-48dbe3a28dfa"],

Cell["\<\
(a) Implement c1[m, l, lp] and c2[m, l, lp] from the formulas above \
(ClebschGordan complains when the triangle rule fails, so return 0 for |l - \
lp| > 1 by hand. Only in c1 (for c2 it would be >0)). Check one element of \
each against ip. (b) Build specMatrix[m, \[Gamma], lmaxB] on \[ScriptL] = \
\[ScriptL]min..lmaxB, diagonalise it, and sort the eigenvalues. Compare A + \
\[Gamma]\.b2 - 2m\[Gamma] with SpinWeightedSpheroidalEigenvalue for \
\[ScriptL] = 2..5. (c) Fix the eigenvector signs so the diagonal entries are \
positive, and compare the 5\[Times]5 block of \[Mu] with muBFtab.\
\>", "Text",
 CellChangeTimes->{{4.00391796828018*^9, 
  4.003917982027219*^9}},ExpressionUUID->"6043848e-8dd0-453a-851d-\
f9426b10bb38"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c1", "[", 
   RowBox[{"m_", ",", "l_", ",", "lp_"}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"l", "-", "lp"}], "]"}], ">", "1"}], ",", "0", ",", 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{
        RowBox[{"2", "lp"}], "+", "1"}], 
       RowBox[{
        RowBox[{"2", "l"}], "+", "1"}]]], 
     RowBox[{"ClebschGordan", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lp", ",", "m"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "m"}], "}"}]}], "]"}], 
     RowBox[{"ClebschGordan", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lp", ",", 
         RowBox[{"-", "s"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", 
         RowBox[{"-", "s"}]}], "}"}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2", "[", 
    RowBox[{"m_", ",", "l_", ",", "lp_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"l", "-", "lp"}], "]"}], ">", "2"}], ",", "0", ",", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c1", "[", 
         RowBox[{"m", ",", "l", ",", "k"}], "]"}], "*", 
        RowBox[{"c1", "[", 
         RowBox[{"m", ",", "k", ",", "lp"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Abs", "[", "m", "]"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"l", ",", "lp"}], "]"}], "+", "1"}]}], "}"}]}], "]"}]}], 
    "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "a", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lp", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gamma", "=", "0.5`30"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "0"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "\[Theta]_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "lp", ",", "m", ",", "\[Theta]", ",", "0"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g2", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"], " ", 
    RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
     RowBox[{"s", ",", "lp", ",", "m", ",", "\[Theta]", ",", "0"}], "]"}]}]}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"c1", "[", 
      RowBox[{"m", ",", "l", ",", "lp"}], "]"}], "-", 
     RowBox[{"InnProd2", "[", 
      RowBox[{"f", ",", "g"}], "]"}]}], ")"}], "/", 
   RowBox[{"c1", "[", 
    RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}], " ", "//", 
  "FullSimplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"c2", "[", 
      RowBox[{"m", ",", "l", ",", "lp"}], "]"}], "-", 
     RowBox[{"InnProd2", "[", 
      RowBox[{"f", ",", "g2"}], "]"}]}], ")"}], "/", 
   RowBox[{"c2", "[", 
    RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}], " ", "//", 
  "FullSimplify"}]}], "Input",
