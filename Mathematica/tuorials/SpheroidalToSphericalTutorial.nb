      RowBox[{"\[Theta]", ",", "0", ",", "\[Pi]"}], "}"}], ",", 
     RowBox[{"WorkingPrecision", "->", "25"}], ",", 
     RowBox[{"PrecisionGoal", "->", "12"}], ",", 
     RowBox[{"AccuracyGoal", "->", "15"}]}], "]"}]}]}]], "Input",
