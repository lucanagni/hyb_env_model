   RowBox[{
    RowBox[{"InnProd2", "[", 
     RowBox[{"f_", ",", "g_"}], "]"}], ":=", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"f", "[", "\[Theta]", "]"}], "]"}], "*", 
