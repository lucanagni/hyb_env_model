Cell["\<\
\[Gamma] stored in the mode is a\[CenterDot]\[Omega] with \[Omega] = m\
\[CapitalOmega] = m/(r^{3/2} + a), as expected.\
\>", "Text",ExpressionUUID->"f579d200-b87f-4dc2-b2bd-11bb21ca8a4a"],

Cell[CellGroupData[{

Cell["Exercise 5", "Subsection",ExpressionUUID->"f7fba3e1-9880-41b2-a32a-69c1baf92fd2"],

Cell["\<\
(a) Compare SL[\[Theta], 0] with \[CapitalSigma]_\[ScriptL] \[Mu]_\[ScriptL]3 \
Y_\[ScriptL]2(\[Theta]) (use muCol) at \[Theta] = 0.3, 1.2, 2.5. (b) \
Retrograde: compute the \[ScriptL]' = 2, m = 2 mode for KerrGeoOrbit[0.9`30, \
8`30, 0, -1]. What are the signs of \[Omega] and of \[Gamma]? Compare \
\[Gamma] with Honet's \[Gamma]_m = m \[Chi] \[CapitalOmega]\:0302, \
\[CapitalOmega]\:0302 = 1/(\[Chi] + r^{3/2}) with \[Chi] = -0.9.\
\>", "Text",ExpressionUUID->"e7d51b5c-eb43-48e5-8f22-837139747ff1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]", "=", 
   RowBox[{"muCol", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SL", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<l\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"SL", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<m\>\"", "]"}], ",", 
     RowBox[{
      RowBox[{"SL", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<\[Gamma]\>\"", "]"}], ",", 
     "16", ",", "12"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"SL", "[", 
     RowBox[{"\[Theta]", ",", "0"}], "]"}], "-", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "*", 
       RowBox[{"Y", "[", 
        RowBox[{
         RowBox[{"i", "+", "1"}], ",", 
         RowBox[{
          RowBox[{"SL", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<m\>\"", "]"}], ",", 
         "\[Theta]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", 
        RowBox[{"Length", "[", "\[Mu]", "]"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", 
     RowBox[{"{", 
      RowBox[{"0.3", ",", "1.2", ",", "2.5"}], "}"}]}], "}"}]}], 
  "]"}]}], "Input",
