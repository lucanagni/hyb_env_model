Notebook[{
Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellChangeTimes->{{4.003816322190238*^9, 4.003816328802445*^9}},
 CellLabel->
  "In[2577]:=",ExpressionUUID->"b0b8e24f-fd1c-4f81-8b86-a0affcb363ad"],

Cell[CellGroupData[{

Cell["From spheroidal to spherical mode amplitudes", "Title",ExpressionUUID->"bb1f8cff-4ebf-4eb6-901c-d7b746ad14a3"],

Cell["\<\
Goal: turn the Teukolsky amplitudes C^up_\[ScriptL]'m, which the Teukolsky \
package returns in the basis of spin-weighted spheroidal harmonics \:208b\
\:2082S_\[ScriptL]'m(\[Theta];\[Gamma]), into amplitudes C_\[ScriptL]m in the \
basis of spin-weighted spherical harmonics \
\:208b\:2082Y_\[ScriptL]m(\[Theta]), the basis of the PN waveform. This is \
Honet+ 2025 App. A3, eqs. (A24)-(A31).\
\>", "Text",
 CellChangeTimes->{{4.003812476173749*^9, 
  4.003812477039007*^9}},ExpressionUUID->"c82eee17-e198-44c9-85c1-\
616c92fe9650"],

Cell["\<\
Roadmap: (0) conventions, (1) spherical vs spheroidal harmonics, (2) why the \
change of basis is a matrix \[Mu], (3) \[Mu] by brute-force overlap \
integrals, (4) \[Mu] by the spectral method (what the package does inside), \
(5) making sure \[Mu] refers to the same S the Teukolsky amplitude was \
computed with, (6) the change of basis at one orbit, with checks, (7) \
truncation in \[ScriptL]', (8) what the production code for the Honet grid \
needs.\
\>", "Text",ExpressionUUID->"856472d1-d05f-4dfe-95d4-d9e3a5e6afca"],

Cell["\<\
Each exercise has an empty input cell for your attempt and a closed \
\"Solution\" group below it (double-click the group bracket to open it). \
Later sections use functions defined in earlier solutions, so evaluate the \
solutions in order if you skip an exercise.\
\>", "Text",ExpressionUUID->"d5f3a43d-6dfd-49cc-a72b-f2ae6082b624"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<SpinWeightedSpheroidalHarmonics`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"-", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", "[", 
    RowBox[{"l_", ",", "m_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
    RowBox[{"s", ",", "l", ",", "m", ",", "\[Theta]", ",", "0"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{4.004081927326312*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"04639614-9cdd-4da2-b316-578db866aa37"],

Cell[CellGroupData[{

Cell["0. Conventions", "Section",ExpressionUUID->"d0bda9b7-d17c-4662-adad-7130ceff6f13"],

Cell["\<\
Honet+ eq. (A1): for a point mass on a circular equatorial orbit with angular \
freq9ouency \[CapitalOmega], \[CapitalPsi]4 is decomposed in spheroidal \
harmonics. Each m oscillates at the single frequency \[Omega] = m\
\[CapitalOmega], and the spheroidicity of the angular functions is\
\>", "Text",
 CellChangeTimes->{{4.004084141836363*^9, 
  4.0040841418812*^9}},ExpressionUUID->"b2224f9b-3cba-4384-b49e-313544db8bf9"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Gamma]", "m"], "\[LongEqual]", 
     RowBox[{"a", " ", "\[Omega]"}], "\[LongEqual]", 
     RowBox[{"a", " ", "m", " ", "\[CapitalOmega]"}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"c533b47a-adb3-4780-a3e9-\
4e34f4b78606"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Zeta]", "4"], " ", 
      SubscriptBox["\[CapitalPsi]", "4"]}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None], "=", "2"}], "\[Infinity]"], 
      RowBox[{
       UnderoverscriptBox["\[Sum]", 
        RowBox[{"m", "=", 
         RowBox[{"-", 
          SuperscriptBox["\[ScriptL]", "\[Prime]",
           MultilineFunction->None]}]}], 
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None]], 
       RowBox[{
        RowBox[{
         SubscriptBox["R", 
          RowBox[{
           SuperscriptBox["\[ScriptL]", "\[Prime]",
            MultilineFunction->None], " ", "m"}]], "(", "r", ")"}], " ", 
        RowBox[{
         SubscriptBox["S", 
          RowBox[{
           SuperscriptBox["\[ScriptL]", "\[Prime]",
            MultilineFunction->None], " ", "m"}]], "(", 
         RowBox[{"\[Theta]", ",", "\[CurlyPhi]", ",", 
          SubscriptBox["\[Gamma]", "m"]}], ")"}], " ", 
        RowBox[{"exp", "(", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "m", " ", "\[CapitalOmega]", 
          " ", "t"}], ")"}]}]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"c8a2bf94-6918-4614-9d7b-\
786520330e94"],

Cell[TextData[{
 "with \[Zeta] = r - i a cos\[Theta]. Far from the source, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"], 
            StyleBox["m", "TI"]}]], "\[Rule]", 
         SubsuperscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{
            SuperscriptBox[
             StyleBox["l", "TI"], "\[Prime]"], 
            StyleBox["m", "TI"]}], "up"], 
         StyleBox["r", "TI"], "\.b3", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Omega]", 
            SubscriptBox[
             StyleBox["r", "TI"], "*"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "R_{l'm} \\rightarrow C^{\\rm up}_{l'm} r\.b3 e^{i\\omega r_*}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ed58c16-9779-4a2c-adc0-85ad2b9f6957"],
 ", and Honet (A24) defines the spheroidal waveform modes as"
}], "Text",
 CellChangeTimes->{{4.003812571008844*^9, 
  4.003812574795019*^9}},ExpressionUUID->"954fb038-ea6d-43e5-8705-\
a656ddcbd887"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox[
      OverscriptBox["h", "~"], 
      RowBox[{
       SuperscriptBox["\[ScriptL]", "\[Prime]",
        MultilineFunction->None], " ", "m"}]], "\[LongEqual]", 
     FractionBox[
      RowBox[{"2", " ", 
       TemplateBox[{"C", 
         RowBox[{
           SuperscriptBox[
           "\[ScriptL]", "\[Prime]", MultilineFunction -> None], " ", "m"}], 
         "up"},
        "Subsuperscript"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"m", " ", "\[CapitalOmega]"}], ")"}], "2"]]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"711e3082-31f9-4d50-b5ec-\
97dd8c04ed1f"],

Cell["Three facts make the change of basis simple:", "Text",ExpressionUUID->"a0b1bc5f-401d-45fc-9ccf-a12c85b5035f"],

Cell["\<\
At r \[RightArrow] \[Infinity], \[Zeta]\:2074 \[RightArrow] r\:2074(1 + \
O(1/r)), so all angular dependence of the 1/r part sits in S_\[ScriptL]'m. \
The change of basis is purely angular.\
\>", "Item",ExpressionUUID->"0d6ae858-5903-4139-8cdb-13615b52e80c"],

Cell["\<\
It is linear, so the same matrix \[Mu] acts on \[CapitalPsi]4, on C^up and on \
h\:0303. We work with C^up = md[\"Amplitudes\"][\"\[ScriptCapitalI]\"].\
\>", "Item",ExpressionUUID->"b16ac715-a2ac-4e43-a2c1-783405dee9ee"],

Cell["\<\
m is the same in both bases (both carry e^{im\[CurlyPhi]}). For a circular \
orbit there is one \[Gamma]_m per m, shared by all \[ScriptL]'. So for each m \
you need one matrix \[Mu]_{\[ScriptL]\[ScriptL]'}(\[Gamma]_m), not one per \
mode.\
\>", "Item",ExpressionUUID->"a5c2bd6a-2536-4757-9368-c3a8dd5f4ce6"],

Cell["\<\
In the package, a \[GreaterEqual] 0 always, and retrograde orbits have x = -1 \
(as in FluxesGrid.nb). Honet instead uses a signed \[Chi] with \
\[CapitalOmega]\:0302 > 0. Section 5 checks that both give the same \
\[Gamma]_m.\
\>", "Text",ExpressionUUID->"9aaeaaf4-c867-4ebf-9b17-b970231fc903"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Spherical vs spheroidal harmonics", "Section",ExpressionUUID->"c83ba700-8a9f-4a5c-b4d0-d7d591ef65c6"],

Cell["\<\
\:208b\:2082S_\[ScriptL]m(\[Theta];\[Gamma]) solves the angular Teukolsky \
equation (s = -2, eigenvalue A):\
\>", "Text",ExpressionUUID->"d0552f22-3f8f-4af3-97c5-116c806b70b8"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      FractionBox[
       TagBox[
        RowBox[{
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", "\[Theta]"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sin", "(", "\[Theta]", ")"}], " ", 
           FractionBox[
            RowBox[{"\[PartialD]", "S"}], 
            RowBox[{"\[PartialD]", "\[Theta]"}],
            MultilineFunction->None]}], ")"}]}],
        D], 
       RowBox[{"sin", "(", "\[Theta]", ")"}]], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["\[Gamma]", "2"], " ", 
          RowBox[{
           SuperscriptBox["cos", "2"], "(", "\[Theta]", ")"}]}], "-", 
         RowBox[{"2", " ", "\[Gamma]", " ", "s", " ", 
          RowBox[{"cos", "(", "\[Theta]", ")"}]}], "-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"m", "+", 
             RowBox[{"s", " ", 
              RowBox[{"cos", "(", "\[Theta]", ")"}]}]}], ")"}], "2"], 
          RowBox[{
           SuperscriptBox["sin", "2"], "(", "\[Theta]", ")"}]], "+", "s", "+",
          "A"}], ")"}], " ", "S"}]}], "\[LongEqual]", "0"}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"cf6d447e-5fb4-4e04-a4df-\
0df9934a62b0"],

Cell["\<\
At \[Gamma] = 0 the \[Gamma] terms drop out and S = \:209bY_\[ScriptL]m with \
A = \[ScriptL](\[ScriptL]+1) - s(s+1). The package's \
SpinWeightedSpheroidalEigenvalue returns \[Lambda] = A + \[Gamma]\.b2 - 2m\
\[Gamma], not A. Both S and Y include e^{im\[CurlyPhi]} and are normalised to \
1 over the sphere. In this notebook we set \[CurlyPhi] = 0 and write \
\[Integral]d\[CapitalOmega] = 2\[Pi]\[Integral] sin\[Theta] d\[Theta], \
because the e^{im\[CurlyPhi]} factors cancel in every overlap at fixed m.\
\>", "Text",ExpressionUUID->"2b79171e-8cb9-48da-aa5f-decf0545ab5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sg", "=", 
  RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
   RowBox[{"s", ",", "2", ",", "2", ",", "0.5`30"}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"61d7f8a5-5364-4ccf-97c7-911e357a61e5"],

