Cell["\<\
The first is close to 1 and the second is small but non-zero: S\:2082\:2082 \
\"leaks\" into \[ScriptL] = 3. Both are real because \[Gamma] is real and \
\[CurlyPhi] = 0.\
\>", "Text",ExpressionUUID->"9e991cd2-64f3-41a6-acb1-bcd3237c6111"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Why a change of basis is a matrix", "Section",ExpressionUUID->"d7a67374-ceab-4ac8-a062-305db4f31b55"],

Cell["\<\
Expand each spheroidal harmonic in spherical ones at the same m and the same \
\[Gamma] = \[Gamma]_m:\
\>", "Text",ExpressionUUID->"da7c6577-a500-4c4b-8dd6-1e027ac456ae"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["S", 
       RowBox[{
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None], " ", "m"}]], "(", 
      RowBox[{"\[Theta]", ",", 
       SubscriptBox["\[Gamma]", "m"]}], ")"}], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"\[ScriptL]", "=", 
        RowBox[{"max", "(", 
         RowBox[{"2", ",", 
          TemplateBox[{"m"},
           "Abs"]}], ")"}]}], "\[Infinity]"], 
      RowBox[{
       SubscriptBox["\[Mu]", 
        RowBox[{"\[ScriptL]", ",", 
         SuperscriptBox["\[ScriptL]", "\[Prime]",
          MultilineFunction->None]}]], " ", 
       RowBox[{
        SubscriptBox["Y", 
         RowBox[{"\[ScriptL]", " ", "m"}]], "(", "\[Theta]", ")"}]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"c3f6c462-a13b-4540-aa70-\
0a918166138a"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["\[Mu]", 
      RowBox[{"\[ScriptL]", ",", 
       SuperscriptBox["\[ScriptL]", "\[Prime]",
        MultilineFunction->None]}]], "\[LongEqual]", 
     RowBox[{"\[Integral]", 
      RowBox[{
       RowBox[{
        TemplateBox[{
          RowBox[{"(", 
            SubscriptBox["Y", 
             RowBox[{"\[ScriptL]", " ", "m"}]], ")"}]},
         "Conjugate"], " ", 
        SubscriptBox["S", 
         RowBox[{
          SuperscriptBox["\[ScriptL]", "\[Prime]",
           MultilineFunction->None], " ", "m"}]]}], 
       RowBox[{"\[DifferentialD]", "\[CapitalOmega]"}]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"50a37313-420e-4e31-b86b-\
9afe650f7807"],

Cell["\<\
Insert this into \[CapitalSigma]_\[ScriptL]' C_\[ScriptL]'m S_\[ScriptL]'m \
and collect the coefficient of Y_\[ScriptL]m. That gives Honet (A25):\
\>", "Text",ExpressionUUID->"8e2913cb-5d24-406c-8c0c-3ddae7582eb0"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["C", 
      RowBox[{"\[ScriptL]", " ", "m"}]], "\[LongEqual]", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None], "=", 
        RowBox[{"max", "(", 
         RowBox[{"2", ",", 
          TemplateBox[{"m"},
           "Abs"]}], ")"}]}], "\[Infinity]"], 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Mu]", 
         RowBox[{"\[ScriptL]", ",", 
          SuperscriptBox["\[ScriptL]", "\[Prime]",
           MultilineFunction->None]}]], "(", 
        SubscriptBox["\[Gamma]", "m"], ")"}], " ", 
       SubscriptBox["C", 
        RowBox[{
         SuperscriptBox["\[ScriptL]", "\[Prime]",
          MultilineFunction->None], " ", "m"}]]}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"c6f05fe4-2830-47b8-9f6c-\
a8c515e84bff"],

Cell["\<\
Column \[ScriptL]' of \[Mu] holds the spherical components of S_\[ScriptL]'. \
Both bases are orthonormal, so \[Mu] is orthogonal (real for real \[Gamma]): \
\[Mu]\:1d40\[Mu] = 1 for the infinite matrix. In practice both sums are \
truncated (Section 7). Its entries fall off like \[Gamma]^|\[ScriptL]-\
\[ScriptL]'|, so \[Mu] is close to the identity for small \[Gamma].\
\>", "Text",ExpressionUUID->"57b3faf9-e7cc-4d22-9365-5607d4f2431b"],

Cell["\<\
Symmetry under m \[RightArrow] -m. Equatorial circular orbits have \
\[Gamma]_{-m} = -\[Gamma]_m, and the mixing matrices are related by\
\>", "Text",ExpressionUUID->"33a99406-6020-4ba1-a4e0-16ebb0aa3165"],

Cell[BoxData[
 TagBox[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{
      SubscriptBox["\[Mu]", 
       RowBox[{"\[ScriptL]", ",", 
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None]}]], "(", 
      RowBox[{
       RowBox[{"-", "m"}], ",", 
       RowBox[{"-", "\[Gamma]"}]}], ")"}], "\[LongEqual]", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"\[ScriptL]", "+", 
        SuperscriptBox["\[ScriptL]", "\[Prime]",
         MultilineFunction->None]}]], " ", 
      RowBox[{
       SubscriptBox["\[Mu]", 
        RowBox[{"\[ScriptL]", ",", 
         SuperscriptBox["\[ScriptL]", "\[Prime]",
          MultilineFunction->None]}]], "(", 
       RowBox[{"m", ",", "\[Gamma]"}], ")"}]}]}],
    HoldForm],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "DisplayFormula",ExpressionUUID->"b2e20c58-fb11-4a0e-be72-\
1b414c102109"],

Cell["\<\
so you only ever need m > 0 (m = 0 modes are excluded in Honet, since (A24) \
is singular there).\
\>", "Text",ExpressionUUID->"6826f62c-1743-494b-8fb4-a6e5efd758f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. \[Mu] by brute force", "Section",ExpressionUUID->"9f5a0e8b-bab0-42c3-a41c-f20ca5a3c161"],

Cell["\<\
The definition in Section 2 is an integral, so the most direct (slow) route \
is NIntegrate. Keep this as ground truth for the faster method.\
\>", "Text",ExpressionUUID->"d4374156-8fef-4cb9-b7b4-955a701ddc19"],

Cell[CellGroupData[{

Cell["Exercise 2", "Subsection",ExpressionUUID->"77a982f9-16cb-4c19-a6b0-5ff5d378e6d9"],

Cell["\<\
Write muBF[l, lp, m, \[Gamma]] = \:27e8Y_lm|S_lp,m(\[Gamma])\:27e9 using ip \
from Exercise 1. Tabulate muBFtab = \[Mu]_{\[ScriptL]\[ScriptL]'} for m = 2, \
\[Gamma] = 0.5`30 and \[ScriptL], \[ScriptL]' = 2..6 (rows \[ScriptL], \
columns \[ScriptL]'). Look at how fast entries decay away from the diagonal, \
and check whether Transpose[muBFtab].muBFtab is close to the identity. Which \
entries deviate most, and why?\
\>", "Text",ExpressionUUID->"a0285ae7-d59c-4e7c-aedb-36d989cbd93f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"muBF", "[", 
   RowBox[{"l_", ",", "lp_", ",", "m_", ",", "\[Gamma]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"S", ",", "Y"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"S", "[", "\[Theta]_", "]"}], "=", 
      RowBox[{
       RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "lp", ",", "m", ",", "\[Gamma]"}], "]"}], 
       "[", 
       RowBox[{"\[Theta]", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Y", "[", "\[Theta]_", "]"}], "=", 
      RowBox[{"SpinWeightedSphericalHarmonicY", "[", 
       RowBox[{
        RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "\[Theta]", ",", "0"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"InnProd2", "[", 
      RowBox[{"Y", ",", "S"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.003817857358519*^9, 4.003818090699755*^9}, {
  4.003818179562874*^9, 4.003818245374284*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"b163c4b7-9b1f-4eed-8b8b-ce6a5f04c730"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ellmin", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"2", ",", 
       RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ellmax", "=", "6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muBFTab", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"muBF", "[", 
        RowBox[{"l", ",", "lp", ",", "m", ",", "0.5`30"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "ellmin", ",", "ellmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"lp", ",", "ellmin", ",", "ellmax"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"muBFTab", "//", "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Transpose", "[", "muBFTab", "]"}], ".", "muBFTab"}], "//", 
    "MatrixForm"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Chop", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Transpose", "[", "muBFTab", "]"}], ".", "muBFTab"}], "-", 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"ellmax", "-", "ellmin", "+", "1"}], "]"}]}], ",", 
      SuperscriptBox["10", 
       RowBox[{"-", "8"}]]}], "]"}], "//", "MatrixForm"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Clear", "[", 
    RowBox[{"m", ",", "ellmin", ",", "ellmax"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.003818212614977*^9, 4.003818222253152*^9}, {
