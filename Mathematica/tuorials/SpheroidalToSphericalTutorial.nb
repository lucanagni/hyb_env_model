        RowBox[{"s", ",", "l", ",", "m", ",", "gamma"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "lmin", ",", "lmax"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"out", "-", "tabulated"}], ")"}], "/", 
    "tabulated"}]}]}]], "Input",
