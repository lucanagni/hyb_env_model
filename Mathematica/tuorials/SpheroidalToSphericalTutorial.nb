Cell["\<\
For the retrograde orbit the package has \[CapitalOmega]_\[CurlyPhi] < 0, so \
\[Omega] = m\[CapitalOmega]_\[CurlyPhi] < 0 and \[Gamma] = a\[Omega] < 0. \
This is the same number as Honet's \[Gamma]_m = m\[Chi]\[CapitalOmega]\:0302. \
So \[Mu](m, \[Gamma]) built from the mode's own \[Gamma] is the right matrix \
in both conventions. Beware that the two frames differ by a flip of the z \
axis (\[CurlyPhi] \[RightArrow] -\[CurlyPhi]). The package's mode m in the \
retrograde case is not Honet's mode m, though |C_\[ScriptL]m| agree by the \
symmetry of Section 2. Fix this when you define the phases \
\[Delta]\[CurlyPhi]_\[ScriptL]m.\
\>", "Text",ExpressionUUID->"49018957-745d-4d41-927b-2a63836b4156"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. What the change of basis does at one orbit", "Section",ExpressionUUID->"2b9f84b6-3375-4de6-a068-6a5fca7b07c6"],

Cell["\<\
Physics: notes/spheroidal_to_spherical.pdf, Section 3 (eqs. 8-9, Table 1). \
From here on all data handling is given. The spheroidal amplitudes Cup for \
six orbits are precomputed in data/sphdAmps_examples.m (m = 2, 4, 6, 8; \
columns l' = max(2,m) ... 14; at least 12 digits each), so every cell runs in \
seconds. Spend the time on the questions, not on the code.\
\>", "Text",ExpressionUUID->"7d098ea4-61a9-4fe0-a2f9-d30c0f067a83"],

Cell[CellGroupData[{

Cell["Toolbox (given: just run it)", "Subsection",ExpressionUUID->"9f44eb33-8b00-40b0-9d35-9ac70b98c764"],

Cell["\<\
Needs muMatrix from the Exercise 4 solution. amps[key, m] returns \
<|\"omega\", \"gamma\", \"lp\", \"Cup\", \"prec\"|> for one orbit and one m. \
toSpherical[m, \[Gamma], Cup, lRowMax] returns the spherical C_l for l = \
max(2,m) ... lRowMax, using all the columns you pass. cTrunc and errTrunc are \
for Exercise 7. chiOf is Honet's signed \[Chi], vOf = \
|\[CapitalOmega]|^(1/3). Orbit keys: a = spin, r = r0, isco = 1.05 r_ISCO \
prograde, retro = retrograde.\
\>", "Text",ExpressionUUID->"042bfc1e-da9f-490f-87d1-eff0e3aed06a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataDir", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "$Notebooks", "]"}], ",", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "\"\<data\>\""}], 
       "}"}], "]"}], ",", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<data\>\""}], "}"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sphdData", " ", "=", " ", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dataDir", ",", " ", "\"\<sphdAmps_examples.m\>\""}], "}"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"orbits", " ", "=", " ", 
  RowBox[{"Keys", "[", "sphdData", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"amps", "[", 
    RowBox[{"key_", ",", " ", "m_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"sphdData", "[", "key", "]"}], "[", "\"\<modes\>\"", "]"}], "[", 
    "m", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chiOf", "[", "key_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"sphdData", "[", "key", "]"}], "[", "\"\<a\>\"", "]"}], " ", 
    RowBox[{
     RowBox[{"sphdData", "[", "key", "]"}], "[", "\"\<x\>\"", "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vOf", "[", "key_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"amps", "[", 
        RowBox[{"key", ",", " ", "2"}], "]"}], "[", "\"\<omega\>\"", "]"}], 
      "/", "2"}], "]"}], "^", 
    RowBox[{"(", 
     RowBox[{"1", "/", "3"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"muM", "[", 
    RowBox[{"m_", ",", " ", "g_", ",", " ", "lr_", ",", " ", "lc_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{"muM", "[", 
     RowBox[{"m", ",", " ", "g", ",", " ", "lr", ",", " ", "lc"}], "]"}], " ",
     "=", " ", 
    RowBox[{"muMatrix", "[", 
     RowBox[{
     "m", ",", " ", "g", ",", " ", "lr", ",", " ", "lc", ",", " ", "20"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"toSpherical", "[", 
    RowBox[{
    "m_", ",", " ", "g_", ",", " ", "Cup_List", ",", " ", "lRowMax_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{
    RowBox[{"muM", "[", 
     RowBox[{"m", ",", " ", "g", ",", " ", "lRowMax", ",", " ", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"2", ",", " ", 
         RowBox[{"Abs", "[", "m", "]"}]}], "]"}], " ", "+", " ", 
       RowBox[{"Length", "[", "Cup", "]"}], " ", "-", " ", "1"}]}], "]"}], 
    " ", ".", " ", "Cup"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cTrunc", "[", 
    RowBox[{"key_", ",", " ", "m_", ",", " ", "L_", ",", " ", "Lp_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"amps", "[", 
        RowBox[{"key", ",", " ", "m"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"toSpherical", "[", 
      RowBox[{"m", ",", " ", 
       RowBox[{"d", "[", "\"\<gamma\>\"", "]"}], ",", " ", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"d", "[", "\"\<Cup\>\"", "]"}], ",", " ", 
         RowBox[{"Lp", " ", "-", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"2", ",", " ", "m"}], "]"}], " ", "+", " ", "1"}]}], "]"}],
        ",", " ", "L"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"errTrunc", "[", 
    RowBox[{"key_", ",", " ", "m_", ",", " ", "L_", ",", " ", "Lp_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cTrunc", "[", 
       RowBox[{"key", ",", " ", "m", ",", " ", "L", ",", " ", "Lp"}], "]"}], 
      "/", 
      RowBox[{"cTrunc", "[", 
       RowBox[{"key", ",", " ", "m", ",", " ", "L", ",", " ", "14"}], "]"}]}],
      " ", "-", " ", "1"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"d19cfce5-8e71-44c9-9cd9-17fcf15cfd2d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 6", "Subsection",ExpressionUUID->"818d02a0-095e-4126-b146-aa8e9ef8dec9"],

Cell["\<\
Question: which spherical modes does the change of basis actually change, and \
by how much?\
\>", "Text",ExpressionUUID->"cda4564b-91f0-4bb2-b289-ba381f087731"],

Cell["\<\
(a) Orbit \"a0.9_r4\", m = 2. Compute the spherical C_l (rows up to 14, all \
stored columns) and plot |Cup_l'| and |C_l| against l on a log scale. Before \
looking, predict which l change most from the parity rule C_lm ~ v^l for l+m \
even, v^(l+1) for l+m odd (notes eq. 8). Then tabulate |C_l - Cup_l|/|C_l| \
for l = 2 ... 8.\
\>", "Item",ExpressionUUID->"89cc9ad9-bffd-41c8-93ed-fd13e04d1ce7"],

Cell["\<\
(b) One term at a time. To first order, C_32 \[TildeTilde] Cup_32 + \[Mu]_32 \
Cup_22 and C_22 \[TildeTilde] \[Mu]_22 Cup_22 + \[Mu]_23 Cup_32 (Honet A26). \
Read \[Mu]_32, \[Mu]_23 and \[Mu]_22 - 1 from muM[2, \[Gamma], 14, 14] and \
find which fraction of the shifts C_32 - Cup_32 and C_22 - Cup_22 each term \
explains. Is \[Mu]_32/\[Gamma] of order 1/l (notes eq. 6)?\
\>", "Item",ExpressionUUID->"5efb2847-2afd-4b5a-b65c-93c7ed0bca38"],

Cell["\<\
(c) Scaling. For all six orbits, plot the relative change of (3,2) against |\
\[Chi]| v and that of (2,2) against |\[Chi]| v^5. Do the points line up \
through the origin? Which orbit departs, and why?\
\>", "Item",ExpressionUUID->"505678e4-53a0-4cc9-809b-954716ab8cfd"],

Cell[CellGroupData[{

Cell["\<\
(d) Flux. At \"a0.9_isco\", m = 2, compare \[CapitalSigma]|C_l|^2 with \
\[CapitalSigma]|Cup_l'|^2, with rows up to 14 and up to 8. Does the flux grid \
have to be recomputed in the spherical basis?\
\>", "Item",ExpressionUUID->"a0f5c10c-8842-44d9-a2f5-e5b0a92610f8"],

Cell[BoxData[""], "Input",ExpressionUUID->"46a07882-977f-4c33-8e14-f6e9b58c4b39"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"6e4d2de7-0913-42d8-a2c4-28cb2556760c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"d6", " ", "=", " ", 
   RowBox[{"amps", "[", 
    RowBox[{"\"\<a0.9_r4\>\"", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"C6", " ", "=", " ", 
   RowBox[{"toSpherical", "[", 
    RowBox[{"2", ",", " ", 
     RowBox[{"d6", "[", "\"\<gamma\>\"", "]"}], ",", " ", 
     RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], ",", " ", "14"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"ListLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d6", "[", "\"\<lp\>\"", "]"}], ",", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "]"}]}], "}"}], "]"}], ",", 
     " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"2", ",", " ", "14"}], "]"}], ",", " ", 
        RowBox[{"Abs", "[", "C6", "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<spheroidal |Cup_l'|\>\"", ",", " ", "\"\<spherical |C_l|\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<l\>\"", ",", " ", "\"\<\>\""}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"C6", "[", 
              RowBox[{"[", 
               RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
             RowBox[{
              RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
           
           RowBox[{"C6", "[", 
            RowBox[{"[", 
             RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}]}], "]"}], ",", 
         " ", "3"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"l", ",", " ", "2", ",", " ", "8"}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<l\>\"", ",", " ", "\"\<|C - Cup|/|C|\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",ExpressionUUID->"6383a153-e7eb-45e5-8fea-\
c43e1a325bf3"],

Cell["\<\
(2,2) moves by 2e-3, every l \[GreaterEqual] 3 by 40-60%. (3,2) sits next to \
the dominant (2,2), which is v^-2 louder; each even-parity l \[GreaterEqual] \
4 sits next to the louder odd-parity mode just below it. An O(\[Gamma]) share \
of a louder neighbour is a large relative change (notes eq. 9).\
\>", "Text",ExpressionUUID->"694def47-e9e5-47e0-80d0-4bdae682969a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g6", " ", "=", " ", 
   RowBox[{"d6", "[", "\"\<gamma\>\"", "]"}]}], ";", " ", 
  RowBox[{"mu6", " ", "=", " ", 
   RowBox[{"muM", "[", 
    RowBox[{"2", ",", " ", "g6", ",", " ", "14", ",", " ", "14"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"mu6", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
      RowBox[{"mu6", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"mu6", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", "1"}], 
      ",", " ", 
      RowBox[{
       RowBox[{"mu6", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "/", "g6"}]}], "}"}], 
    ",", " ", "4"}], "]"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "fraction", " ", "of", " ", "each", " ", "shift", " ", "explained", " ", 
     "by", " ", "one", " ", 
     RowBox[{"term", ":", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"3", ",", "2"}], ")"}], " ", "by", " ", "mu_", "32", " ", 
       "Cup_", "22"}]}]}], ";", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", ",", "2"}], ")"}], " ", "by", " ", "mu_", "23", " ", 
     "Cup_", "32", " ", "and", " ", "by", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"mu_", "22"}], " ", "-", " ", "1"}], ")"}], " ", "Cup_", 
     "22"}]}], " ", "*)"}]}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"mu6", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"C6", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"mu6", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"C6", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"mu6", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", "1"}], 
       ")"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"C6", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{
          RowBox[{"d6", "[", "\"\<Cup\>\"", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}]}], "}"}], ",", " ", 
   "3"}], "]"}]}], "Input",ExpressionUUID->"77cb7d73-97a1-4cfb-bb1a-\
5658c3d9073c"],

Cell["\<\
\[Mu]_32 Cup_22 accounts for the whole shift of (3,2) (ratio \[TildeTilde] \
1). For (2,2) the O(\[Gamma]) term \[Mu]_23 Cup_32 explains only about 60%: \
it is suppressed by Cup_32/Cup_22 ~ v^2, so the O(\[Gamma]^2) normalisation \
term (\[Mu]_22 - 1) Cup_22 is comparable (about 40%). This is the structure \
of Honet (A26). \[Mu]_32/\[Gamma] \[TildeTilde] 0.19, of order 1/l.\
\>", "Text",ExpressionUUID->"a31c5632-7fc0-4064-bbed-e73370d151a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rel", "[", 
    RowBox[{"key_", ",", " ", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"amps", "[", 
        RowBox[{"key", ",", " ", "2"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"C", " ", "=", " ", 
         RowBox[{"toSpherical", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"d", "[", "\"\<gamma\>\"", "]"}], ",", " ", 
           RowBox[{"d", "[", "\"\<Cup\>\"", "]"}], ",", " ", "14"}], "]"}]}], 
        "}"}], ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"C", "[", 
            RowBox[{"[", 
             RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
           RowBox[{
            RowBox[{"d", "[", "\"\<Cup\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"C", "[", 
          RowBox[{"[", 
           RowBox[{"l", " ", "-", " ", "1"}], "]"}], "]"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tab6", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"chiOf", "[", "k", "]"}], "]"}], " ", 
          RowBox[{"vOf", "[", "k", "]"}]}], ",", " ", 
         RowBox[{"rel", "[", 
          RowBox[{"k", ",", " ", "3"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"rel", "[", 
           RowBox[{"k", ",", " ", "3"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"chiOf", "[", "k", "]"}], "]"}], " ", 
            RowBox[{"vOf", "[", "k", "]"}]}], ")"}]}], ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"chiOf", "[", "k", "]"}], "]"}], " ", 
          RowBox[{
           RowBox[{"vOf", "[", "k", "]"}], "^", "5"}]}], ",", " ", 
         RowBox[{"rel", "[", 
          RowBox[{"k", ",", " ", "2"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"rel", "[", 
           RowBox[{"k", ",", " ", "2"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"chiOf", "[", "k", "]"}], "]"}], " ", 
            RowBox[{
             RowBox[{"vOf", "[", "k", "]"}], "^", "5"}]}], ")"}]}]}], "}"}], 
       ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"{", 
