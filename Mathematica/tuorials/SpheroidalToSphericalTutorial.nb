Cell["\<\
At \[Gamma] \[TildeTilde] 3.4 the first off-diagonal entries are tens of \
percent. So near ISCO at high spin the spherical \[ScriptL] = lmax mode needs \
spheroidal \[ScriptL]' a few beyond lmax (Section 7).\
\>", "Text",ExpressionUUID->"065d0a62-cd48-4703-8413-66a890c860c3"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Use the same S as the Teukolsky amplitude", "Section",ExpressionUUID->"6c24bf0b-9f04-4268-96f8-c71fb4667af2"],

Cell["\<\
C^up_\[ScriptL]'m is defined relative to a specific S_\[ScriptL]'m: the one \
stored in the mode, which TeukolskyPointParticleMode computes with the Leaver \
method. If its sign or normalisation differed from the spectral one, the C_\
\[ScriptL]m would come out wrong without any error. So check it once.\
\>", "Text",ExpressionUUID->"ec07a088-0f5a-4eef-8e59-e4c44fc6bb2b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"orb", "=", 
   RowBox[{"KerrGeoOrbit", "[", 
    RowBox[{"0.9`30", ",", "4`30", ",", "0", ",", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"md", "=", 
   RowBox[{"TeukolskyPointParticleMode", "[", 
    RowBox[{"s", ",", "3", ",", "2", ",", "orb"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SL", "=", 
   RowBox[{
    RowBox[{"md", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<AngularFunction\>\"", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"SL", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Method\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"SL", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<\[Gamma]\>\"", "]"}], ",", 
   RowBox[{"0.9`30", 
    RowBox[{"md", "[", "\"\<\[Omega]\>\"", "]"}]}], ",", 
   RowBox[{"0.9`30", "*", 
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"4`30", "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}], "+", "0.9`30"}], ")"}]}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"2b588702-d728-4b4b-909a-2b433357ce4e"],

