Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "b", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lmin", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"lmax", "=", "6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"specMatrix", "[", 
     RowBox[{"m_", ",", "\[Gamma]_", ",", "lmaxB_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", 
           RowBox[{"(", 
            RowBox[{"l", "+", "1"}], ")"}]}], "-", 
          RowBox[{"s", 
           RowBox[{"(", 
            RowBox[{"s", "+", "1"}], ")"}]}]}], ")"}], 
        RowBox[{"KroneckerDelta", "[", 
         RowBox[{"l", ",", "lp"}], " ", "]"}]}], "-", 
       RowBox[{
        SuperscriptBox["\[Gamma]", "2"], 
        RowBox[{"c2", "[", 
         RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}], "+", 
       RowBox[{"2", "\[Gamma]", " ", "s", " ", 
        RowBox[{"c1", "[", 
         RowBox[{"m", ",", "l", ",", "lp"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "lmin", ",", "lmaxB"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"lp", ",", "lmin", ",", "lmaxB"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"vals", ",", "vecs"}], "}"}], "=", 
     RowBox[{"Eigensystem", "[", 
      RowBox[{"specMatrix", "[", 
       RowBox[{"m", ",", "gamma", ",", 
        RowBox[{"lmax", "+", "6"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ord", "=", 
     RowBox[{"Ordering", "[", "vals", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vals", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vals", "[", 
         RowBox[{"[", "ord", "]"}], "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"lmax", "-", "lmin", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vecs", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"vecs", "[", 
         RowBox[{"[", "ord", "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"lmax", "-", "lmin", "+", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", 
         RowBox[{"lmax", "-", "lmin", "+", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"out", "=", 
     RowBox[{"vals", "+", 
      SuperscriptBox["gamma", "2"], "-", 
      RowBox[{"2", " ", "m", " ", "gamma"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tabulated", "=", 
     RowBox[{"Table", "[", 
