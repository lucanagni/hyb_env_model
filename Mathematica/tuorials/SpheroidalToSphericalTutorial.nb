Cell["Solution", "Subsubsection",ExpressionUUID->"f27606d2-a7d2-4986-a25b-929ece29ed98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"muBF", "[", 
   RowBox[{"l_", ",", "lp_", ",", "m_", ",", "\[Gamma]_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Sf", "=", 
      RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
       RowBox[{"s", ",", "lp", ",", "m", ",", "\[Gamma]"}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"ip", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Y", "[", 
        RowBox[{"l", ",", "m", ",", "#"}], "]"}], "&"}], ",", 
      RowBox[{
       RowBox[{"Sf", "[", 
        RowBox[{"#", ",", "0"}], "]"}], "&"}]}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[460]:=",ExpressionUUID->"ec85a496-7911-4ef0-8400-b181e0042be6"],

