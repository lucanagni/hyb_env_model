Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "a", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"muCol", "[", 
     RowBox[{"lp_", ",", "m_", ",", "\[Gamma]_", ",", "lmaxRow_", ",", "n_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"coeffs", ",", "lmin", ",", "l0"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"lmin", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"l0", "=", 
         RowBox[{"lp", "-", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"lp", "-", "lmin"}], ",", "n"}], "]"}]}]}], ";"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"If", " ", "you", " ", "call", " ", 
           RowBox[{"e", ".", "g", ".", " ", "S_"}], 
           RowBox[{"{", "73", "}"}], " ", "with", " ", "n"}], "=", 
          RowBox[{
           RowBox[{"2", " ", "then", " ", "lmin"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"3", " ", "and", " ", "lp"}], "-", "lmin"}], "=", 
            "4"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"but", " ", "n"}], "=", 
          RowBox[{
           RowBox[{
           "2", " ", "so", " ", "the", " ", "33", " ", "coeff", " ", "is", 
            " ", "never", " ", "actually", " ", 
            RowBox[{"computed", ".", " ", "In"}], " ", "this", " ", "case", 
            " ", "store", " ", 
            RowBox[{"zero", ".", " ", "Of"}], " ", "course", " ", "if", " ", 
            "n", " ", "is", " ", "large", " ", "enough", " ", "the", " ", 
            "Min", " ", "is", " ", "always", " ", "lp"}], "-", "lmin"}]}]}], 
        "*)"}], ";", "\[IndentingNewLine]", 
       RowBox[{"coeffs", "=", 
        RowBox[{"0", "\[IndentingNewLine]", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"i", "<", "l0"}], "||", 
              RowBox[{"i", ">", 
               RowBox[{"l0", "+", 
                RowBox[{"Length", "[", "coeffs", "]"}], "-", "1"}]}]}], ",", 
             "0", ",", 
             RowBox[{"coeffs", "[", 
              RowBox[{"[", 
               RowBox[{"i", "-", "l0", "+", "1"}], "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"Abs", "[", "m", "]"}]}], "]"}], ",", "lmaxRow"}], 
              "]"}]}], "}"}]}], "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}]}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muMatrix", "[", 
     RowBox[{
     "m_", ",", "\[Gamma]_", ",", "lmaxRow_", ",", "lmaxCol_", ",", "n_"}], 
