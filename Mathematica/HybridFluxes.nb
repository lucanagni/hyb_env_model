Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FluxHorSF", "[", 
     RowBox[{"x_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"FluxHor", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "3"}], "/", "2"}], ")"}]}], " ", "-", " ", 
          "\[Chi]"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"2", "/", "3"}], ")"}]}], ",", " ", "\[Chi]"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "*", "16", " ", 
         SuperscriptBox["x", 
          RowBox[{"15", "/", "2"}]]}], "5"], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"\[Chi]", ",", "0"}], "]"}], "*", 
          SuperscriptBox["x", 
           RowBox[{"3", "/", "2"}]]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"\[Chi]", ",", "0"}], "]"}]}], ")"}], 
          RowBox[{"OmgH", "[", 
           RowBox[{"\[Chi]", ",", "1", ",", "0"}], "]"}]}]}], ")"}]}], 
      ")"}]}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FullHorFluxPNSFvars", "[", 
      RowBox[{"x_", ",", "\[Nu]_", ",", "M_", ",", "\[Chi]_"}], "]"}], "=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
