        RowBox[{"x", ",", "\[Nu]", ",", "M", ",", "\[Chi]"}], "]"}], "/", 
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"kappa", "[", "\[Chi]", "]"}]}], ")"}], "*", 
          SuperscriptBox[
           RowBox[{"m1", "[", 
            RowBox[{"M", ",", "\[Nu]"}], "]"}], "2"], "*", "16", " ", 
          SuperscriptBox["\[Nu]", 
           RowBox[{"2", " "}]], 
          SuperscriptBox["x", 
           RowBox[{"15", "/", "2"}]], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"KroneckerDelta", "[", 
              RowBox[{"\[Chi]", ",", "0"}], "]"}], "*", 
             SuperscriptBox["x", 
              RowBox[{"3", "/", "2"}]]}], "+", 
