    RowBox[{
     RowBox[{"1.259", "e"}], "-", "8"}], ",", 
    RowBox[{"horizon", " ", "flux"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fInf", "[", 
    RowBox[{"rC", ",", "chi"}], "]"}], ";", 
   RowBox[{"fHor", "[", 
    RowBox[{"rC", ",", "chi"}], "]"}]}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"compactified", " ", 
     RowBox[{"r0", "^", "5"}], " ", "FI"}], ",", 
    RowBox[{
     RowBox[{"r0", "^", 
      RowBox[{"(", 
       RowBox[{"15", "/", "2"}], ")"}]}], " ", "FH", " ", 
     RowBox[{"(", 
      RowBox[{"A13", "/", "A14"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"rISCO", "[", "chi", "]"}], "   ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"chi", ">", 
     RowBox[{"0", " ", "prograde"}]}], ",", 
    RowBox[{"chi", "<", 
     RowBox[{"0", " ", "retrograde"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "FluxInf", " ", "and", " ", "FluxHor", " ", "take", " ", "the", " ", 
       "orbital", " ", "radius", " ", "r0", " ", "and", " ", "the", " ", 
       "signed", " ", "spin", " ", 
       RowBox[{"\[Chi]", ".", "They"}], " ", "are", " ", "valid", " ", "for", 
       " ", "r0"}], "\[GreaterEqual]", 
      RowBox[{"ISCO", " ", "and"}]}], "|", "\[Chi]", "|", " ", 
     RowBox[{"\[LessEqual]", 
      RowBox[{
       RowBox[{
        RowBox[{"0.998", ".", " ", "rISCO"}], " ", "uses", " ", "the", " ", 
