    RowBox[{
     RowBox[{"6.15035", "e"}], "-", "5"}], ",", 
    RowBox[{"flux", " ", "to", " ", "infinity"}], ",", 
    RowBox[{"m1", "=", "1"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"FluxHor", "[", 
