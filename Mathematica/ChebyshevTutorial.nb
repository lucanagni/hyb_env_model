Cell["\<\
For numerics we never expand them in powers of x. We evaluate all of T_0 \
\[Ellipsis] T_{n-1} at once from the cosine definition. This is the function \
used in the package:\
\>", "Text",ExpressionUUID->"c932d756-d005-4e2a-be31-a278cc78585a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chebT", "[", 
    RowBox[{"n_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "]"}], " ", 
     RowBox[{"ArcCos", "[", "x", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"chebT", "[", 
  RowBox[{"6", ",", " ", "0.3"}], "]"}], "\n", 
 RowBox[{"ChebyshevT", "[", 
  RowBox[{
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "5"}], "]"}], ",", " ", "0.3"}], "]"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"bed53536-e707-4dd2-9021-c686acc7fbe0"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", "0.29999999999999993`", ",", 
   RowBox[{"-", "0.8200000000000001`"}], ",", 
   RowBox[{"-", "0.7919999999999997`"}], ",", "0.34480000000000033`", ",", 
   "0.99888`"}], "}"}]], "Output",
 CellChangeTimes->{4.0023458980061502`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"f5be0300-b0a4-4747-9b79-1e54d7bed1b2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.`", ",", "0.3`", ",", 
   RowBox[{"-", "0.8200000000000001`"}], ",", 
   RowBox[{"-", "0.792`"}], ",", "0.3448000000000002`", ",", 
   "0.9988800000000002`"}], "}"}]], "Output",
 CellChangeTimes->{4.002345898040185*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"9c05d4e8-fc23-4923-9211-1616cd5c4456"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 1", "Subsection",ExpressionUUID->"e44a7cd0-2d8c-4fc3-b8cb-01076241e3fa"],

Cell["\<\
(a) Check the recurrence symbolically for k = 1, \[Ellipsis], 8 using \
ChebyshevT. (b) Check that chebT[n, x] agrees with ChebyshevT for a few \
random x in [-1,1]. (c) What does chebT return for x = 1.5, and why? (Hint: \
ArcCos of a number > 1.)\
\>", "Text",ExpressionUUID->"6af5c2ce-d794-4668-b75a-d409e473898e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"RecurrCheck", "[", "k_", "]"}], ":=", 
  RowBox[{
   RowBox[{"ChebyshevT", "[", 
    RowBox[{
     RowBox[{"k", "+", "1"}], ",", "x"}], "]"}], "-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "x", " ", 
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"k", ",", "x"}], "]"}]}], "-", 
     RowBox[{"ChebyshevT", "[", 
      RowBox[{
       RowBox[{"k", "-", "1"}], ",", "x"}], "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Polys", "=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RecurrCheck", "[", "k", "]"}], "//", "Simplify"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "1", ",", " ", "8"}], "}"}]}], "]"}], "//", 
   "TableForm"}]}]}], "Input",
 CellChangeTimes->{{4.0023472336026077`*^9, 4.002347243934861*^9}, {
