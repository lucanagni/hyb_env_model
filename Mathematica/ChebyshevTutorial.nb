Cell[CellGroupData[{

Cell["2. Chebyshev polynomials", "Section",ExpressionUUID->"d7d3d97e-620d-44af-b1fd-c28a20f70aa9"],

Cell["\<\
For x in [-1,1] write x = cos \[Theta]. The Chebyshev polynomial of degree k \
is defined by\
\>", "Text",ExpressionUUID->"dd394b7f-0346-4963-8a6c-8e8c43adc43a"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "k"], "(", 
     RowBox[{"cos", "(", "\[Theta]", ")"}], ")"}], "\[LongEqual]", 
    RowBox[{"cos", "(", 
     RowBox[{"k", " ", "\[Theta]"}], ")"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"b52d3659-\
07bd-43a1-90f5-1deaba052ff9"],

Cell["\<\
i.e. T_k(x) = cos(k arccos x). Using cos((k+1)\[Theta]) + cos((k-1)\[Theta]) \
= 2 cos \[Theta] cos k\[Theta] gives the three-term recurrence, which shows \
that T_k really is a polynomial:\
\>", "Text",ExpressionUUID->"967e4a4a-4120-4b37-b0a8-b911ea320d18"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "0"], "(", "x", ")"}], "\[LongEqual]", "1"}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"23d81dcb-\
e991-49c4-806f-b133365f4139"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", "1"], "(", "x", ")"}], "\[LongEqual]", "x"}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"6cbef794-\
dc95-4750-936e-2a5e9f29963a"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     SubscriptBox["T", 
      RowBox[{"k", "+", "1"}]], "(", "x", ")"}], "\[LongEqual]", 
    RowBox[{
     RowBox[{"2", " ", "x", " ", 
      RowBox[{
       SubscriptBox["T", "k"], "(", "x", ")"}]}], "-", 
     RowBox[{
      SubscriptBox["T", 
       RowBox[{"k", "-", "1"}]], "(", "x", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"afcdbcaf-\
1651-4a1a-8f33-41c6eb40af43"],

Cell["Key properties:", "Text",ExpressionUUID->"1807fbb6-5bb0-47a2-a17e-88c337372204"],

Cell["\<\
|T_k(x)| \[LessEqual] 1 on [-1,1], and T_k oscillates between \[PlusMinus]1 \
exactly k+1 times. So a coefficient c_k multiplying T_k contributes at most \
|c_k| anywhere in the interval. This is why the size of the coefficients \
directly measures the size of each term.\
\>", "Item",ExpressionUUID->"a96129f5-abed-47b5-aefa-ec1da0896263"],

Cell["T_k has k roots in [-1,1], all real.", "Item",ExpressionUUID->"3ebdd5f6-4ac1-46d7-ab8f-c98436fe4335"],

Cell["\<\
They are orthogonal with weight 1/\[Sqrt](1-x\.b2). We will need the discrete \
version (Section 3).\
\>", "Item",ExpressionUUID->"3626ed21-58c1-4a69-85f9-626a09b2ac67"],

Cell["Mathematica has them built in as ChebyshevT:", "Text",ExpressionUUID->"617fba85-bbc4-45b0-bf40-1db5981c810e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"ChebyshevT", "[", 
     RowBox[{"k", ",", " ", "x"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], " ", "//", 
  " ", "TableForm"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"f6553d4c-9175-4dc9-bdcb-75b1c0c67d66"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {"1"},
     {"x"},
     {
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["x", "2"]}]}]},
     {
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", "x"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["x", "3"]}]}]},
     {
      RowBox[{"1", "-", 
       RowBox[{"8", " ", 
        SuperscriptBox["x", "2"]}], "+", 
       RowBox[{"8", " ", 
        SuperscriptBox["x", "4"]}]}]},
     {
      RowBox[{
       RowBox[{"5", " ", "x"}], "-", 
       RowBox[{"20", " ", 
        SuperscriptBox["x", "3"]}], "+", 
       RowBox[{"16", " ", 
        SuperscriptBox["x", "5"]}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.5599999999999999]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   Column],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.0023458778061247`*^9},
 CellLabel->
  "Out[10]//TableForm=",ExpressionUUID->"8f71c78d-97c7-45e2-8b63-\
2938322c6d7e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"k", ",", " ", "x"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\"\<T\>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "k", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"75b39cfc-41b0-4600-9a27-8461638c8fcf"],

