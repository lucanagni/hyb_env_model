Cell[CellGroupData[{

Cell["Exercise 6: a real off-grid accuracy test", "Subsection",ExpressionUUID->"0d14ebdb-634b-40eb-80b6-f4ef8b950479"],

Cell["\<\
Chebyshev\[Dash]Gauss grids are nested under odd refinement: the nodes of T_6 \
are a subset of those of T_18 (take i = 3i' + 1), and those of T_9 are a \
subset of those of T_27 (j = 3j' + 1). (a) Prove this from the node formula. \
(b) Build the interpolant from the 6 \[Times] 9 subgrid only, evaluate it at \
all 18 \[Times] 27 nodes, and compare with the true values. Most of those \
nodes are \"off-grid\" for the coarse interpolant, so this is a genuine \
accuracy test. (c) Compare the error with the size of the last coefficients \
of the coarse interpolant. (d) Where in the (rC, \[Chi]) square is the error \
largest?\
\>", "Text",ExpressionUUID->"31ca6d95-b853-445b-8f9b-06f9f92a8118"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"43f8f14d-94d1-46e1-92a3-4b74ef096633"],

Cell["\<\
(a) cos((2(3i'+1)+1)\[Pi]/(2\[CenterDot]18)) = cos(3(2i'+1)\[Pi]/36) = \
cos((2i'+1)\[Pi]/12) = node[i', 6]; the same with 27 and 9.\
\>", "Text",ExpressionUUID->"dc6221fd-aeb3-4f58-a997-d1eb97f8c5e8"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"N", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"node", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", " ", "i"}], " ", "+", " ", "1"}], ",", " ", "18"}], 
        "]"}], " ", "-", " ", 
       RowBox[{"node", "[", 
        RowBox[{"i", ",", " ", "6"}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
   "]"}]}]], "Input",ExpressionUUID->"259bd52a-8836-4f92-bc03-b66a82df5526"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sub", " ", "=", " ", 
    RowBox[{"Finf", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "5"}], "]"}]}], " ", "+", " ", "2"}], ",", 
       " ", 
       RowBox[{
        RowBox[{"3", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", "8"}], "]"}]}], " ", "+", " ", "2"}]}], 
      "]"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"+", "1"}], " ", "for", " ", "1"}], "-", 
    RowBox[{"based", " ", "lists"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Ccoarse", " ", "=", " ", 
   RowBox[{"chebCoeffs2D", "[", "sub", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"errGrid", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"chebEval2D", "[", 
        RowBox[{"Ccoarse", ",", " ", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j", ",", " ", "1"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j", ",", " ", "2"}], "]"}], "]"}]}], "]"}],
        "/", 
       RowBox[{"Finf", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], " ", "-", " ", "1"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "nR"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "nA"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", "errGrid", "]"}]}]}], "Input",ExpressionUUID->"b4f4e5e7-\
a64d-4295-9daa-72fc90650f66"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"Ccoarse", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}]}], ",", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"Ccoarse", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}]}]}], "}"}]], "Input",ExpressionUU\
ID->"3b70333a-0cf9-4c2e-88df-eb38cc437a7f"],

Cell[BoxData[
 RowBox[{"MatrixPlot", "[", 
  RowBox[{
   RowBox[{"Log10", "@", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{"Abs", "[", "#", "]"}], ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], "]"}], " ", "&"}], ",", " ", "errGrid", ",",
       " ", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<row i (rC; ISCO at top)\>\"", ",", " ", 
      "\"\<column j (\[Chi]; +0.998 at left)\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", 
    "\"\<Log10 rel. error, 6x9 interpolant (nodes used: 1e-8 floor)\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"bacdce85-a981-4f34-869f-05d21806db3b"],

Cell["\<\
The relative error is large (tens of percent), much larger than the last \
coefficients (~1e-2) suggest. Find where:\
\>", "Text",ExpressionUUID->"a974e72d-22be-4d96-938f-dac8796da591"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Position", "[", 
    RowBox[{
     RowBox[{"Abs", "@", "errGrid"}], ",", " ", 
     RowBox[{"Max", "@", 
      RowBox[{"Abs", "@", "errGrid"}]}]}], "]"}], ",", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"errGrid", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"2", " ", ";;"}]}], "]"}], "]"}]}]}], ",", " ", 
   RowBox[{"Finf", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"1", " ", ";;", " ", "4"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"N", "@", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", " ", ";;", " ", "4"}], ",", " ", "2"}], "]"}], "]"}]}]}], 
  "}"}]], "Input",ExpressionUUID->"885a522f-d162-4a57-a1bf-dc6ba11d48aa"],

Cell["\<\
Almost all of it sits in the first column, \[Chi] = 0.998. That column is \
outside the outermost coarse node (\[Chi] = cos(\[Pi]/18) \[TildeTilde] \
0.985), and between the two f\[Infinity] changes by a factor of 3. The reason \
is physical: the ISCO radius contains (1 - \[Chi])^(1/3), which is not \
analytic at \[Chi] = 1. There is a branch point just beyond the edge of the \
interval, and (Section 5) singularities close to the interval spoil \
convergence. The coarse grid never sees the steep region, so its coefficients \
cannot warn you about it.\
\>", "Text",ExpressionUUID->"c0dee97f-a514-46cd-aac6-515def581010"],

Cell["\<\
Two lessons. (1) The coefficient tail is a good error estimate only once the \
grid resolves the function; nested subgrid tests like this one are the safer \
check. (2) This is exactly why Honet+ replace \[Chi] by a logarithmic \
variable in log(1 - \[Chi]) (eq. A12): it stretches the region near \[Chi] = \
1 so the function becomes smooth in the new variable. The full 18 \[Times] 27 \
interpolant is far better than this 6 \[Times] 9 one, but its accuracy near \
\[Chi] = 0.998 is the least certain part of the grid.\
\>", "Text",ExpressionUUID->"1877a163-117f-4e52-8d64-56709efbc9ac"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 7", "Subsection",ExpressionUUID->"9213869f-3c51-4864-af76-134b284eb3b3"],

Cell[TextData[{
 "Write fHorMine's physical counterpart FluxHorMine[r0, \[Chi]] = \
f_H/r0^(15/2), check it against FluxInterpolation",
 StyleBox["FluxHor, and plot it versus r0 for \[Chi] = 0.9 and \[Chi] = -0.9. \
Why does it change sign for \[Chi] = 0.9? (Hint: superradiance, \
\[CapitalOmega] < \[CapitalOmega]_H.)",
  FontFamily->"Source Code Pro",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"18675d01-67cb-45f5-8a1c-bb53f5469b45"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"8f42d529-c567-46a1-8164-c12b65b4b7d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FluxHorMine", "[", 
    RowBox[{
     RowBox[{"r0_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"chi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"fHorMine", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"rISCOmine", "[", "chi", "]"}], "/", "r0"}]}], " ", "-", " ",
        "1"}], ",", " ", "chi"}], "]"}], "/", 
    RowBox[{"r0", "^", 
     RowBox[{"(", 
      RowBox[{"15", "/", "2"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FluxHorMine", "[", 
   RowBox[{"10.", ",", " ", "0.9"}], "]"}], " ", "-", " ", 
  RowBox[{"FluxInterpolation`FluxHor", "[", 
   RowBox[{"10.", ",", " ", "0.9"}], "]"}]}]}], "Input",ExpressionUUID->\
"68176781-8611-4924-8544-80d61c3df26e"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FluxHorMine", "[", 
      RowBox[{"r0", ",", " ", "0.9"}], "]"}], ",", " ", 
     RowBox[{"FluxHorMine", "[", 
      RowBox[{"r0", ",", " ", 
       RowBox[{"-", "0.9"}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"r0", ",", " ", "2", ",", " ", "20"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Chi] = 0.9\>\"", ",", " ", "\"\<\[Chi] = -0.9\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<r0\>\"", ",", " ", "\"\<F_H\>\""}], "}"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"995d90fc-8375-4ac9-9781-c42ab57f53b2"],

Cell["\<\
For prograde orbits the orbital frequency is below the horizon frequency (m\
\[CapitalOmega] < m\[CapitalOmega]_H), and the horizon flux is negative: \
superradiance extracts energy from the black hole and feeds it into the orbit.\
\>", "Text",ExpressionUUID->"c8a37662-25eb-4a2a-83b9-2971e0849449"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary", "Section",ExpressionUUID->"6d410d47-4387-4272-ab29-81af5f8738c7"],

Cell["\<\
Nodes: x_i = cos((2i+1)\[Pi]/(2n)), the roots of T_n (node in \
FluxGrid_nonspinning.nb).\
\>", "Item",ExpressionUUID->"426678dc-2001-4cbf-84a2-7889f431cb3a"],

Cell["\<\
Coefficients: a discrete cosine transform of the data, c = M\[CenterDot]f in \
1D and C = M_R\[CenterDot]F\[CenterDot]M_A\:1d40 in 2D (chebCoeffs in the \
package).\
\>", "Item",ExpressionUUID->"dc713a1e-8586-4303-a0de-48da0b335773"],

Cell["\<\
Evaluation: p(x,y) = T(x)\[CenterDot]C\[CenterDot]T(y) with T_k(x) = cos(k \
arccos x) (chebT and chebEval in the package).\
\>", "Item",ExpressionUUID->"3e7792a4-1823-4b6e-a3fa-421b1159518c"],

Cell["\<\
Accuracy: read it from the decay of the last coefficients, or test it with a \
nested subgrid.\
\>", "Item",ExpressionUUID->"a430cdd4-25f6-492f-8ae0-318ab3b93e2d"],

Cell["\<\
Physics: compactify r0 to rC = 2r_*/r0 - 1, and interpolate r0^5 \
F_\[Infinity] and r0^(15/2) F_H, which are smooth and of order one, instead \
of the raw fluxes.\
\>", "Item",ExpressionUUID->"1b14288f-9b0a-47c6-8fc0-470eb566dff7"]
}, Open  ]]
}, Open  ]]
},
