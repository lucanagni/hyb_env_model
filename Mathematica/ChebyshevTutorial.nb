Cell["Solution", "Subsubsection",ExpressionUUID->"11d9034b-915d-4353-bdf8-81ec604871f2"],

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{"ChebyshevT", "[", 
      RowBox[{
       RowBox[{"k", " ", "+", " ", "1"}], ",", " ", "x"}], "]"}], " ", "-", 
     " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "x", " ", 
        RowBox[{"ChebyshevT", "[", 
         RowBox[{"k", ",", " ", "x"}], "]"}]}], " ", "-", " ", 
       RowBox[{"ChebyshevT", "[", 
        RowBox[{
         RowBox[{"k", " ", "-", " ", "1"}], ",", " ", "x"}], "]"}]}], ")"}]}],
     "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "1", ",", " ", "8"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"a22845a6-a592-44c7-905c-2317df98014d"],

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", " ", "=", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], "]"}]}], "}"}], ",", 
      " ", 
      RowBox[{"Max", "@", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"chebT", "[", 
          RowBox[{"10", ",", " ", "x"}], "]"}], " ", "-", " ", 
         RowBox[{"ChebyshevT", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "9"}], "]"}], ",", " ", "x"}], "]"}]}], 
        "]"}]}]}], "]"}], ",", " ", 
    RowBox[{"{", "20", "}"}]}], "]"}]}]], "Input",ExpressionUUID->"d5e6a673-\
c21e-4731-95eb-322878fec0b1"],

Cell[BoxData[
 RowBox[{"chebT", "[", 
  RowBox[{"4", ",", " ", "1.5"}], "]"}]], "Input",ExpressionUUID->"ab40ab60-\
fb60-463b-926c-92fd55de8a4a"],

Cell["\<\
ArcCos[1.5] is complex, so chebT returns complex numbers with tiny imaginary \
parts; the real parts are still T_k(1.5) (= cosh(k arccosh 1.5)), but the \
cosine formula is only meant for |x| \[LessEqual] 1. Chebyshev interpolants \
are defined on [-1,1]; outside it they grow like the T_k themselves \
(exponentially in k), so extrapolation is meaningless. The package therefore \
refuses to evaluate outside the square.\
\>", "Text",ExpressionUUID->"3dc9376d-d832-4e46-ba9d-3cf1a40d84da"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Chebyshev\[Dash]Gauss nodes and discrete orthogonality", "Section",ExpressionUUID->"081b279a-9ae6-4eeb-a422-b9ad7514467a"],

Cell["\<\
The interpolation points are the n roots of T_n: cos(n\[Theta]) = 0 gives \
\[Theta]_i = (2i+1)\[Pi]/(2n), so\
\>", "Text",ExpressionUUID->"d5fe7ef3-d930-4043-8277-cfdf2e9d8abc"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["x", "i"], "\[LongEqual]", 
    RowBox[{"cos", "(", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "i"}], "+", "1"}], ")"}], " ", "\[Pi]"}], 
      RowBox[{"2", " ", "n"}]], ")"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"3e1c67d6-\
36b5-4add-a991-6baf192405b1"],

Cell["\<\
with i = 0, \[Ellipsis], n-1. These are the Chebyshev\[Dash]Gauss (or \"first \
kind\") nodes. This is exactly the function node[i, n] in \
FluxGrid_nonspinning.nb:\
\>", "Text",ExpressionUUID->"a25f9859-f9b0-4e44-ab9e-0832f22d18a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"node", "[", 
    RowBox[{"i_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", "i"}], " ", "+", " ", "1"}], ")"}], " ", 
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "n"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"node", "[", 
     RowBox[{"i", ",", " ", "6"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], " ", "//", 
  " ", "N"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"8bc57709-7bcf-4e74-9c2b-a0ac1e91c755"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0.9659258262890682`", ",", "0.7071067811865475`", ",", 
   "0.2588190451025207`", ",", 
   RowBox[{"-", "0.2588190451025207`"}], ",", 
   RowBox[{"-", "0.7071067811865475`"}], ",", 
   RowBox[{"-", "0.9659258262890682`"}]}], "}"}]], "Output",
 CellChangeTimes->{4.002347023864913*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"e807660d-101d-4b4a-95a0-5f5b823afa74"]
}, Open  ]],

Cell["\<\
Note the ordering: i = 0 is the point closest to +1 and i = n-1 the point \
closest to -1. In the flux grid, row i = 0 is rC \[TildeTilde] +1 (the ISCO) \
and column j = 0 is \[Chi] \[TildeTilde] +1 (prograde).\
\>", "Text",ExpressionUUID->"5f8297d0-9a7c-446a-bd21-97328df2495e"],

Cell["\<\
The property that makes everything work is discrete orthogonality. For 0 \
\[LessEqual] k, l \[LessEqual] n-1:\
\>", "Text",ExpressionUUID->"a60840a3-6065-497a-8b0b-0bf7a9623de6"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"i", "=", "0"}], 
      RowBox[{"n", "-", "1"}]], 
     RowBox[{
      RowBox[{
       SubscriptBox["T", "k"], "(", 
       SubscriptBox["x", "i"], ")"}], " ", 
      RowBox[{
       SubscriptBox["T", "l"], "(", 
       SubscriptBox["x", "i"], ")"}]}]}], "\[LongEqual]", 
    RowBox[{"(", 
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {"0", 
            RowBox[{"k", "\[NotEqual]", "l"}]},
           {"n", 
            RowBox[{"k", "\[LongEqual]", "l", "\[LongEqual]", "0"}]},
           {
            FractionBox["n", "2"], 
            RowBox[{"k", "\[LongEqual]", "l", "\[NotEqual]", "0"}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
          GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.84]}, 
              Offset[0.27999999999999997`]}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}},
          Selectable->True]}
       },
       GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
       GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.35]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      "Piecewise",
      DeleteWithContents->True,
      Editable->False,
      SelectWithContents->True,
      Selectable->False,
      StripWrapperBoxes->True], ")"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"37391505-\
2e0a-4ff3-8d13-938421bcb557"],

Cell["\<\
It follows from T_k(x_i) = cos(k\[Theta]_i) and the sum of cosines of equally \
spaced angles. Numerically:\
\>", "Text",ExpressionUUID->"82094a4f-9b06-4138-b1df-4d71c64aeb4f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", " ", "=", " ", "6"}], "}"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ChebyshevT", "[", 
            RowBox[{"k", ",", " ", 
             RowBox[{"node", "[", 
              RowBox[{"i", ",", " ", "n"}], "]"}]}], "]"}], " ", 
           RowBox[{"ChebyshevT", "[", 
            RowBox[{"l", ",", " ", 
             RowBox[{"node", "[", 
              RowBox[{"i", ",", " ", "n"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", 
            RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "0", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"l", ",", " ", "0", ",", " ", 
          RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ",
       "N"}], " ", "//", " ", "Chop"}], " ", "//", " ", "MatrixForm"}]}], 
  "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"89807b27-0d86-465c-b865-091873b48755"],

