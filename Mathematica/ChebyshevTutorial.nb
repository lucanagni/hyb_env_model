Cell[CellGroupData[{

Cell["4. 1D interpolation: computing the coefficients", "Section",ExpressionUUID->"56425cf7-98a6-4b75-80e4-ce87c121b454"],

Cell["\<\
We look for the polynomial of degree n-1 written in the Chebyshev basis\
\>", "Text",ExpressionUUID->"7c7a3ebc-3dba-4e6e-975e-3f60a2ec49dc"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"p", "(", "x", ")"}], "\[LongEqual]", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{"n", "-", "1"}]], 
     RowBox[{
      SubscriptBox["c", "k"], " ", 
      RowBox[{
       SubscriptBox["T", "k"], "(", "x", ")"}]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"d3453f39-\
3698-453b-8f5a-ed93e2a1118e"],

Cell["\<\
with p(x_i) = f_i at the n nodes. Multiply p(x_i) = f_i by T_l(x_i), sum over \
i, and use discrete orthogonality: every term with k \[NotEqual] l drops out \
and\
\>", "Text",ExpressionUUID->"f6f408c8-c8f1-4a3c-9ca9-a39a7a304500"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["c", "k"], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"(", 
       RowBox[{"2", "-", 
        TemplateBox[{
          RowBox[{"k", ",", "0"}]},
         "KroneckerDeltaSeq"]}], ")"}], "n"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"i", "=", "0"}], 
       RowBox[{"n", "-", "1"}]], 
      RowBox[{
       SubscriptBox["f", "i"], " ", 
       RowBox[{"cos", "(", 
        FractionBox[
         RowBox[{"k", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "i"}], "+", "1"}], ")"}], " ", "\[Pi]"}], 
         RowBox[{"2", " ", "n"}]], ")"}]}]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",
 CellChangeTimes->{{4.002357293282373*^9, 
  4.002357306308679*^9}},ExpressionUUID->"a3a581b6-8996-497f-9573-\
ebe85f07c60d"],

Cell["\<\
(The condition /; -1 <= x <= 1 makes chebEval1D return unevaluated outside \
the interval, see Exercise 1c.)\
\>", "Text",ExpressionUUID->"b9a57ea4-8771-411d-bc2b-33d8f218d919"],

Cell["\<\
No linear system to solve: each coefficient is a weighted sum of the data. \
The (2-\[Delta]_{k0}) accounts for the n versus n/2 normalisation. This sum \
is a discrete cosine transform (type II), so it can be computed with FFT \
speed if needed.\
\>", "Text",ExpressionUUID->"505479cf-cdd4-4cc7-bda6-675a87689101"],

Cell["\<\
Since the polynomial of degree n-1 through n points is unique, this is the \
same polynomial InterpolatingPolynomial would give. We just write it in a \
better basis: the Chebyshev coefficients are well conditioned and tell us how \
accurate the result is.\
\>", "Text",ExpressionUUID->"10f8ee80-9458-46e3-9e1f-1350db0f82f9"],

Cell["\<\
In matrix form c = M \[CenterDot] f, with M_{ki} = (2-\[Delta]_{k0})/n \
cos(k(2i+1)\[Pi]/(2n)):\
\>", "Text",ExpressionUUID->"b16fe372-524b-4dd2-a531-eb90b0ffec76"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chebMatrix", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"2", " ", "-", " ", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"k", ",", " ", "0"}], "]"}]}], ")"}], "n"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"k", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "i"}], " ", "+", " ", "1"}], ")"}], " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "n"}], ")"}]}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chebCoeffs1D", "[", "f_List", "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"chebMatrix", "[", 
       RowBox[{"Length", "[", "f", "]"}], "]"}], "]"}], " ", ".", " ", 
     "f"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"dot", " ", "operator"}], " ", "->", " ", 
     RowBox[{"a", ".", "b"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Dot", "[", 
       RowBox[{"a", ",", "b"}], "]"}], ".", " ", "f"}], " ", "the", " ", 
     "list", " ", "of", " ", "f_i"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chebEval1D", "[", 
     RowBox[{"c_List", ",", " ", 
      RowBox[{"x_", "?", "NumericQ"}]}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{"-", "1"}], " ", "<=", " ", "x", " ", "<=", " ", "1"}]}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"chebT", "[", 
     RowBox[{
      RowBox[{"Length", "[", "c", "]"}], ",", " ", "x"}], "]"}], " ", ".", 
    " ", "c"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0023595232698383`*^9, 4.0023595322118464`*^9}, {
  4.002359899464272*^9, 4.002359940324795*^9}, {4.002360577862034*^9, 
  4.002360626641027*^9}},ExpressionUUID->"1de5c20c-977b-4edb-bbcd-\
24e8cb7004e9"],

Cell["Example: interpolate g(x) = e^x sin(5x) from 12 nodes.", "Text",ExpressionUUID->"e2268d34-31c5-4557-a004-41c4a04b53af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"5", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"node", "[", 
       RowBox[{"i", ",", " ", "n"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", 
        RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
    "N"}]}], ";"}], "\n", 
 RowBox[{"cg", " ", "=", " ", 
  RowBox[{"chebCoeffs1D", "[", 
   RowBox[{"g", " ", "/@", " ", "xs"}], "]"}]}]}], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"c0fe35b2-11b5-47e4-959c-80f5a92dbba9"],

