Cell["\<\
The equispaced polynomial oscillates wildly near the edges, and it gets worse \
as n grows. The Chebyshev one converges. The Chebyshev points cluster near \
the endpoints, like the projection onto the x axis of equally spaced points \
on a semicircle. That clustering is the whole trick.\
\>", "Text",ExpressionUUID->"f56dada0-0da1-47d7-87d6-5561116dd05d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Graphics", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Circle", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", "1", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "Pi"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Gray", ",", " ", 
         RowBox[{"Line", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
              RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", "t", "]"}], ",", " ", "0"}], "}"}]}], "}"}],
           "]"}], ",", " ", "Blue", ",", " ", 
         RowBox[{"PointSize", "[", "Medium", "]"}], ",", " ", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "t", "]"}], ",", " ", "0"}], "}"}], "]"}], 
         ",", " ", "Black", ",", " ", 
         RowBox[{"Point", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "t", "]"}], ",", " ", 
            RowBox[{"Sin", "[", "t", "]"}]}], "}"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "i"}], " ", "+", " ", "1"}], ")"}], " ", 
            RowBox[{"Pi", "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "n"}], ")"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "0", ",", " ", 
             RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "}"}]}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Axes", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"True", ",", " ", "False"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"de3495c2-651c-4f9d-b023-d30ceb3d950b"],

