}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], ",", " ", 
     RowBox[{"chebEval1D", "[", 
      RowBox[{"cg", ",", " ", "x"}], "]"}]}], "}"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Black", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"Red", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"PointSize", "[", "Medium", "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Point", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"xs", ",", " ", 
          RowBox[{"g", " ", "[", "xs", "]"}]}], "}"}], "]"}], "]"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "converts", " ", "a", " ", "list", " ", "of", " ", "two", " ", "long", 
        " ", "lists", " ", 
        RowBox[{"(", 
         RowBox[{"2", " ", "x", " ", "n", " ", "matrix"}], ")"}], " ", "into",
         " ", "a", " ", "list", " ", "of", " ", "n", " ", "pairs", " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "x", " ", "2", " ", "matrix"}], ")"}]}], ",", " ", 
       
       RowBox[{
       "so", " ", "effectively", " ", "a", " ", "collection", " ", "of", " ", 
        "points"}]}], "*)"}], "\[IndentingNewLine]", "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
