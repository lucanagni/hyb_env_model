Cell[CellGroupData[{

Cell["7. The real data: the 0PA flux grid", "Section",ExpressionUUID->"41607c54-f561-4aa3-b072-8381409c6e9e"],

Cell[CellGroupData[{

Cell["7.1 Load and inspect", "Subsection",ExpressionUUID->"8deac53a-81f7-470b-899d-71db8f2f1327"],

Cell["\<\
The grid computed in FluxGrid_nonspinning.nb was saved to \
data/fluxGrid_nR18_nA27_lmax8.m. It's an nR \[Times] nA \[Times] 4 array; \
entry [[i+1, j+1]] = {rC_i, \[Chi]_j, r0^5 F_\[Infinity], r0^(15/2) F_H} \
(note the +1: Mathematica lists start at 1, the node index at 0).\
\>", "Text",ExpressionUUID->"0673e55d-77d8-4a59-bec5-97e1b0def432"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", " ", "=", " ", 
   RowBox[{"Get", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "dir", ",", " ", "\"\<data\>\"", ",", " ", 
       "\"\<fluxGrid_nR18_nA27_lmax8.m\>\""}], "}"}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"nR", ",", " ", "nA"}], "}"}], " ", "=", " ", 
  RowBox[{"Most", "@", 
   RowBox[{"Dimensions", "[", "data", "]"}]}]}]}], "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"44cb03c2-7e84-40a0-a339-1f9769cf47d1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"18", ",", "27"}], "}"}]], "Output",
 CellChangeTimes->{4.0023539359806232`*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"4bafebdf-ed7f-4520-bbf7-bfd2bfe3e250"]
}, Open  ]],

Cell["\<\
Check that the stored coordinates are exactly the Chebyshev nodes, in the \
expected order:\
\>", "Text",ExpressionUUID->"01ab1d00-4c5d-44be-bb99-015a4e61a169"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Max", "@", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", "1", ",", " ", "1"}], "]"}], "]"}], " ", 
       "-", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"node", "[", 
          RowBox[{"i", ",", " ", "nR"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", 
           RowBox[{"nR", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ",", " ", 
    RowBox[{"Max", "@", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", " ", "All", ",", " ", "2"}], "]"}], "]"}], " ", 
       "-", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"node", "[", 
          RowBox[{"j", ",", " ", "nA"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", 
           RowBox[{"nA", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}]}], 
   "}"}], " ", "//", " ", "N"}]], "Input",
 CellLabel->"In[67]:=",ExpressionUUID->"f6fa4908-51a3-42ec-a1c2-e2c30188132c"],

