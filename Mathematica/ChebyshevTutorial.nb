Cell["\<\
(The odd coefficients of Runge's function vanish because it is even.)\
\>", "Text",ExpressionUUID->"4f417e29-4bed-49b7-93f9-d1e80f33fc4c"],

Cell[CellGroupData[{

Cell["Exercise 4", "Subsection",ExpressionUUID->"3623fb54-d17c-48f2-9765-9de9a8b61cbb"],

Cell["\<\
(a) Repeat the convergence plot for |x| and for the step-like tanh(20 x). How \
do the rates differ, and why? (b) For g with n = 12, compare the actual \
maximum error with |c_10| + |c_11|. Is \"size of the last coefficients\" a \
good estimate?\
\>", "Text",ExpressionUUID->"736b2a96-719e-4724-b562-54c4e94e2ab5"],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"f68c66b3-31fe-452e-84c0-3f2ce4309187"],

Cell[BoxData[
 RowBox[{"ListLogLogPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"errCheb", "[", 
          RowBox[{"Abs", ",", " ", "n"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "64", ",", " ", "4"}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"errCheb", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Tanh", "[", 
             RowBox[{"20", " ", "#"}], "]"}], " ", "&"}], ",", " ", "n"}], 
          "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "64", ",", " ", "4"}], "}"}]}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<|x|\>\"", ",", " ", "\"\<tanh(20x)\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n\>\"", ",", " ", "\"\<max error\>\""}], "}"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"72f2843d-5906-49ff-94d3-dbdc0f770375"],

Cell["\<\
|x| has a kink at 0: the error falls only like 1/n (a straight line on the \
log-log plot). tanh(20x) is analytic but has poles at x = \
\[PlusMinus]i\[Pi]/40, very close to the interval, so it converges \
geometrically only after n is large enough to resolve the steep region. \
Lesson: Chebyshev interpolation is excellent for smooth functions, and the \
parametrisation matters. Honet+ change variables (eqs. A11-A12) exactly to \
make the flux smoother in the new coordinates.\
\>", "Text",ExpressionUUID->"bdafdefb-d174-4176-9550-af04cba0537e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"errCheb", "[", 
    RowBox[{"g", ",", " ", "12"}], "]"}], ",", " ", 
   RowBox[{"Total", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"cg", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"-", "2"}], " ", ";;"}], "]"}], "]"}]}]}]}], "}"}]], "Input",E\
xpressionUUID->"0055535c-e275-4033-aba5-6c0e87488742"],

Cell["\<\
The estimate is conservative (here about 20 times larger than the true \
error), which is what you want from an error bar.\
\>", "Text",ExpressionUUID->"0756993a-4186-457d-8ca0-24426a330685"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Two dimensions: tensor products", "Section",ExpressionUUID->"2d991af7-3ef8-4f6e-8df3-3bea24a26cd0"],

Cell["\<\
The flux depends on two variables. On a grid of nR \[Times] nA Chebyshev \
nodes (x_i, y_j) with data F_{ij}, use products of 1D polynomials:\
\>", "Text",ExpressionUUID->"207ca2cd-263a-45dd-bfcc-b2135093942b"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"k", "=", "0"}], 
      RowBox[{
       SubscriptBox["n", "R"], "-", "1"}]], 
     RowBox[{
      UnderoverscriptBox["\[Sum]", 
       RowBox[{"l", "=", "0"}], 
       RowBox[{
        SubscriptBox["n", "A"], "-", "1"}]], 
      RowBox[{
       SubscriptBox["c", 
        RowBox[{"k", ",", "l"}]], " ", 
       RowBox[{
        SubscriptBox["T", "k"], "(", "x", ")"}], " ", 
       RowBox[{
        SubscriptBox["T", "l"], "(", "y", ")"}]}]}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"f2c14a44-\
2ac5-4572-8c02-bad63d9213ba"],

Cell["\<\
Discrete orthogonality holds separately in each direction, so the \
coefficients factorise: apply the 1D transform to each column (in x), then to \
each row (in y). With the matrices M_R (nR\[Times]nR) and M_A (nA\[Times]nA) \
of Section 4:\
\>", "Text",ExpressionUUID->"19d801e3-9d43-4565-a1a0-40fbd156f3e8"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{"C", "\[LongEqual]", 
    RowBox[{
     SubscriptBox["M", "R"], ".", "F", ".", 
     TemplateBox[{
       RowBox[{"(", 
         SubscriptBox["M", "A"], ")"}]},
      "Transpose"]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"c620bdaa-\
8dd0-4caf-acb1-34506e58ee62"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    RowBox[{"p", "(", 
     RowBox[{"x", ",", "y"}], ")"}], "\[LongEqual]", 
    RowBox[{
     TemplateBox[{
       RowBox[{"T", "(", "x", ")"}]},
      "Transpose"], ".", "C", ".", 
     RowBox[{"T", "(", "y", ")"}]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"3855f902-\
c911-44ca-acdc-0eebdd2ef4ab"],

Cell["\<\
where T(x) = (T_0(x), \[Ellipsis], T_{nR-1}(x)) is what chebT returns. That's \
the whole package: one matrix product at load time, a vector-matrix-vector \
product per evaluation.\
\>", "Text",ExpressionUUID->"d3c204dd-9d23-44e1-b1a8-8163bb86c303"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chebCoeffs2D", "[", 
     RowBox[{"F_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nR", " ", "=", " ", 
         RowBox[{"Length", "[", "F", "]"}]}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{"nA", " ", "=", " ", 
         RowBox[{"Length", "[", 
          RowBox[{"First", "[", "F", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
       "}"}], ",", " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"chebMatrix", "[", "nR", "]"}], "]"}], " ", ".", " ", "F", 
       " ", ".", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{"N", "[", 
         RowBox[{"chebMatrix", "[", "nA", "]"}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chebEval2D", "[", 
     RowBox[{
      RowBox[{"cc_", "?", "MatrixQ"}], ",", " ", 
      RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"y_", "?", "NumericQ"}]}], "]"}], " ", "/;", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "x", " ", "<=", " ", "1"}], " ", "&&",
      " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "y", " ", "<=", " ", "1"}]}]}], " ",
    ":=", " ", 
   RowBox[{
    RowBox[{"chebT", "[", 
     RowBox[{
      RowBox[{"Length", "[", "cc", "]"}], ",", " ", "x"}], "]"}], " ", ".", 
    " ", "cc", " ", ".", " ", 
    RowBox[{"chebT", "[", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"First", "[", "cc", "]"}], "]"}], ",", " ", "y"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0023778545973253`*^9, 
  4.0023778822923927`*^9}},ExpressionUUID->"aabb0d88-2647-4284-930b-\
e7e51d9210be"],

Cell["Test on a toy function on a 10 \[Times] 14 grid:", "Text",ExpressionUUID->"e6534817-1e06-4f49-b82f-c10c2fc5b61c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "x"}], " ", "y"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"2", " ", "x"}], " ", "+", " ", "y"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nx", ",", " ", "ny"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"10", ",", " ", "14"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fh", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{"N", "@", 
        RowBox[{"node", "[", 
         RowBox[{"i", ",", " ", "nx"}], "]"}]}], ",", " ", 
       RowBox[{"N", "@", 
        RowBox[{"node", "[", 
         RowBox[{"j", ",", " ", "ny"}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"nx", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", 
       RowBox[{"ny", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ch", " ", "=", " ", 
   RowBox[{"chebCoeffs2D", "[", "Fh", "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"h", "[", 
       RowBox[{"x", ",", " ", "y"}], "]"}], " ", "-", " ", 
      RowBox[{"chebEval2D", "[", 
       RowBox[{"Ch", ",", " ", "x", ",", " ", "y"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.05"}], "}"}], ",", " ", 
    
    RowBox[{"{", 
     RowBox[{"y", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.05"}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"ba73cfdc-747b-40ff-b290-0aa4dc6a2c97"],

Cell[BoxData["1.2193714976627135`*^-6"], "Output",
 CellChangeTimes->{4.002353847859166*^9},
 CellLabel->"Out[62]=",ExpressionUUID->"a08fb52a-9457-4666-94a0-73752c9bcaa9"]
}, Open  ]],

