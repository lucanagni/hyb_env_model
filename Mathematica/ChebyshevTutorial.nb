Cell[CellGroupData[{

Cell["\<\
Let me try to reproduce the result but making it human fucking readable\
\>", "Subsection",
 CellChangeTimes->{{4.0023623544461412`*^9, 4.002362366772421*^9}, {
  4.002362829837564*^9, 
  4.002362841087356*^9}},ExpressionUUID->"4357428f-f5d6-482c-b4b9-\
97150981c49e"],

Cell[BoxData[
 RowBox[{"Clear", "[", 
  RowBox[{
  "chebMatrix", ",", "chebCoeffs1D", ",", "chebEval1D", ",", "g", ",", "n", 
   ",", "xs", ",", "cg"}], "]"}]], "Input",
 CellChangeTimes->{{4.0023612177055693`*^9, 4.002361251206334*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"d6903897-69b5-4c5c-9e8c-b050e3f0da92"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chebMatrix", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        RowBox[{"2", " ", "-", " ", 
         RowBox[{"KroneckerDelta", "[", 
          RowBox[{"k", ",", " ", "0"}], "]"}]}], ")"}], "n"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"k", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "i"}], " ", "+", " ", "1"}], ")"}], " ", 
          "\[Pi]"}], 
         RowBox[{"2", " ", "n"}]]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chebCoeffs1D", "[", "f_List", "]"}], " ", ":=", 
    RowBox[{"Dot", "[", " ", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{"chebMatrix", "[", 
        RowBox[{"Length", "[", "f", "]"}], "]"}], "]"}], " ", ",", " ", "f"}],
      "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Dot", " ", "product", " ", "is", " ", "the", " ", "sum", " ", "over", " ",
     "i", " ", "in", " ", "the", " ", "formula", " ", "for", " ", "c_k"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"chebEval1D", "[", 
      RowBox[{"c_List", ",", " ", 
       RowBox[{"x_", "?", "NumericQ"}]}], "]"}], " ", "/;", " ", 
     RowBox[{
      RowBox[{"-", "1"}], " ", "<=", " ", "x", " ", "<=", " ", "1"}]}], " ", ":=",
     " ", 
    RowBox[{"Dot", "[", 
     RowBox[{
      RowBox[{"chebT", "[", 
       RowBox[{
        RowBox[{"Length", "[", "c", "]"}], ",", " ", "x"}], "]"}], " ", ",", 
      "c"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Dot", " ", "product", " ", "is", " ", "the", " ", "sum", " ", "over", " ",
     "k", " ", "in", " ", "the", " ", "formula", " ", "for", " ", "the", " ", 
    "polynomial", " ", "p", 
    RowBox[{"(", "x", ")"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{4.002361183011639*^9, 4.002361206546144*^9}, {
   4.0023613167052298`*^9, 4.002361457436767*^9}, 4.0023621855427217`*^9},
 CellLabel->
  "In[117]:=",ExpressionUUID->"db35eeb7-95b2-4a62-b8f6-ee9502559ed3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"5", " ", "x"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "12"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"node", "[", 
       RowBox[{"i", ",", " ", "n"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", 
        RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
    "N"}]}], ";"}], "\n", 
 RowBox[{"cg", " ", "=", " ", 
  RowBox[{"chebCoeffs1D", "[", 
   RowBox[{"g", "[", "xs", "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"g", " ", "/@", " ", "xs"}], " ", "is", " ", "more", " ", 
      "precise", " ", "because", " ", "it", " ", "works", " ", "also", " ", 
      "for", " ", "non"}], "-", 
     RowBox[{"iterable", " ", "functions", " ", 
      RowBox[{
       RowBox[{"g", "[", "x", "]"}], ".", " ", "But"}], " ", "simple", " ", 
      "mathematical", " ", "expressions", " ", "are", " ", "iterable"}]}], 
    ",", " ", 
    RowBox[{
    "so", " ", "the", " ", "two", " ", "are", " ", "equivalent", " ", 
     "here"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{4.002361667423018*^9, 
  4.002361716742679*^9}},ExpressionUUID->"d70b893d-9727-4fae-8cdf-\
7f16bef63881"],

