    "}"}], ",", "0.00006150353463835412`"}], "}"}]], "Output",
 CellChangeTimes->{4.002354142833393*^9, 4.0023820928125687`*^9},
 CellLabel->
  "Out[264]=",ExpressionUUID->"d1553009-d8c7-417b-abe8-7a837533edad"]
}, Open  ]],

Cell["\<\
Schwarzschild check: F_\[Infinity](r0 = 10) \[TildeTilde] 6.150e-5 (lmax = \
8). Plot against the Newtonian quadrupole flux:\
\>", "Text",ExpressionUUID->"56d37d33-f6d7-4c35-beed-ebb6103b566b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogLogPlot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FluxInfMine", "[", 
         RowBox[{"r0", ",", " ", "chi"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"chi", ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.9", ",", " ", "0.", ",", " ", 
            RowBox[{"-", "0.9"}]}], "}"}]}], "}"}]}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"32", "/", "5"}], " ", 
       RowBox[{"r0", "^", 
        RowBox[{"-", "5"}]}]}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"r0", ",", " ", "1.5", ",", " ", "1000"}], "}"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Chi] = 0.9\>\"", ",", " ", "\"\<\[Chi] = 0\>\"", ",", " ", 
      "\"\<\[Chi] = -0.9\>\"", ",", " ", "\"\<Newtonian\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Automatic", ",", " ", "Automatic", ",", " ", "Automatic", ",", " ", 
      "Dashed"}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<r0\>\"", ",", " ", "\"\<F\[Infinity]\>\""}], "}"}]}]}], 
