Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"7fcac31f-bdcf-4afe-9053-c3ffe32f7da4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pLag", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"InterpolatingPolynomial", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xs", ",", " ", 
        RowBox[{"g", " ", "/@", " ", "xs"}]}], "}"}], "]"}], ",", " ", "x"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"pLag", "[", "x", "]"}], " ", "-", " ", 
      RowBox[{"chebEval1D", "[", 
       RowBox[{"cg", ",", " ", "x"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", 
      RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.01"}], "}"}]}], 
   "]"}]}]}], "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"4a6c0781-d507-4873-94c6-09bb9d5d3ced"],

Cell[BoxData["2.831068712794149`*^-15"], "Output",
 CellChangeTimes->{4.002363258255439*^9, 4.0023633960589046`*^9},
 CellLabel->
  "Out[154]=",ExpressionUUID->"3b147e27-3ead-46ce-a52e-2e4b1bb67004"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"cg", "/", 
  RowBox[{"FourierDCT", "[", 
   RowBox[{
    RowBox[{"g", " ", "/@", " ", "xs"}], ",", " ", "2"}], "]"}]}]], "Input",Ex\
pressionUUID->"0df6f92e-e3fe-43e7-bff4-a20b14e7da5c"],

Cell["\<\
So c_k = (2 - \[Delta]_{k0})/\[Sqrt]n \[CenterDot] FourierDCT[f, 2]_k (first \
entry 1/\[Sqrt]12 \[TildeTilde] 0.289, the others 2/\[Sqrt]12 \[TildeTilde] \
0.577).\
\>", "Text",ExpressionUUID->"f6ef6ce5-35c9-495b-90c2-1d53552beb9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"clenshaw", "[", 
    RowBox[{"c_List", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"b1", " ", "=", " ", "0."}], ",", " ", 
       RowBox[{"b2", " ", "=", " ", "0."}], ",", " ", "b0"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"b0", " ", "=", " ", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
           RowBox[{"2", " ", "x", " ", "b1"}], " ", "-", " ", "b2"}]}], ";", 
         " ", 
         RowBox[{"b2", " ", "=", " ", "b1"}], ";", " ", 
         RowBox[{"b1", " ", "=", " ", "b0"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{
           RowBox[{"Length", "[", "c", "]"}], " ", "-", " ", "1"}], ",", " ", 
          "1", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{"x", " ", "b1"}], " ", "-", " ", "b2"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"clenshaw", "[", 
    RowBox[{"cg", ",", " ", "0.37"}], "]"}], ",", " ", 
   RowBox[{"chebEval1D", "[", 
    RowBox[{"cg", ",", " ", "0.37"}], "]"}], ",", " ", 
   RowBox[{"g", "[", "0.37", "]"}]}], "}"}]}], "Input",ExpressionUUID->\
"5c4c5081-4cba-4b9b-9d0a-d78867b857ec"]
}, Closed]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
5. Accuracy: convergence and the coefficients as error estimate\
\>", "Section",ExpressionUUID->"4e01de52-d935-40cc-877e-bb2a2dc2d28b"],

Cell["How good is the interpolant away from the nodes? Two facts:", "Text",ExpressionUUID->"88122ca5-f59a-471f-8754-9c907bb1cbdf"],

Cell["\<\
Near-best approximation. With Chebyshev nodes the interpolation error is at \
most (1 + \[CapitalLambda]_n) times the error of the best possible polynomial \
of degree n-1, where the Lebesgue constant \[CapitalLambda]_n ~ (2/\[Pi]) log \
n grows extremely slowly. For equispaced nodes \[CapitalLambda]_n ~ 2^n: \
that's the Runge disaster.\
\>", "Item",ExpressionUUID->"84747462-1d21-40ee-8c93-29c45e16f925"],

Cell["\<\
Convergence rate follows smoothness. For a function analytic in a \
neighbourhood of [-1,1] the coefficients and the error decay geometrically, \
like \[Rho]^(-n) (\"spectral convergence\"). For a function with only k \
continuous derivatives they decay only algebraically, like n^(-k-1).\
\>", "Item",ExpressionUUID->"36c9444e-f78b-460f-9d4b-d3595b383964"],

Cell["\<\
Practical consequence: the interpolation error is of the order of the last \
few coefficients. The truncation error is bounded by the sum of the dropped \
|c_k|, and aliasing at most doubles it. So we read off the accuracy from the \
coefficients without knowing the exact function. We use this on the flux grid.\
\>", "Text",ExpressionUUID->"7f624729-5bae-4e5f-9ab7-560cae2d7f97"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"errCheb", "[", 
     RowBox[{"f_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"chebCoeffs1D", "[", 
         RowBox[{"f", " ", "/@", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"N", "@", 
             RowBox[{"node", "[", 
              RowBox[{"i", ",", " ", "n"}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "0", ",", " ", 
              RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", " ", 
      RowBox[{"Max", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], " ", "-", " ", 
           RowBox[{"chebEval1D", "[", 
            RowBox[{"c", ",", " ", "x"}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.001"}], "}"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"ListLogPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"errCheb", "[", 
          RowBox[{"g", ",", " ", "n"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "34", ",", " ", "2"}], "}"}]}], 
      "]"}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", " ", 
         RowBox[{"errCheb", "[", 
          RowBox[{"runge", ",", " ", "n"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "4", ",", " ", "34", ",", " ", "2"}], "}"}]}], 
      "]"}]}], "\[IndentingNewLine]", "}"}], ",", " ", "\[IndentingNewLine]", 
   
   RowBox[{"Joined", " ", "->", " ", "True"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<Exp[x] Sin[5x]\>\"", ",", " ", "\"\<1/(1+25x^2)\>\""}], 
     "}"}]}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<n\>\"", ",", " ", "\"\<max error\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
