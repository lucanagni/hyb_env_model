Cell["7.4 Both variables: the full 2D interpolant", "Subsection",ExpressionUUID->"31317c98-76d9-472f-bc1d-f55cee9bd948"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Cinf", " ", "=", " ", 
   RowBox[{"chebCoeffs2D", "[", "Finf", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Chor", " ", "=", " ", 
   RowBox[{"chebCoeffs2D", "[", "Fhor", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fInfMine", "[", 
    RowBox[{
     RowBox[{"rC_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"chi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"chebEval2D", "[", 
    RowBox[{"Cinf", ",", " ", "rC", ",", " ", "chi"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fHorMine", "[", 
    RowBox[{
     RowBox[{"rC_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"chi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"chebEval2D", "[", 
    RowBox[{"Chor", ",", " ", "rC", ",", " ", "chi"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"fInfMine", "[", 
        RowBox[{
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j", ",", " ", "1"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j", ",", " ", "2"}], "]"}], "]"}]}], "]"}],
        "/", 
       RowBox[{"Finf", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], " ", "-", " ", "1"}], 
     "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", "nR"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "nA"}], "}"}]}], "]"}]}]}], "Input",
