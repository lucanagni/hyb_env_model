Cell["\<\
It reproduces the data at the nodes and approximates g in between:\
\>", "Text",ExpressionUUID->"36588ac1-2b62-4335-8bc6-ce4cec380bfe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"chebEval1D", "[", 
        RowBox[{"cg", ",", " ", "i"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "xs"}], "}"}]}], "]"}], ")"}], " ", "-", " ", 
    RowBox[{"(", 
     RowBox[{"g", "[", "xs", "]"}], ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{4.002361758254915*^9, 4.002361759536538*^9}, {
   4.0023620894014683`*^9, 4.002362093630378*^9}, {4.002362135480545*^9, 
   4.002362139034238*^9}, 4.002362325489768*^9},
