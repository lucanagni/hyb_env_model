         RowBox[{"xs", ",", " ", 
          RowBox[{"g", " ", "[", "xs", "]"}]}], "}"}], "]"}], "]"}]}], 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "converts", " ", "a", " ", "list", " ", "of", " ", "two", " ", "long", 
        " ", "lists", " ", 
        RowBox[{"(", 
         RowBox[{"2", " ", "x", " ", "n", " ", "matrix"}], ")"}], " ", "into",
         " ", "a", " ", "list", " ", "of", " ", "n", " ", "pairs", " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "x", " ", "2", " ", "matrix"}], ")"}]}], ",", " ", 
       
       RowBox[{
       "so", " ", "effectively", " ", "a", " ", "collection", " ", "of", " ", 
        "points"}]}], "*)"}], "\[IndentingNewLine]", "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
