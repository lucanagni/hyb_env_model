Cell["\<\
The coefficients decay away from the corner (k, l) = (0, 0). The checkerboard \
is a symmetry: h(-x,-y) = h(x,y), and T_k(-x) = (-1)^k T_k(x), so every c_kl \
with k + l odd vanishes (dark squares at the 1e-17 floor). The last row and \
last column of that plot are the error estimate in each direction.\
\>", "Text",ExpressionUUID->"eb6b997f-ee81-49fb-8602-efd8f407ca81"],

Cell[CellGroupData[{

Cell["Exercise 5", "Subsection",ExpressionUUID->"09f0bb1a-fc60-44ae-b565-9b0c413b2821"],

Cell["\<\
(a) Check that chebCoeffs2D[Fh] equals applying chebCoeffs1D first to every \
column of Fh and then to every row of the result. (b) Increase nx with ny \
fixed (and vice versa) and watch the error. Which direction limits the \
accuracy at (10, 14)?\
\>", "Text",ExpressionUUID->"8e7be713-e7a0-49db-8d65-fdbd5ba22125"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"nx", ",", " ", "ny"}], "}"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"10", ",", " ", "14"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Fh", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{
       RowBox[{"N", "@", 
        RowBox[{"node", "[", 
         RowBox[{"i", ",", " ", "nx"}], "]"}]}], ",", " ", 
       RowBox[{"N", "@", 
        RowBox[{"node", "[", 
         RowBox[{"j", ",", " ", "ny"}], "]"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"nx", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", 
       RowBox[{"ny", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ch", " ", "=", " ", 
    RowBox[{"chebCoeffs2D", "[", "Fh", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListDensityPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Log10", "[", 
    RowBox[{
     RowBox[{"Abs", "[", "Ch", "]"}], " ", "+", " ", 
     RowBox[{"10", "^", 
      RowBox[{"-", "30"}]}]}], "]"}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"DataRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"ny", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", 
        RowBox[{"nx", " ", "-", " ", "1"}]}], "}"}]}], "}"}]}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<l (y degree)\>\"", ",", " ", "\"\<k (x degree)\>\""}], 
     "}"}]}], ",", " ", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<Log10|c_kl|\>\""}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"InterpolationOrder", " ", "->", " ", "0"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
