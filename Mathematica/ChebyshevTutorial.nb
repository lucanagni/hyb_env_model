Cell["7.6 Compare with the package", "Subsection",ExpressionUUID->"70884e1d-0b45-479b-9fb9-83e712d7e1e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"dir", ",", " ", "\"\<FluxInterpolation.wl\>\""}], "}"}], "]"}], 
   "]"}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "[", 
     RowBox[{"Cinf", " ", "-", " ", 
      RowBox[{"FluxInterpolation`FluxChebCoeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", " ", 
   RowBox[{
    RowBox[{"FluxInterpolation`FluxInf", "[", 
     RowBox[{"10.", ",", " ", "0."}], "]"}], " ", "-", " ", 
