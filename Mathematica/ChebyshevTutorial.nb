Cell["\<\
Increasing nx helps much more: x is the limiting direction. You can predict \
this from the coefficients: compare the size of the last row and the last \
column of Ch.\
\>", "Text",ExpressionUUID->"8cc03795-b64b-45e5-85d3-b3817dcae926"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"Ch", "[", 
      RowBox[{"[", 
       RowBox[{"-", "1"}], "]"}], "]"}]}]}], ",", " ", 
   RowBox[{"Max", "@", 
    RowBox[{"Abs", "@", 
     RowBox[{"Ch", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"72dd9985-270d-425b-8026-16100abea3cf"],

