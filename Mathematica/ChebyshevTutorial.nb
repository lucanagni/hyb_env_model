Cell["\<\
The \[Chi] direction decays more slowly: the last coefficients are ~1e-3 \
compared with f ~ 6, so the interpolation error is ~1e-4 relative, dominated \
by \[Chi] near +1 (the flux changes rapidly for nearly extremal prograde \
spins). Honet+ cure this with the logarithmic spin variable (A12) and a finer \
grid.\
\>", "Text",ExpressionUUID->"def137c8-70b0-450b-ab9d-738b5d9bcfba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.5 Back to physical variables", "Subsection",ExpressionUUID->"749cd733-f5d3-44d1-97d7-fc30125ca2dc"],

Cell["\<\
To get F_\[Infinity](r0, \[Chi]): compute r_*(\[Chi]), map r0 to rC, \
evaluate, divide by r0^5. The ISCO radius has a closed form (Bardeen, Press & \
Teukolsky 1972), with \[Chi] > 0 prograde and \[Chi] < 0 retrograde:\
\>", "Text",ExpressionUUID->"7beea16b-0dce-4628-b687-13c1414251fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rISCOmine", "[", 
    RowBox[{"chi_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"Abs", "[", "chi", "]"}]}], ",", " ", "z1", ",", " ", "z2"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"z1", " ", "=", " ", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", 
            RowBox[{"a", "^", "2"}]}], ")"}], "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "3"}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "+", " ", "a"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "3"}], ")"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", " ", "-", " ", "a"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "/", "3"}], ")"}]}]}], ")"}]}]}]}], ";", "\n", "  ", 
      RowBox[{"z2", " ", "=", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{"a", "^", "2"}]}], " ", "+", " ", 
         RowBox[{"z1", "^", "2"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"3", " ", "+", " ", "z2", " ", "-", " ", 
       RowBox[{
        RowBox[{"Sign", "[", "chi", "]"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", " ", "-", " ", "z1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"3", " ", "+", " ", "z1", " ", "+", " ", 
            RowBox[{"2", " ", "z2"}]}], ")"}]}], "]"}]}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FluxInfMine", "[", 
    RowBox[{
     RowBox[{"r0_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"chi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"fInfMine", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"rISCOmine", "[", "chi", "]"}], "/", "r0"}]}], " ", "-", " ",
        "1"}], ",", " ", "chi"}], "]"}], "/", 
    RowBox[{"r0", "^", "5"}]}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"rISCOmine", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"0.998", ",", " ", "0.", ",", " ", 
      RowBox[{"-", "0.998"}]}], "}"}]}], ",", " ", 
   RowBox[{"FluxInfMine", "[", 
    RowBox[{"10.", ",", " ", "0."}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[262]:=",ExpressionUUID->"54ce4e3a-07d8-49d4-98f1-a5505bfee9dc"],

Cell[BoxData[
 RowBox[{"{", 
