Notebook[{

Cell[CellGroupData[{
Cell["\<\
Chebyshev interpolation: from the flux grid to an interpolant\
\>", "Title",ExpressionUUID->"d857c006-5bee-42d4-abae-e30aff0b847f"],

Cell[TextData[{
 "This notebook builds, step by step, the interpolant in ",
 StyleBox["FluxInterpolation.wl",
  FontFamily->"Source Code Pro",
  FontWeight->"Bold"],
 " from the numbers produced by ",
 StyleBox["FluxGrid_nonspinning.nb",
  FontFamily->"Source Code Pro",
  FontWeight->"Bold"],
 ". Evaluate the cells in order. Exercises are marked; their solutions are in \
closed cell groups (click the bracket on the right to open them). Try them \
first."
}], "Text",ExpressionUUID->"4293075e-c338-44fc-b8f3-982cd3d08973"],

Cell["\<\
Roadmap: (1) why not a plain polynomial fit on equally spaced points, (2) \
Chebyshev polynomials, (3) Chebyshev nodes, (4) 1D interpolation and its \
coefficients, (5) error and convergence, (6) 2D tensor-product interpolation, \
(7) the real flux data and the map to physical variables.\
\>", "Text",ExpressionUUID->"d447a988-c4a5-4184-9732-dc69c1789cea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dir", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"$FrontEnd", " ", "===", " ", "Null"}], ",", " ", 
     "\"\</home/luca/repos/hyb_env_model/Mathematica\>\"", ",", " ", 
     RowBox[{"NotebookDirectory", "[", "]"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"4b53c3c1-8f06-4363-8b04-b498913a07cb"],

Cell[CellGroupData[{

Cell["1. The problem: interpolating with polynomials", "Section",ExpressionUUID->"4bb73f3a-ce63-414f-9dcc-4fd04808123b"],

Cell["\<\
We know a smooth function f only at n points and want it everywhere in \
between, cheaply and accurately. The obvious choice is the unique polynomial \
of degree n-1 through the n points. Whether this works depends almost \
entirely on where the points are.\
\>", "Text",ExpressionUUID->"4efccf44-3c35-4173-b0b8-672cb0971e6d"],

Cell["\<\
Classic example (Runge): f(x) = 1/(1+25x^2) on [-1,1]. Below, the \
interpolating polynomial through 15 equally spaced points (red) versus 15 \
Chebyshev points (blue).\
\>", "Text",ExpressionUUID->"59085ea9-37f9-42db-89ba-41c720dd680b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"runge", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"25", " ", 
       RowBox[{"x", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "15"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xsEq", " ", "=", " ", 
   RowBox[{"Subdivide", "[", 
    RowBox[{
     RowBox[{"-", "1."}], ",", " ", "1.", ",", " ", 
     RowBox[{"n", " ", "-", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xsCh", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", "i"}], " ", "+", " ", "1"}], ")"}], " ", 
        RowBox[{"Pi", "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "n"}], ")"}]}]}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "0", ",", " ", 
        RowBox[{"n", " ", "-", " ", "1"}]}], "}"}]}], "]"}], " ", "//", " ", 
    "N"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pEq", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"InterpolatingPolynomial", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xsEq", ",", " ", 
        RowBox[{"runge", " ", "/@", " ", "xsEq"}]}], "}"}], "]"}], ",", " ", 
     "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pCh", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"InterpolatingPolynomial", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"xsCh", ",", " ", 
        RowBox[{"runge", " ", "/@", " ", "xsCh"}]}], "}"}], "]"}], ",", " ", 
     "x"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"runge", "[", "x", "]"}], ",", " ", 
     RowBox[{"pEq", "[", "x", "]"}], ",", " ", 
     RowBox[{"pCh", "[", "x", "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.5"}], ",", " ", "1.5"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", "Thick"}], "]"}], ",", " ", "Red", ",", " ",
       "Blue"}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<f\>\"", ",", " ", "\"\<equispaced\>\"", ",", " ", 
      "\"\<Chebyshev\>\""}], "}"}]}], ",", "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Red", ",", " ", 
      RowBox[{"PointSize", "[", "Medium", "]"}], ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"xsEq", ",", " ", 
          RowBox[{"runge", " ", "/@", " ", "xsEq"}]}], "}"}], "]"}], "]"}], 
      ",", " ", "Blue", ",", " ", 
      RowBox[{"Point", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"xsCh", ",", " ", 
          RowBox[{"runge", " ", "/@", " ", "xsCh"}]}], "}"}], "]"}], "]"}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"a01711a6-771a-4b11-9c02-3ca17448ba12"],

