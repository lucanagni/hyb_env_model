Cell[CellGroupData[{

Cell["7.2 Why the data are r0^5 F and not F", "Subsection",ExpressionUUID->"bb529e5f-17e1-40d9-a288-fd0d165e764f"],

Cell["\<\
The coordinates are the compactified ones of Honet+ eq. (A9):\
\>", "Text",ExpressionUUID->"5b59e339-c465-4f31-a4e2-cb3f941be764"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["r", "C"], "\[LongEqual]", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["r", "\"\<*\>\""]}], 
      SubscriptBox["r", "0"]], "-", "1"}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"7d61451c-\
a599-4a48-a554-449eea371f06"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["\[Chi]", "C"], "\[LongEqual]", "\[Chi]"}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"f53b21f9-\
3efd-4284-adb8-a151f996e393"],

Cell["\<\
r_* (\[Chi]) is the ISCO radius. r0 = r_* maps to rC = 1, and r0 \
\[RightArrow] \[Infinity] maps to rC = -1: the infinite range of radii fits \
into [-1,1]. At large r0 the flux behaves like the quadrupole formula, F_\
\[Infinity] \[TildeTilde] (32/5) r0^(-5), so F_\[Infinity] itself is tiny and \
steep in rC. Factoring out the known leading behaviour (A13, A14),\
\>", "Text",ExpressionUUID->"1d422341-3ace-4cad-b833-a94bfd27f804"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["f", "\"\<\[Infinity]\>\""], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox["r", "0", "5"], " ", 
     SubscriptBox["F", "\"\<\[Infinity]\>\""]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"2a44c9f7-\
bf79-4c08-833e-3f6c9f0630d4"],

Cell[BoxData[
 FormBox[
  TagBox[
   RowBox[{
    SubscriptBox["f", "\"\<H\>\""], "\[LongEqual]", 
    RowBox[{
     SubsuperscriptBox["r", "0", 
      RowBox[{"15", "/", "2"}]], " ", 
     SubscriptBox["F", "\"\<H\>\""]}]}],
   HoldForm], TraditionalForm]], "DisplayFormula",ExpressionUUID->"3bc50d83-\
54b7-4651-865c-924a53d41387"],

Cell["\<\
leaves functions of order one that tend to a constant (32/5 for \
f_\[Infinity]) at rC = -1. These are much smoother, so need fewer Chebyshev \
terms. This is the same lesson as in Exercise 4: choose variables that make \
the function smooth.\
\>", "Text",ExpressionUUID->"9af4233a-cb09-4472-b40d-c4dd5b497062"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Finf", " ", "=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "All", ",", " ", "3"}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Fhor", " ", "=", " ", 
   RowBox[{"N", "@", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "All", ",", " ", "4"}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{"MinMax", " ", "/@", " ", 
  RowBox[{"{", 
   RowBox[{"Finf", ",", " ", "Fhor"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"Finf", "[", 
   RowBox[{"[", 
    RowBox[{"-", "1"}], "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"row", " ", "closest", " ", "to", " ", "rC"}], " ", "=", " ", 
     RowBox[{"-", "1"}]}], ",", " ", 
    RowBox[{
     RowBox[{"all", " ", 
      RowBox[{"spins", ":", " ", 
       RowBox[{"close", " ", "to", " ", 
        RowBox[{"32", "/", "5"}]}]}]}], " ", "=", " ", "6.4"}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->
  "In[247]:=",ExpressionUUID->"c38ac258-056c-4848-8f59-174d3c27c9d1"],

