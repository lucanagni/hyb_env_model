Cell[CellGroupData[{

Cell["Solution", "Subsubsection",ExpressionUUID->"c7ac0b6c-5e5a-4971-845e-2caf89c31332"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"step1", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"chebCoeffs1D", " ", "/@", " ", 
     RowBox[{"Transpose", "[", "Fh", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"step2", " ", "=", " ", 
   RowBox[{"chebCoeffs1D", " ", "/@", " ", "step1"}]}], ";"}], "\n", 
 RowBox[{"Max", "@", 
  RowBox[{"Abs", "[", 
   RowBox[{"step2", " ", "-", " ", "Ch"}], "]"}]}]}], "Input",ExpressionUUID->\
"6bc1806e-24c3-4a0f-9dd0-1a425ae18238"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"err2D", "[", 
    RowBox[{"nx_", ",", " ", "ny_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ff", ",", " ", "cc"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"ff", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{
           RowBox[{"N", "@", 
            RowBox[{"node", "[", 
             RowBox[{"i", ",", " ", "nx"}], "]"}]}], ",", " ", 
           RowBox[{"N", "@", 
            RowBox[{"node", "[", 
             RowBox[{"j", ",", " ", "ny"}], "]"}]}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "0", ",", " ", 
           RowBox[{"nx", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "0", ",", " ", 
           RowBox[{"ny", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{"cc", " ", "=", " ", 
       RowBox[{"chebCoeffs2D", "[", "ff", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Max", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"x", ",", " ", "y"}], "]"}], " ", "-", " ", 
           RowBox[{"chebEval2D", "[", 
            RowBox[{"cc", ",", " ", "x", ",", " ", "y"}], "]"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.05"}], "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0.05"}], "}"}]}], 
        "]"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"err2D", "[", 
    RowBox[{"10", ",", " ", "14"}], "]"}], ",", " ", 
   RowBox[{"err2D", "[", 
    RowBox[{"16", ",", " ", "14"}], "]"}], ",", " ", 
   RowBox[{"err2D", "[", 
    RowBox[{"10", ",", " ", "20"}], "]"}]}], "}"}]}], "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"7633f9eb-acc3-41c7-a8f0-852098a68395"],

