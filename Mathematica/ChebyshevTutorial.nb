Cell[CellGroupData[{

Cell["Exercise 3", "Subsection",ExpressionUUID->"1206a413-f54a-41de-b287-e2e492650a1c"],

Cell["\<\
(a) Show that chebEval1D[cg, x] and InterpolatingPolynomial on the same 12 \
points are the same polynomial (compare them on a fine grid). (b) The \
coefficients are also given by the built-in FourierDCT[f, 2]. Find the \
normalisation factor that relates FourierDCT[g /@ xs, 2] to cg. (c) Implement \
Clenshaw's algorithm, the standard stable way to evaluate a Chebyshev series \
without computing cosines: b_k = c_k + 2x b_{k+1} - b_{k+2}, going down from \
k = n-1 to k = 1 with b_n = b_{n+1} = 0; then p(x) = c_0 + x b_1 - b_2.\
\>", "Text",ExpressionUUID->"e30df5b5-dd53-4e47-809f-15179cc18661"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ip", "[", "x_", "]"}], ":=", 
  RowBox[{"InterpolatingPolynomial", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"xs", ",", 
       RowBox[{"g", "[", "xs", "]"}]}], "}"}], "]"}], ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], ",", " ", 
     RowBox[{"chebEval1D", "[", 
      RowBox[{"cg", ",", " ", "x"}], "]"}], ",", 
     RowBox[{"Ip", "[", "x", "]"}]}], "}"}], " ", ",", "\[IndentingNewLine]", 
   
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1"}], "}"}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Black", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
   "\[IndentingNewLine]", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"Red", ",", " ", "\[IndentingNewLine]", 
      RowBox[{"PointSize", "[", "Medium", "]"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{"Point", "[", 
       RowBox[{"Transpose", "[", 
