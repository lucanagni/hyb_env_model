      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f", "=", 
           RowBox[{"Quiet", "[", 
            RowBox[{"(*", 
             RowBox[{"suppress", " ", "warning", " ", "messages"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"modeAt", "[", 
             RowBox[{"i", ",", "j", ",", "l", ",", "m", ",", "p"}], "]"}], 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "compute", " ", "amplitudes", " ", "at", " ", "precision", " ", 
               
               RowBox[{"p", ":", " ", 
                RowBox[{"f", " ", "is", " ", "a", " ", "list", " ", "f"}]}]}],
               "=", 
              RowBox[{"{", "AmplInf", "}"}]}], "*)"}], "\[IndentingNewLine]", 
            "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"f", ",", "amplOkQ"}], "]"}], ",", 
           RowBox[{"Throw", "[", "f", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"check", " ", "that", " ", "amplitude", " ", "passes", " ", 
          RowBox[{"tests", ".", " ", "\[IndentingNewLine]", "If"}], " ", "so",
           " ", "Throw", " ", "exits", " ", "the", " ", "loop", " ", "and", 
          " ", "Catch", " ", "returns", " ", 
          RowBox[{"{", 
           RowBox[{"AmplInf", ",", "precision"}], "}"}], 
          "\[IndentingNewLine]", "Otherwise", " ", "rerun", " ", "at", " ", 
          "higher", " ", "res"}], "*)"}], "\[IndentingNewLine]", "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"p", ",", "precLadder"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"Indeterminate", ",", "None"}], "}"}]}], " ", 
    RowBox[{"(*", 
     RowBox[{
     "output", " ", "if", " ", "all", " ", "loop", " ", "fails", " ", "at", 
      " ", "all", " ", "precisions"}], "*)"}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",
