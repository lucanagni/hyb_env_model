   RowBox[{
    RowBox[{"modeSphericalVec", "[", 
     RowBox[{"i_", ",", "j_", ",", "lmax_", ",", "m_", ",", "N_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
