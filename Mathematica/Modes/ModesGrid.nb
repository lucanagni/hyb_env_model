       RowBox[{"params", "=", 
        RowBox[{"Most", "[", 
         RowBox[{"nodeOrbit", "[", 
          RowBox[{"i", ",", "j", ",", "p"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chi", "=", 
