       "\[IndentingNewLine]", 
       RowBox[{"lmax", "=", 
        RowBox[{"l", "+", "N"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"muAt", "[", 
           RowBox[{
           "i", ",", "j", ",", "l", ",", "lp", ",", "m", ",", "40", ",", 
            "numTerms"}], "]"}], "*", 
          RowBox[{"First", "[", 
           RowBox[{"modeAdaptive", "[", 
            RowBox[{"i", ",", "j", ",", "lp", ",", "m"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"lp", ",", "lmin", ",", "lmax"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"muCol", "[", 
     RowBox[{"lp_", ",", "m_", ",", "\[Gamma]_", ",", "lmax_", ",", "N_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
