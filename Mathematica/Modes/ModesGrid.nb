Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"node", "[", 
    RowBox[{"i_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Cos", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", "i"}], "+", "1"}], ")"}], 
     RowBox[{"Pi", "/", 
      RowBox[{"(", 
       RowBox[{"2", "n"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"modes", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "]"}], ",", "1"}], 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nodeOrbit", "[", 
     RowBox[{"i_", ",", "j_", ",", "p_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rC", ",", "chi", ",", "rstar", ",", "r0", ",", "Omg"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rC", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"node", "[", 
           RowBox[{"i", ",", "nR"}], "]"}], ",", "p"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"chi", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"node", "[", 
           RowBox[{"j", ",", "nA"}], "]"}], ",", "p"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rstar", "=", 
        RowBox[{"KerrGeoISCO", "[", 
         RowBox[{"chi", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"r0", "=", 
        RowBox[{"2", 
         RowBox[{"rstar", "/", 
          RowBox[{"(", 
           RowBox[{"rC", "+", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"Omg", "=", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"chi", "+", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"2", "rstar"}], 
              RowBox[{"(", 
               RowBox[{"rC", "+", "1"}], ")"}]], ")"}], 
            RowBox[{"3", "/", "2"}]]}], ")"}], 
         RowBox[{"-", "1"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"rC", ",", "chi", ",", "r0", ",", "Omg", ",", 
         RowBox[{"KerrGeoOrbit", "[", 
          RowBox[{"chi", ",", "r0", ",", "0", ",", "1"}], "]"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"modeAt", "[", 
     RowBox[{"i_", ",", "j_", ",", "l_", ",", "m_", ",", "p_"}], "]"}], ":=", 
    
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", "md", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"md", "=", 
