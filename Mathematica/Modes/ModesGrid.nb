Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\n", " ", 
   RowBox[{
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "t0", ",", " ", "tasks", ",", " ", "res", ",", " ", "coords", ",", " ",
         "lmin", ",", " ", "dir", ",", " ", "grid", ",", " ", "nBad"}], "}"}],
       ",", "\n", "  ", 
      RowBox[{
       RowBox[{"t0", " ", "=", " ", 
        RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       "\n", "  ", 
       RowBox[{"tasks", " ", "=", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "j"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "0", ",", " ", 
              RowBox[{"nR", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"j", ",", " ", "0", ",", " ", 
              RowBox[{"nA", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", " ", 
          "1"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "tasks", " ", "only", " ", "labelled", " ", "by", " ", "gridpoint"}],
          ",", " ", 
         RowBox[{"not", " ", "by", " ", "lm", " ", "value"}], ",", " ", 
         RowBox[{"since", " ", "different", " ", 
          RowBox[{"(", 
           RowBox[{"l", ",", "m"}], ")"}], " ", "are", " ", "not", " ", "all",
           " ", "computed", " ", 
          RowBox[{"separately", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]",
        "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"With", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mm", " ", "=", " ", "m"}], ",", " ", 
            RowBox[{"nn", " ", "=", " ", "nExtra"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"ParallelMap", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"modeSphericalVec", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", "lmax", ",", " ", 
               "mm", ",", " ", "nn"}], "]"}], " ", "&"}], ",", " ", "tasks", 
