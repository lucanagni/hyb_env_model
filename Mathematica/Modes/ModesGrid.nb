         RowBox[{"tasks", " ", "->", " ", "res"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\n", "  ", 
       RowBox[{"coords", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"nodeOrbit", "[", 
            RowBox[{"i", ",", " ", "j", ",", " ", "40"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", " ", ";;", " ", "2"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "0", ",", " ", 
            RowBox[{"nR", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", 
            RowBox[{"nA", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"lmin", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "s", "]"}], ",", " ", 
          RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\n", "  ", 
       RowBox[{"dir", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"dataDir", ",", " ", 
           RowBox[{"\"\<m\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "m", "]"}]}]}], "}"}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", " ", 
          RowBox[{"DirectoryQ", "[", "dir", "]"}]}], ",", " ", 
         RowBox[{"CreateDirectory", "[", "dir", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "In", " ", "every", " ", "grid", " ", "point", " ", "fix", " ", 
          RowBox[{"(", 
           RowBox[{"m", ",", "lmax"}], ")"}]}], ",", " ", 
         RowBox[{
         "recover", " ", "all", " ", "modes", " ", "with", " ", "given", " ", 
          "m", " ", "up", " ", "to", " ", "ellmax"}], ",", " ", 
         RowBox[{
         "write", " ", "in", " ", "a", " ", "different", " ", "file", " ", 
          "for", " ", "each", " ", "l"}]}], " ", "*)"}], "\n", "  ", 
       RowBox[{"Do", "[", "\n", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"grid", " ", "=", " ", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"coords", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", " ", "+", " ", "1"}], ",", " ", 
                  RowBox[{"j", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", " ", 
               RowBox[{
                RowBox[{"res", "[", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", " ", "j"}], "}"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"l", " ", "-", " ", "lmin", " ", "+", " ", "1"}], 
                 "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"(*", " ", 
              RowBox[{"each", " ", "written", " ", "line", " ", "is", " ", 
               RowBox[{"{", 
                RowBox[{"rC", ",", " ", "chi", ",", " ", "hlm"}], "}"}]}], 
              " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "0", ",", " ", 
               RowBox[{"nR", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", "0", ",", " ", 
               RowBox[{"nA", " ", "-", " ", "1"}]}], "}"}]}], 
            "\[IndentingNewLine]", "]"}]}], ";", "\n", "   ", 
          RowBox[{"Put", "[", "\[IndentingNewLine]", 
           RowBox[{"grid", ",", "\[IndentingNewLine]", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", 
               RowBox[{"\"\<amplGrid_nR\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "nR", "]"}], " ", "<>", " ", 
                "\"\<_nA\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "nA", "]"}], " ", "<>", " ", 
                "\"\<_l\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "l", "]"}], " ", "<>", " ", 
                "\"\<m\>\"", " ", "<>", " ", 
                RowBox[{"ToString", "[", "m", "]"}], " ", "<>", " ", 
                "\"\<.m\>\""}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
           "]"}]}], ",", "\n", "   ", 
         RowBox[{"{", 
          RowBox[{"l", ",", " ", "lmin", ",", " ", "lmax"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\n", "\[IndentingNewLine]", "  ", 
       
       RowBox[{"nBad", " ", "=", " ", 
        RowBox[{"Count", "[", 
         RowBox[{
          RowBox[{"Values", "[", "res", "]"}], ",", " ", 
          RowBox[{"v_", " ", "/;", " ", 
           RowBox[{"!", " ", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"v", ",", " ", "Indeterminate"}], "]"}]}]}]}], "]"}]}], 
       ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<m = \>\"", ",", " ", "m", ",", " ", "\"\<: \>\"", ",", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], "]"}], 
         ",", " ", "\"\< s, nodes with Indeterminate: \>\"", ",", " ", 
         "nBad"}], "]"}]}]}], "]"}], ",", "\[IndentingNewLine]", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"m", ",", " ", "1", ",", " ", "lmax"}], "}"}]}], 
