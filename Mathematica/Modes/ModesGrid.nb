          RowBox[{"Last", "[", 
           RowBox[{"nodeOrbit", "[", 
            RowBox[{"i", ",", "j", ",", "p"}], "]"}], "]"}]}], "]"}]}], ";", 
       " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Last", " ", "extracts", " ", "last", " ", "element", " ", "of", " ",
           "list", " ", 
          RowBox[{"(", "duh", ")"}]}], " ", "->", " ", 
         RowBox[{
         "the", " ", "geodesic", " ", "orbit", " ", "in", " ", "this", " ", 
          "case"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"md", "[", "\"\<Amplitudes\>\"", "]"}], "[", 
         "\"\<\[ScriptCapitalI]\>\"", "]"}], "}"}]}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "check", " ", "that", " ", "\[IndentingNewLine]", "1.", " ", "f", " ", 
     "is", " ", "a", " ", "number"}], ",", " ", 
    RowBox[{"not", " ", "an", " ", "unevaluated", " ", "symbol", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", ".", " ", "Undeterminate"}], ",", " ", 
       RowBox[{"Failed", " ", 
        RowBox[{"etc", "."}]}]}], ")"}], "\[IndentingNewLine]", "2.", " ", 
     "f", " ", "is", " ", "an", " ", "arbitrary", " ", "precision", " ", 
     "number"}], ",", " ", 
    RowBox[{"not", " ", "an", " ", "exact", " ", "number", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"e", ".", "g", ".", " ", "0"}], " ", "or", " ", 
       RowBox[{"1", "/", "2"}]}], ")"}], "\[IndentingNewLine]", "3.", " ", 
     "f", " ", "has", " ", "at", " ", "least", " ", "12", " ", "significant", 
     " ", "digits", " ", 
     RowBox[{"(", 
      RowBox[{"Precision", " ", ">", " ", "Threshold"}], ")"}], 
     "\[IndentingNewLine]", "If", " ", "all", " ", "three", " ", "hold", " ", 
     "returns", " ", "True"}], ",", " ", 
    RowBox[{"otherwise", " ", "False"}]}], "\[IndentingNewLine]", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"amplOkQ", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{"NumberQ", "[", "f", "]"}], "&&", 
     RowBox[{
      RowBox[{"Precision", "[", "f", "]"}], "<", "Infinity"}], "&&", 
     RowBox[{
      RowBox[{"Precision", "[", "f", "]"}], ">=", "precGoal"}]}]}], ";"}], 
  " ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeAdaptive", "[", 
    RowBox[{"i_", ",", "j_", ",", "l_", ",", "m_"}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Catch", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Do", "[", " ", 
      RowBox[{"(*", 
       RowBox[{"loops", " ", "over", " ", "precision", " ", "ladder", " ", 
