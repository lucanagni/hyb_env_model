          RowBox[{"Abs", "[", "m", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"l0", "=", 
        RowBox[{"lp", "-", 
         RowBox[{"Min", "[", 
          RowBox[{
