              RowBox[{"\"\<NumTerms\>\"", "->", "N"}]}], "}"}]}]}], "]"}], 
         "[", "\"\<ExpansionCoefficients\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeffs", "[", "l", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"modeSpherical", "[", 
     RowBox[{"i_", ",", "j_", ",", "l_", ",", "m_", ",", "N_"}], "]"}], ":=", 
    
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
