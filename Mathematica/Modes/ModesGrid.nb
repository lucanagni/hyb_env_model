       "\[IndentingNewLine]", 
       RowBox[{"coeffs", "=", 
        RowBox[{
         RowBox[{"SpinWeightedSpheroidalHarmonicS", "[", 
          RowBox[{"s", ",", "lp", ",", "m", ",", "\[Gamma]", ",", 
           RowBox[{"Method", "->", 
            RowBox[{"{", 
