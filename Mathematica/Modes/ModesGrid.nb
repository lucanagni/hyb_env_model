Cell["Amplitude grid", "Section",ExpressionUUID->"43473a8c-5502-447a-84d3-deb796976343"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$KernelCount", " ", "==", " ", "0"}], ",", " ", 
    RowBox[{"LaunchKernels", "[", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ParallelEvaluate", "[", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", " ", 
    RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], ";", " ", 
    RowBox[{"Needs", "[", "\"\<SpinWeightedSpheroidalHarmonics`\>\"", "]"}], 
