    "s", ",", " ", "nR", ",", " ", "nA", ",", " ", "lmax", ",", " ", 
     "precLadder", ",", " ", "precGoal", ",", " ", "numTerms", ",", " ", 
     "node", ",", " ", "nodeOrbit", ",", " ", "modeAt", ",", " ", "amplOkQ", 
     ",", " ", "modeAdaptive", ",", " ", "muCol", ",", " ", "muMatrix", ",", 
