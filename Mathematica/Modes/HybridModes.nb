Notebook[{

Cell[CellGroupData[{
Cell["Hybrid Modes", "Title",
 CellChangeTimes->{{4.004443090708498*^9, 
  4.004443092461073*^9}},ExpressionUUID->"40ade68d-3825-4f8c-8f93-\
4769204fc286"],

Cell["\<\
Generated by tools/make_PNModes_nb.wls from PNpedia commit a64de8b. Rerun the \
script rather than editing the definitions by hand.\
\>", "Text",ExpressionUUID->"449cd961-9b4e-40cf-9bf8-78357fb07bd4"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"9982d31f-82ad-4772-97d2-37afd8475cad"],

Cell[CellGroupData[{

Cell["Conventions", "Section",ExpressionUUID->"30c0ee2e-fb07-4905-ba8a-91a2e89115a3"],

Cell["\<\
Waveform decomposition (PNpedia README of the Waveform folders): h = h+ - i \
hx = (G m/(c^2 R)) Sum_lm h_lm e^(-i m psi) Y^(-2)_lm(theta, phi), with psi \
the tail-shifted phase (Honet eq. 9). Only m > 0 modes are listed; h_(l,-m) = \
(-1)^l Conjugate[h_lm]. G = c = 1, m = M total mass.\
\>", "Text",ExpressionUUID->"f7b9f4ab-50ac-46c3-8c7f-17fe93730134"],

Cell["\<\
Variables: x = (M omega_22/2)^(2/3) frequency parameter of the (2,2) mode; \
\[Nu] = m1 m2/M^2; \[Delta] = (m1 - m2)/M = Sqrt[1 - 4 \[Nu]]; s = (m1^2 \
\[Chi]1 + m2^2 \[Chi]2)/M^2; \[Sigma] = (m2 \[Chi]2 - m1 \[Chi]1)/M.\
\>", "Text",ExpressionUUID->"5a5561a9-4c95-4a67-83b0-410ce2db06cb"],

Cell["\<\
Spin map for a spinning primary (m1, the heavier body, spin \[Chi]) and a \
nonspinning secondary (Honet eq. B6: a = m1 \[Chi], S = m1 a, \[CapitalSigma] \
= -M a).\
\>", "Text",ExpressionUUID->"80c9ec64-86ab-48da-bc18-7cc777294024"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]Of", "[", "\[Nu]_", "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"4", "*", "\[Nu]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sOf", "[", 
    RowBox[{"\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"\[Delta]Of", "[", "\[Nu]", "]"}]}], ")"}], "/", "2"}], 
      ")"}], "^", "2"}], "*", "\[Chi]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Of", "[", 
    RowBox[{"\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"\[Delta]Of", "[", "\[Nu]", "]"}]}], ")"}], "/", "2"}], 
      ")"}]}], "*", "\[Chi]"}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"1751aa1f-9b79-40d8-be43-64606e4b389a"],

Cell["\<\
Each mode is written as (Newtonian prefactor c \[Nu] x^n0) * (sum over x^k \
terms). The prefactor is the leading nonspinning term with \[Nu] -> 0, \
\[Delta] -> 1; the \[Nu]-dependence of the leading term (Honet's \[Alpha]_lm) \
stays inside the bracket.\
\>", "Text",ExpressionUUID->"913cf144-1f39-4870-95c3-014a936526a9"]
}, Open  ]],

Cell[CellGroupData[{

