Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ParallelEvaluate", "[", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", 
    RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], ";"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DistributeDefinitions", "[", 
    RowBox[{
    "nR", ",", "nA", ",", "lmax", ",", "precLadder", ",", "precGoal", ",", 
     "node", ",", "modes", ",", "nodeOrbit", ",", "modeAt", ",", "fluxOkQ", 
     ",", "modeAdaptive"}], "]"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"subkernels", " ", "have", " ", "their", " ", "own"}], ",", " ", 
    RowBox[{"empty", " ", "global", " ", 
     RowBox[{"context", ".", " ", "this"}], " ", "gives", " ", "them", " ", 
     "the", " ", "definitions", " ", "they", " ", "need"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tasks", "=", 
    RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", 
          RowBox[{"Sequence", "@@", "md"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"nR", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", 
          RowBox[{"nA", "-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"md", ",", "modes"}], "}"}]}], "]"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"list", " ", "of", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", "l", ",", "m"}], "}"}], " ", 
        "combinations"}], " ", "*)"}], "\[IndentingNewLine]", "2"}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{"2", " ", 
       RowBox[{"dim", ":", " ", 
        RowBox[{
         RowBox[{"it", "'"}], "s", " ", "a", " ", "4", "x", 
         RowBox[{"(", 
          RowBox[{"nR", "*", "nA", "*", "ell", "*", "emm"}], ")"}], " ", 
         "matrix"}]}]}], "*)"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"modeRes", "=", 
    RowBox[{"ParallelMap", "[", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"spreads", " ", "over", " ", "the", " ", "kernels"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"modeAdaptive", "@@", "#"}], "&"}], ",", "tasks", ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"fancy", " ", "for", " ", 
        RowBox[{"modeAdaptive", "[", 
         RowBox[{"i", ",", "j", ",", "l", ",", "m"}], "]"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Method", "->", "\"\<FinestGrained\>\""}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "hands", " ", "out", " ", "one", " ", "task", " ", "at", " ", "the", 
       " ", "time", " ", "to", " ", "balance", " ", "load"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "This", " ", "is", " ", "the", " ", "pointwise", " ", "computation", 
       " ", "of", " ", "the", " ", 
       RowBox[{"modes", ":", " ", 
        RowBox[{
        "each", " ", "output", " ", "is", " ", "a", " ", "list", " ", 
         RowBox[{"{", 
          RowBox[{"FI", ",", " ", "FH", ",", " ", "precUsed"}], "}"}]}]}]}], 
      " ", "*)"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeData", "=", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{"tasks", "->", "modeRes"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"creates", " ", "a", " ", 
     RowBox[{"dictionary", ".", " ", "Associates"}], " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", "j", ",", "l", ",", "m"}], "}"}], " ", "as", " ", 
     "the", " ", "key", " ", "with", " ", "the", " ", "output", " ", 
     "value"}], ",", " ", 
    RowBox[{
    "so", " ", "that", " ", "any", " ", "mode", " ", "can", " ", "be", " ", 
     "looked", " ", "up", " ", "through", " ", "the", " ", 
     RowBox[{"key", ".", " ", "Works"}], " ", "because", " ", "the", " ", 
     "output", " ", "of", " ", "modeRes", " ", "is", " ", "in", " ", "the", 
     " ", "same", " ", "order", " ", "of", " ", "tasks"}], ",", " ", 
    RowBox[{"so", " ", "it", " ", "can", " ", "associate", " ", "the", " ", 
     RowBox[{"two", ".", "\[IndentingNewLine]", " ", "Used"}], " ", "to", " ",
      "generate", " ", "data", " ", "table"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Counts", "[", 
   RowBox[{"modeRes", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Counts", " ", "how", " ", "many", " ", "times", " ", "each", " ", 
    "precision", " ", "was", " ", "needed", " ", 
    RowBox[{"(", 
     RowBox[{"output", " ", "of", " ", "cell"}], ")"}]}], " ", "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"nodeFromModes", "[", 
      RowBox[{"i", ",", "j", ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"sum", " ", "the", " ", "contributions", " ", 
         RowBox[{"(", 
          RowBox[{"see", " ", "above"}], ")"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"modeData", "[", " ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "dig", " ", "up", " ", "the", " ", "result", " ", "for", " ", 
            "each", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j", ",", "l", ",", "m"}], "}"}], " ", "key"}],
            " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}], ",", "#"}], "]"}], "]"}], "&"}], 
        "/@", "modes"}]}], " ", 
      RowBox[{"(*", " ", 
       RowBox[{"rebuilds", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j", ",", "l", ",", "m"}], "}"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"nR", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", 
       RowBox[{"nA", "-", "1"}]}], "}"}]}], " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "do", " ", "this", " ", "for", " ", "all", " ", "grid", " ", "nodes"}], 
     " ", "*)"}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
