Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu0", "=", 
    RowBox[{"14", "/", 
     RowBox[{"15", "^", "2"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"panelEnergy", "[", 
     RowBox[{"\[Chi]0_", ",", "xmin_", ",", "xmax_"}], "]"}], ":=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"nu0", " ", 
           RowBox[{"geoBindingEnergy", "[", 
            RowBox[{"x", ",", "\[Chi]0"}], " ", "]"}]}], "-", 
          RowBox[{"nu0", " ", 
           RowBox[{"geoBindingEnergy", "[", 
            RowBox[{"xmin", ",", "\[Chi]0"}], " ", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"totalBindingEnergy4PN", "[", 
           RowBox[{"x", ",", "nu0", ",", "\[Chi]0"}], "]"}], "-", 
          RowBox[{"totalBindingEnergy4PN", "[", 
           RowBox[{"xmin", ",", "nu0", ",", "\[Chi]0"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"HybridBindingEnergy", "[", 
           RowBox[{"x", ",", "nu0", ",", "\[Chi]0"}], "]"}], "-", 
          RowBox[{"HybridBindingEnergy", "[", 
           RowBox[{"xmin", ",", "nu0", ",", "\[Chi]0"}], "]"}]}]}], "}"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Orange", ",", "Blue", ",", "Red"}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
