          RowBox[{"114635", "/", "99792"}], " ", 
          RowBox[{"\[Nu]", "^", "3"}]}], " ", "-", 
         RowBox[{
          RowBox[{"428", "/", "105"}], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"16", " ", "x"}], "]"}]}]}], ")"}], 
       RowBox[{"x", "^", "3"}]}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2173"}], "/", "756"}], " ", "-", 
         RowBox[{
          RowBox[{"2495", "/", "378"}], " ", "\[Nu]"}], " ", "+", 
         RowBox[{
          RowBox[{"40", "/", "27"}], " ", 
          RowBox[{"\[Nu]", "^", "2"}]}]}], ")"}], "\[Pi]", " ", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"7", "/", "2"}], ")"}]}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "846557506853"}], "/", "12713500800"}], " ", "+", 
         RowBox[{
          RowBox[{"45796", "/", "2205"}], " ", "EulerGamma"}], " ", "-", 
         RowBox[{
          RowBox[{"107", "/", "63"}], " ", 
          RowBox[{"\[Pi]", "^", "2"}]}], " ", "+", 
         RowBox[{
          RowBox[{"22898", "/", "2205"}], " ", 
          RowBox[{"Log", "[", 
           RowBox[{"16", " ", "x"}], "]"}]}], " ", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "336005827477"}], "/", "4237833600"}], " ", "+", 
            RowBox[{
             RowBox[{"15284", "/", "441"}], " ", "EulerGamma"}], " ", "-", 
            RowBox[{
             RowBox[{"9755", "/", "32256"}], " ", 
             RowBox[{"\[Pi]", "^", "2"}]}], " ", "+", 
            RowBox[{
             RowBox[{"7642", "/", "441"}], " ", 
             RowBox[{"Log", "[", 
              RowBox[{"16", " ", "x"}], "]"}]}]}], ")"}], "\[Nu]"}], " ", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"256450291", "/", "7413120"}], " ", "-", 
