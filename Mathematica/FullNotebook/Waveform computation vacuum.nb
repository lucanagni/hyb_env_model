Cell[CellGroupData[{

Cell["Computation of the binding energy", "Section",
 CellChangeTimes->{{4.003310133667736*^9, 
  4.0033101447398453`*^9}},ExpressionUUID->"68111bd4-502f-df40-9703-\
75c2bb9e9434"],

Cell[CellGroupData[{

Cell["Binding energy in SF", "Subsection",
 CellChangeTimes->{{4.003310342066805*^9, 
  4.0033103482310696`*^9}},ExpressionUUID->"8fe8fff5-8c79-e741-b769-\
e2ab5f12f989"],

Cell[CellGroupData[{

Cell["0PA binding energy", "Subsubsection",
 CellChangeTimes->{{4.003383021209652*^9, 
  4.0033830284043236`*^9}},ExpressionUUID->"5957141a-5892-b54c-9783-\
4e1fb03e2471"],

Cell["\<\
At leading SF order, it is the geodesic binding energy, that we can express \
directly as a function of \[Chi]:\
\>", "Text",
 CellChangeTimes->{{4.003310359703823*^9, 4.003310366870159*^9}, {
  4.0033104034789925`*^9, 
  4.003310454605606*^9}},ExpressionUUID->"04543505-76b3-fe4f-80a8-\
8aae15a1de98"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"geoBindingEnergy", "[", 
    RowBox[{"x_", ",", " ", "\[Chi]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"-", "1"}], " ", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", "x", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"x", "^", 
             RowBox[{"(", 
              RowBox[{"3", "/", "2"}], ")"}]}], " ", "\[Chi]"}]}], " ", ")"}],
          "^", 
         RowBox[{"(", 
          RowBox[{"1", "/", "3"}], ")"}]}]}]}], ")"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}], " ", "\[Chi]"}]}], " ", ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{"x", "^", 
           RowBox[{"(", 
            RowBox[{"3", "/", "2"}], ")"}]}], "\[Chi]"}], " ", "-", 
         RowBox[{"3", "x", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{
              RowBox[{"x", "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}], " ", "\[Chi]"}]}], " ", 
            ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "3"}], ")"}]}]}]}], ")"}]}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.0033104837838917`*^9, 4.0033105015564423`*^9}, {
  4.0033106056838627`*^9, 4.0033107560115147`*^9}},
 CellLabel->"In[84]:=",ExpressionUUID->"d7f5abae-c4f2-944b-8ad1-8fe7626d8964"],

Cell["\<\
We now want to compute the leading order correction to the binding energy. \
This correction is linked to the first order correction to the Detweiler \
redshift invariant.\
\>", "Text",
 CellChangeTimes->{{4.0033107816578407`*^9, 4.0033108106140175`*^9}, {
  4.003381632031149*^9, 
  4.0033817094109554`*^9}},ExpressionUUID->"c90615c6-ef36-974e-95b3-\
816d1dea1500"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interpolation of the first order correction of z", "Subsubsection",
 CellChangeTimes->{{4.003381717249853*^9, 
  4.0033817349897346`*^9}},ExpressionUUID->"6b715d5f-55a8-de41-b36b-\
e5f376141d9e"],

Cell["\<\
I haven\[CloseCurlyQuote]t found yet how to recover the data needed for the \
interpolation...\
\>", "Text",
 CellChangeTimes->{{4.0033817450180855`*^9, 
  4.0033817705711555`*^9}},ExpressionUUID->"b88c730e-c2f5-5747-a00f-\
fd903ef19cc6"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Binding energy in PN", "Subsection",
 CellChangeTimes->{{4.0033817786812935`*^9, 
  4.003381784291153*^9}},ExpressionUUID->"4508028e-8cab-7246-8233-\
16416f0a3a4d"],

Cell["\<\
For the non-spinning term, one has to take into account the Schott term that \
arises at 4PN. This was shown to be equivalent to taking the 4PN mechanical \
energy and replacing yPN by x (see Trestini 2025). \
\>", "Text",
 CellChangeTimes->{{4.0033828194969254`*^9, 4.003382829643017*^9}, {
  4.0033828700078278`*^9, 
  4.0033829921579895`*^9}},ExpressionUUID->"758f2247-3499-2249-8b4e-\
c15266417ec3"],

Cell["\<\
Moreover, we express here the adimensionned binding energies (divided by M).\
\>", "Text",
 CellChangeTimes->{{4.0033832392143135`*^9, 4.0033832644011784`*^9}, 
   4.0033839569623013`*^9},ExpressionUUID->"7d203c47-bddb-8b46-9cef-\
92e5a07f982b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bindingEnergyNS", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[Nu]"}], " ", 
    RowBox[{"x", " ", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", "/", "4"}], " ", "+", " ", 
         RowBox[{"\[Nu]", "/", "12"}]}], ")"}], "x"}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "27"}], "/", "8"}], "+", 
         RowBox[{
          RowBox[{"19", "/", "8"}], " ", "\[Nu]"}], " ", "-", 
         RowBox[{
          RowBox[{"\[Nu]", "^", "2"}], " ", "/", "24"}]}], ")"}], 
       RowBox[{"x", "^", "2"}]}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "675"}], "/", "64"}], " ", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"34445", "/", "576"}], " ", "-", 
            RowBox[{"205", " ", 
             RowBox[{
              RowBox[{"\[Pi]", "^", "2"}], "/", "96"}]}]}], ")"}], "\[Nu]"}], 
         " ", "-", 
         RowBox[{
          RowBox[{"155", "/", "96"}], " ", 
          RowBox[{"\[Nu]", "^", "2"}]}], " ", "-", 
         RowBox[{
          RowBox[{"35", "/", "5184"}], " ", 
          RowBox[{"\[Nu]", "^", "3"}]}]}], ")"}], 
       RowBox[{"x", "^", "3"}]}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3969"}], "/", "128"}], " ", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"9037", " ", 
             RowBox[{
              RowBox[{"\[Pi]", "^", "2"}], "/", "1536"}]}], " ", "-", 
            RowBox[{"123671", "/", "5760"}], " ", "+", 
            RowBox[{
             RowBox[{"448", "/", "15"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "EulerGamma"}], " ", "+", 
               RowBox[{"Log", "[", 
                RowBox[{"16", " ", "x"}], "]"}]}], ")"}]}]}], ")"}], 
          "\[Nu]"}], " ", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"3157", "/", "576"}], " ", 
             RowBox[{"\[Pi]", "^", "2"}]}], " ", "-", 
            RowBox[{"498449", "/", "3456"}]}], ")"}], 
          RowBox[{"\[Nu]", "^", "2"}]}], " ", "+", 
         RowBox[{
          RowBox[{"301", "/", "1728"}], " ", 
          RowBox[{"\[Nu]", "^", "3"}]}], " ", "+", 
         RowBox[{
          RowBox[{"77", "/", "31104"}], " ", 
          RowBox[{"\[Nu]", "^", "4"}]}]}], ")"}], 
       RowBox[{"x", "^", "4"}]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003383143729828*^9, 4.003383171914997*^9}, {
  4.003383271575697*^9, 4.0033832840887966`*^9}, {4.0033833306250515`*^9, 
  4.0033834279717884`*^9}, {4.0033834630274887`*^9, 4.003383885223097*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"07e57d95-63e1-6a49-a1c6-2229cb16663b"],

Cell["\<\
In the spin sectors, the Schott term correction is above 4PN, we can then use \
yPN and x interchangeably.\
\>", "Text",
 CellChangeTimes->{{4.00338391757205*^9, 
  4.0033839598235703`*^9}},ExpressionUUID->"d8bc91f1-c369-534c-ab4b-\
cc1425206e29"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bindingEnergySO", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"-", "\[Nu]"}], " ", 
    RowBox[{"\[Chi]", "/", "2"}], " ", 
    RowBox[{"x", "^", 
     RowBox[{"(", 
      RowBox[{"5", "/", "2"}], ")"}]}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"14", "/", "3"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "^", "2"}], " ", "/", 
        "4"}]}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"1", "-", 
           RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"4", "\[Nu]"}]}], "]"}]}], " ", "+", 
      RowBox[{"x", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"11", "-", 
            RowBox[{
             RowBox[{"61", "/", "9"}], " ", "\[Nu]"}]}], ")"}], 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", "-", 
                RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "^", "2"}], " ", "/",
            "4"}]}], " ", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "-", 
            RowBox[{
             RowBox[{"10", "/", "3"}], " ", "\[Nu]"}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"4", "\[Nu]"}]}], "]"}], "/", "2"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"135", "/", "4"}], " ", "-", 
            RowBox[{
             RowBox[{"367", "/", "4"}], " ", "\[Nu]"}], " ", "+", 
            RowBox[{
             RowBox[{"29", "/", "12"}], " ", 
             RowBox[{"\[Nu]", "^", "2"}]}]}], ")"}], 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", "-", 
                RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "^", "2"}], " ", "/",
            "4"}]}], " ", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"27", "/", "4"}], " ", "-", 
            RowBox[{"39", "\[Nu]"}], "+", 
            RowBox[{
             RowBox[{"5", "/", "4"}], 
             RowBox[{"\[Nu]", "^", "2"}]}]}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"1", "-", 
              RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"4", "\[Nu]"}]}], "]"}], "/", "2"}]}]}], ")"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003383993993164*^9, 4.003384014714073*^9}, {
  4.0033848306894455`*^9, 4.003385144591364*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"117469d6-d48b-8e47-8bb4-98ff4d1e9fd7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bindingEnergySS", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"-", "\[Nu]"}], " ", 
    RowBox[{
     RowBox[{"\[Chi]", "^", "2"}], " ", "/", "2"}], " ", 
    RowBox[{"x", "^", "3"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "4"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "-", 
               RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "^", "2"}], " ", "/",
           "4"}], ")"}], "^", "2"}]}], " ", "+", 
      RowBox[{"4", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "-", 
             RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "^", "2"}], " ", "/", 
        "4"}], " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "/", "2"}], " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
