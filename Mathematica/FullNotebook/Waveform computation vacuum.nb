           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "+", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "/", "2"}], " ", 
              "\[Chi]"}], " ", "+", 
             RowBox[{"4", " ", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"B2", "[", "\[Chi]", "]"}], ",", " ", "60"}], 
               "]"}]}]}], ")"}]}], " ", "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"1", "-", 
                RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "/", "2"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], "/", "3"}], " ", 
              RowBox[{"(", 
               RowBox[{"23", "+", 
                RowBox[{"30", " ", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"\[Chi]", "^", "2"}]}], "]"}]}]}], ")"}], 
              "\[Chi]"}], " ", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"7", "-", 
                RowBox[{"12", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{"1", "-", 
                   RowBox[{"\[Chi]", "^", "2"}]}], "]"}]}]}], ")"}], 
              RowBox[{"\[Chi]", "^", "3"}]}]}], ")"}]}], "-", 
          RowBox[{"\[Nu]", " ", "x"}], " ", "-", 
          RowBox[{"3", 
           RowBox[{"\[Chi]", "^", "2"}], " ", "\[Nu]", " ", "x"}], " ", "+", 
          RowBox[{"\[Nu]", " ", "\[Chi]", " ", 
           RowBox[{"x", "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}], " ", "+", 
          RowBox[{"3", "\[Nu]", " ", 
           RowBox[{"\[Chi]", "^", "3"}], " ", 
           RowBox[{"x", "^", 
            RowBox[{"(", 
             RowBox[{"3", "/", "2"}], ")"}]}]}]}], ")"}]}]}], ")"}]}], " ", "+", 
    RowBox[{
     RowBox[{"16", "/", "5"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{"4", "\[Nu]"}]}], "]"}]}], ")"}], "/", "2"}], ")"}], "^", 
      "2"}], " ", 
     RowBox[{"\[Nu]", "^", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"\[Chi]", "^", "2"}]}], "]"}]}], ")"}], 
     RowBox[{"x", "^", "9"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"3", 
        RowBox[{"\[Chi]", "^", "2"}]}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0032966776798744`*^9, 4.003296787672987*^9}, {
  4.003296851876066*^9, 4.0032973901546097`*^9}, {4.0032977316989574`*^9, 
  4.0032977877308273`*^9}, {4.0032996498538475`*^9, 4.0032996528428802`*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"ed432d35-678d-734d-bb0e-86ef3f2e8eda"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Hybridized fluxes", "Subsection",
 CellChangeTimes->{{4.0032100838250027`*^9, 
  4.0032100947707176`*^9}},ExpressionUUID->"613b4d0e-e173-ef4d-a1fb-\
05b3223d17c2"],

Cell["\<\
To get the hybridized expression, we add the 1SF and and 4PN fluxes, and we \
substract the doubly-counted common terms. This last step amount to factorize \
the LO behaviour in \[Nu] and then set \[Nu] to 0. In \
\[OpenCurlyQuote]factorizedPNInfFlux\[CloseCurlyQuote], we write the PN flux \
divided by the leading behaviour \[Nu]\.b2:\
\>", "Text",
 CellChangeTimes->{{4.0032101045676327`*^9, 4.003210237621828*^9}, {
  4.003210715429035*^9, 
  4.0032107767730103`*^9}},ExpressionUUID->"f1ff4155-1c7e-9c47-a12e-\
aa097e4c9bbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"factorizedPNInfFlux", "[", 
    RowBox[{"x_", ",", "\[Nu]_", ",", "\[Chi]_"}], "]"}], "=", 
   RowBox[{"Cancel", "[", 
    RowBox[{
     RowBox[{"totalPNFluxInf", "[", 
      RowBox[{"x", ",", "\[Nu]", ",", "\[Chi]"}], "]"}], "/", 
     RowBox[{"\[Nu]", "^", "2"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003290783400467*^9, 4.003290783400467*^9}, {
  4.00329084802083*^9, 
  4.0032908710842476`*^9}},ExpressionUUID->"2ccd8aeb-e609-1941-b206-\
dfa4a8321aec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HybridFluxInf", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]", "^", "2"}], " ", 
     RowBox[{"fluxInf0PA", "[", 
      RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]}], "+", 
    RowBox[{"totalPNFluxInf", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"\[Nu]", "^", "2"}], " ", 
     RowBox[{"factorizedPNInfFlux", "[", 
      RowBox[{"x", ",", " ", "0", ",", " ", "\[Chi]"}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.003210916333645*^9, 4.0032109425186825`*^9}, {
  4.00321098078043*^9, 4.0032110817415657`*^9}, {4.0032120266924057`*^9, 
  4.0032120446483097`*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"a5e9d0b4-f486-1b4b-beea-9bf7ff767d2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"factorizedPNHorFlux", "[", 
    RowBox[{"x_", ",", "\[Nu]_", ",", "\[Chi]_"}], "]"}], "=", 
   RowBox[{"Cancel", "[", 
    RowBox[{
     RowBox[{"totalPNFluxHor", "[", 
      RowBox[{"x", ",", "\[Nu]", ",", "\[Chi]"}], "]"}], "/", 
     RowBox[{"\[Nu]", "^", "2"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0032980285031586`*^9, 4.0032980392434444`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"f29edf6d-3dfb-7543-92c5-c6892f21039a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HybridFluxHor", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Nu]", "^", "2"}], " ", 
     RowBox[{"fluxHor0PA", "[", 
      RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]}], "+", 
    RowBox[{"totalPNFluxHor", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], "-", 
    RowBox[{
     RowBox[{"\[Nu]", "^", "2"}], " ", 
     RowBox[{"factorizedPNHorFlux", "[", 
      RowBox[{"x", ",", " ", "0", ",", " ", "\[Chi]"}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.003298052319191*^9, 4.00329808786112*^9}},
 CellLabel->"In[76]:=",ExpressionUUID->"233136ed-bba6-4143-8015-3cee1e7f5e5e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Fluxes comparison", "Subsection",
 CellChangeTimes->{{4.0032884783276367`*^9, 
  4.003288499725939*^9}},ExpressionUUID->"4d17e3a4-47b2-9540-8091-\
ac7d1cac0ee0"],

Cell[CellGroupData[{

Cell["Fluxes at infinity", "Subsubsection",
 CellChangeTimes->{{4.003298259120739*^9, 
  4.003298265619314*^9}},ExpressionUUID->"73abb659-4aa3-ba4d-80a0-\
bb5e3e4bd50d"],

Cell["\<\
Here, we plot the fluxes for 4PN, 0PA and hybrid models. We want an initial \
mass ratio q=14, which gives an initialsymmetric mass ratio:\
\>", "Text",
 CellChangeTimes->{{4.0032885164232197`*^9, 4.0032885464423294`*^9}, {
  4.0032889099173164`*^9, 
  4.0032889726784554`*^9}},ExpressionUUID->"e56c8542-6005-0e43-b237-\
5af7cc069829"],

Cell[BoxData[
 RowBox[{
  RowBox[{"nu0", "=", 
   RowBox[{"14", "/", 
    RowBox[{"15", "^", "2"}]}]}], ";"}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"fc5482da-9af3-3442-9d75-c77c852323dc"],

Cell["We normalize by the newtonian flux:", "Text",
 CellChangeTimes->{{4.003289223022091*^9, 
  4.0032892319853725`*^9}},ExpressionUUID->"8b986f83-d1fe-3e40-86a3-\
9e91362cca2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fluxNewton", "[", 
    RowBox[{"x_", ",", "nu_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"32", "/", "5"}], ")"}], " ", 
    RowBox[{"nu", "^", "2"}], " ", 
    RowBox[{"x", "^", "5"}]}]}], ";"}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"9451d045-b8fd-3e41-a878-b4b6fa711e7d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"panel", "[", 
      RowBox[{"chi0_", ",", "xmin_", ",", "xmax_"}], "]"}], ":=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"nu0", "^", "2"}], 
            RowBox[{"fluxInf0PA", "[", 
             RowBox[{"x", ",", "chi0"}], "]"}]}], ",", 
           RowBox[{"totalPNFluxInf", "[", 
            RowBox[{"x", ",", "nu0", ",", "chi0"}], "]"}], ",", 
           RowBox[{"HybridFluxInf", "[", 
            RowBox[{"x", ",", "nu0", ",", "chi0"}], "]"}]}], "}"}], "/", 
         RowBox[{"fluxNewton", "[", 
          RowBox[{"x", ",", "nu0"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Orange", ",", "Blue", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<0PA\>\"", ",", "\"\<PN\>\"", ",", "\"\<Hybrid\>\""}], 
         "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<F\[Infinity]/FN\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{"\"\<q = 14, \[Chi] = \>\"", ",", "chi0"}], "}"}], "]"}]}], 
       ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"panel", "[", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", "0.086", ",", "0.228"}], "]"}], ",", 
      RowBox[{"panel", "[", 
       RowBox[{"0", ",", "0.091", ",", 
        RowBox[{"1", "/", "6"}]}], "]"}], ",", 
      RowBox[{"panel", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}], ",", "0.079", ",", "0.135"}], 
       "]"}]}], "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0032889033168488`*^9, 4.0032889033168488`*^9}, 
   4.003289300978157*^9, {4.0032894102407494`*^9, 4.0032894634918385`*^9}, {
   4.003290974561182*^9, 4.0032909916296444`*^9}},
