  4.004418577828373*^9}},ExpressionUUID->"8f7f3efa-95c1-5949-89ce-\
6586be1d0ce7"],

Cell["\<\
Here, we write the PN amplitudes for a (2 2) mode amplitude chosen to be \
real-valued. 4PN expression of the (2 2) mode:\
\>", "Text",
 CellChangeTimes->{{4.004422263309273*^9, 4.0044223218847637`*^9}, {
  4.004422516088661*^9, 4.00442252757218*^9}, {4.0044233944548492`*^9, 
  4.0044233967548103`*^9}},ExpressionUUID->"a0271e50-738d-6e4e-a30d-\
9354e631bedb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ampl22", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"64", " ", 
      RowBox[{"\[Pi]", "/", "5"}]}], "]"}], "\[Nu]", " ", "x", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "107"}], "/", "42"}], " ", "+", 
         RowBox[{
          RowBox[{"55", "/", "42"}], " ", "\[Nu]"}]}], ")"}], "x"}], " ", "+", 
      RowBox[{"2", " ", "\[Pi]", " ", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"3", "/", "2"}], ")"}]}]}], " ", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2173"}], "/", "1512"}], " ", "-", " ", 
