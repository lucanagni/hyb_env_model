       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<q = 14, \[Chi] = \>\"", ",", "\[Chi]0"}], "}"}], 
        "]"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"ImageSize", "->", "500"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
