Cell[CellGroupData[{

Cell["Computation of mode amplitudes", "Section",
 CellChangeTimes->{{4.0044138883510647`*^9, 
  4.0044139017274055`*^9}},ExpressionUUID->"e558f27d-2b76-3348-a08a-\
c3eb852869c8"],

Cell[CellGroupData[{

Cell["Mode amplitudes in SF", "Subsection",
 CellChangeTimes->{{4.0044139190468063`*^9, 
  4.004413926434656*^9}},ExpressionUUID->"4aa974fe-cdc8-3145-bef2-\
91dc06b5fe8e"],

Cell[CellGroupData[{

Cell["Evaluate the spherical harmonics coeff at the nodes", "Subsubsection",
 CellChangeTimes->{{4.004416388342823*^9, 
  4.0044164269488583`*^9}},ExpressionUUID->"8627ccd8-285b-ff49-99f7-\
822740fff18b"],

Cell["\<\
In SF, the amplitudes are expressed in the spheroidal harmonics basis, while \
in PN the spherical harmonics basis is used. To hybridize the expression, one \
may first express the SF amplitudes in the spherical harmonics basis, ie \
perform a change of basis. The Teukolsky package gives the coeff needed. \
First, we construct the Chebyshev grid (same as before):\
\>", "Text",
 CellChangeTimes->{{4.0044164385526676`*^9, 4.004416574909851*^9}, {
  4.004416701782181*^9, 4.004416738975378*^9}, {4.004416798373501*^9, 
  4.004416854243046*^9}},ExpressionUUID->"37c701fe-b329-6b43-951d-\
7d13368cd670"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nR", " ", "=", " ", "18"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n\[Chi]", " ", "=", " ", "27"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodesX", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "i"}], " ", "+", "1"}], ")"}], 
       RowBox[{"\[Pi]", " ", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "nR"}], " ", ")"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"nR", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nodesY", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "j"}], " ", "+", "1"}], ")"}], 
       RowBox[{"\[Pi]", " ", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "n\[Chi]"}], " ", ")"}]}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", 
       RowBox[{"n\[Chi]", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lmax", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ndigit", " ", "=", " ", "64"}], ";"}]}], "Input",ExpressionUUID->\
"4ed0b6cf-4c8e-2a4a-b6f8-a87243e1c7e2"],

Cell["\<\
Then, the function giving the spherical coeff for a point in the grid:\
\>", "Text",
 CellChangeTimes->{{4.004416895985029*^9, 
  4.004416917198803*^9}},ExpressionUUID->"453e7ec5-f5dd-e847-bd65-\
97ab0a562353"],

Cell["Finally, we evaluate the function on the 2D grid:", "Text",
 CellChangeTimes->{
  4.0044170564602585`*^9},ExpressionUUID->"f4ede493-bb03-0245-b17d-\
760c46caac68"],

Cell["\<\
We stock the data on a file, to avoid computing it every time:\
\>", "Text",
 CellChangeTimes->{
  4.0044170770000744`*^9},ExpressionUUID->"cbfd42b3-4c6c-214c-99f2-\
919c9aa36212"]
}, Open  ]],

Cell["Chebyshev interpolation", "Subsubsection",
 CellChangeTimes->{{4.004417112692852*^9, 
  4.0044171269171276`*^9}},ExpressionUUID->"ba7fa81f-5b01-ff45-87e0-\
9b742daf93f7"]
}, Open  ]],

