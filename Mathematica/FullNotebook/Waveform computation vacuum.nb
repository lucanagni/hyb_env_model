Cell["\<\
Now that we have written every piece, we can write the total 4PN binding \
energy:\
\>", "Text",
 CellChangeTimes->{{4.0033943946752567`*^9, 
  4.0033944127951946`*^9}},ExpressionUUID->"422d788a-d058-2f41-996d-\
49de9610c896"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"totalBindingEnergy4PN", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"bindingEnergyNS", "[", 
     RowBox[{"x", ",", " ", "\[Nu]"}], "]"}], "+", 
    RowBox[{"bindingEnergySO", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], "+", 
    RowBox[{"bindingEnergySS", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], "+", 
    RowBox[{"bindingEnergySSS", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.003394330841646*^9, 4.003394360678919*^9}, {
  4.0033944206872005`*^9, 4.0033945011170063`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"5f240210-6e52-c64d-bfd8-c59dba56242d"]
}, Closed]],

Cell[CellGroupData[{

Cell["Hybrid binding energy", "Subsection",
 CellChangeTimes->{{4.003394561870983*^9, 
  4.0033945691027107`*^9}},ExpressionUUID->"6f554178-4338-2240-a69f-\
6bacd31cd2a2"],

Cell["\<\
To get the hybridized expression, we add the 1SF and and 4PN binding \
energies, and we substract the doubly-counted common terms. This last step \
amount to factorize the LO behaviour in \[Nu] and then set \[Nu] to 0. In \
\[OpenCurlyQuote]factorizedBindingEnergy4PN\[CloseCurlyQuote], we write the \
PN binding energy divided by the leading behaviour \[Nu]:\
\>", "Text",
 CellChangeTimes->{{4.003394659929632*^9, 4.003394674660368*^9}, {
  4.0033948060009995`*^9, 
  4.003394816779068*^9}},ExpressionUUID->"d8105f55-4cab-7d41-9db3-\
1c1951a96445"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"factorizedBindingEnergy4PN", "[", 
    RowBox[{"x_", ",", "\[Nu]_", ",", "\[Chi]_"}], "]"}], "=", 
   RowBox[{"Cancel", "[", 
    RowBox[{
     RowBox[{"totalBindingEnergy4PN", "[", 
      RowBox[{"x", ",", "\[Nu]", ",", "\[Chi]"}], "]"}], "/", "\[Nu]"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003394776544626*^9, 4.0033947945133934`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"313ed09f-5203-cd4f-8eb5-234d84c3d2c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"HybridBindingEnergy", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Nu]", " ", 
     RowBox[{"geoBindingEnergy", "[", 
      RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]}], "+", 
    RowBox[{"totalBindingEnergy4PN", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], "-", 
    RowBox[{"\[Nu]", " ", 
     RowBox[{"factorizedBindingEnergy4PN", "[", 
      RowBox[{"x", ",", "0", ",", "\[Chi]"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0033948487607155`*^9, 4.0033949527683887`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"403ca4ff-c54b-134f-92e5-ad95dcdcdd6d"]
}, Closed]],

Cell[CellGroupData[{

Cell["Comparison of the binding energy for the different models", "Subsection",
 CellChangeTimes->{{4.003394983279093*^9, 
  4.00339499620648*^9}},ExpressionUUID->"d088a1f4-b3b8-ae41-960f-\
a2738d914d51"],

Cell["\<\
To compare the binding energies from the different models, we shift them so \
they all vanish at t_initial.\
\>", "Text",
 CellChangeTimes->{{4.0034807662951145`*^9, 
  4.00348085229056*^9}},ExpressionUUID->"903326a6-28ba-5547-98a3-\
7d551fb71a15"],

