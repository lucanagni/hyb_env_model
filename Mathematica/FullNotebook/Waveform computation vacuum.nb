          RowBox[{"34", "/", "21"}], " ", "\[Nu]"}]}], ")"}], "\[Pi]", " ", 
       RowBox[{"x", "^", 
        RowBox[{"(", 
         RowBox[{"5", "/", "2"}], ")"}]}]}], "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"27027409", "/", "646800"}], " ", "-", 
         RowBox[{
          RowBox[{"856", "/", "105"}], " ", "EulerGamma"}], " ", "+", 
         RowBox[{"2", 
          RowBox[{
           RowBox[{"\[Pi]", "^", "2"}], "/", "3"}]}], " ", "+", 
