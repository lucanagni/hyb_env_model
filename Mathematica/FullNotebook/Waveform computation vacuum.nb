Cell["\<\
We stock the data on a file, to avoid computing it every time:\
\>", "Text",
 CellChangeTimes->{{4.0029481278096504`*^9, 
  4.002948152863348*^9}},ExpressionUUID->"56cd6dde-3631-ae46-ba72-\
576a60bad4ce"],

Cell[BoxData[
 RowBox[{"Save", "[", 
  RowBox[{
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      ",", "\"\<fluxesGrid_lmax=5.dat\>\""}], "}"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "fluxesGrid", ",", "nodesX", ",", "nodesY", ",", "nR", ",", "n\[Chi]", ",",
      "lmax", ",", "Ndigit"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.003221072822134*^9, 4.0032210880895367`*^9}, {
  4.0032211430611115`*^9, 4.0032211512989273`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"04deccea-2313-c84b-bd28-c3d5cf7d067a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], 
     ",", "\"\<fluxesGrid_lmax=5.dat\>\""}], "}"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{4.0032211983497486`*^9, 4.0032212141333504`*^9}, {
  4.0045228452687416`*^9, 4.004522846484701*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"d95d4716-3e43-284f-bb01-d7a0cb57c6ac"],

Cell[BoxData["64"], "Output",
 CellChangeTimes->{4.0032890691541195`*^9, 4.004522847551777*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"57914534-cc92-1f47-96f0-003d613913a0"]
}, Open  ]],

Cell["\<\
And we can extract the null infinity and horizon fluxes, where the PN leading \
behaviour is factorized:\
\>", "Text",
 CellChangeTimes->{{4.0028950989398327`*^9, 
  4.0028951470688553`*^9}},ExpressionUUID->"a61465ed-1901-964e-bcb1-\
0eec1eef429b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fInfinityGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rp", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{
             RowBox[{"KerrGeoISCO", "[", 
              RowBox[{
               RowBox[{"nodesY", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", "1"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"nodesX", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], ",", "Ndigit"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"rp", "^", "5"}], " ", 
        RowBox[{"fluxesGrid", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nR"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n\[Chi]"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.002892439200243*^9, 4.002892471392748*^9}, {
  4.002893774656027*^9, 4.0028937821589317`*^9}, {4.0028938259347763`*^9, 
  4.002893827882782*^9}, {4.0028950303995857`*^9, 4.002895035371031*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"520c6381-8130-984b-ba6c-24be9cb8dacc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fHorizonGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rp", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{
             RowBox[{"KerrGeoISCO", "[", 
              RowBox[{
               RowBox[{"nodesY", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", "1"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"nodesX", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], ",", "Ndigit"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"rp", "^", 
         RowBox[{"(", 
          RowBox[{"15", "/", "2"}], ")"}]}], " ", 
        RowBox[{"fluxesGrid", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j", ",", "2"}], "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "nR"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n\[Chi]"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.00289387446023*^9, 4.0028939195554905`*^9}, {
  4.0028950385539036`*^9, 4.002895039561697*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"d23b862d-0fea-5545-8921-86521c442828"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Chebyshev interpolation", "Subsubsection",
 CellChangeTimes->{{4.0028804835964146`*^9, 
  4.002880492026663*^9}},ExpressionUUID->"99265ca7-03b0-0241-b008-\
9cc259d3e423"],

Cell["\<\
From fInfinityGrid and fHorizonGrid, we can perform a Chebyshev \
interpolation. \
\>", "Text",
 CellChangeTimes->{{4.00289515399436*^9, 
  4.002895196340292*^9}},ExpressionUUID->"229bb887-4468-8344-bd4c-\
91d272b3c77e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fInfinityInterp", "=", 
   RowBox[{"ListInterpolation", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"fInfinityGrid", ",", "Ndigit"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"nodesX", ",", "Ndigit"}], "]"}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"nodesY", ",", "Ndigit"}], "]"}]}], "}"}], ",", 
     RowBox[{"InterpolationOrder", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nR", "-", "1"}], ",", 
        RowBox[{"n\[Chi]", "-", "1"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.00289550035647*^9, 4.002895524604494*^9}, {
  4.002896709003359*^9, 4.002896711833311*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"386e26d3-9fdd-884c-a052-42eab69483ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fHorizonInterp", "=", 
   RowBox[{"ListInterpolation", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"fHorizonGrid", ",", "Ndigit"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"nodesX", ",", "Ndigit"}], "]"}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"nodesY", ",", "Ndigit"}], "]"}]}], "}"}], ",", 
     RowBox[{"InterpolationOrder", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nR", "-", "1"}], ",", 
        RowBox[{"n\[Chi]", "-", "1"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0028956683448677`*^9, 4.0028956770739594`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"099ae967-eaf2-b142-8361-d4be61ecc265"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot of the interpolation function for the fux at infinity", \
"Subsubsection",
 CellChangeTimes->{{4.0028822437050343`*^9, 4.0028822516458664`*^9}, {
  4.002951597909527*^9, 
  4.002951607057049*^9}},ExpressionUUID->"a3953b0b-87ae-704b-aac6-\
bccebf7dc029"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"fInfinityInterp", "[", 
    RowBox[{"rC", ",", "\[Chi]C"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"rC", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Chi]C", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"Contours", "->", "20"}], ",", 
   RowBox[{"ContourStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Thin"}], "]"}]}], ",", 
   RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<rC\>\"", ",", "\"\<\[Chi]C\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"PlotPoints", "->", "50"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{4.0028966929937973`*^9, 4.002896698295742*^9}, {
  4.004522865068468*^9, 4.004522866083929*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"4fb6c4df-8452-e542-946a-5190e81edd8e"],

