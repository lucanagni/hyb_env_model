          RowBox[{"1069", "/", "216"}], " ", "\[Nu]"}], " ", "+", 
         RowBox[{
          RowBox[{"2047", "/", "1512"}], " ", 
          RowBox[{"\[Nu]", "^", "2"}]}]}], ")"}], 
       RowBox[{"x", "^", "2"}]}], " ", "+", " ", 
