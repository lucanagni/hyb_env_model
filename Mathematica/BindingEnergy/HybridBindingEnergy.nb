Cell[CellGroupData[{

Cell["Hybrid binding energy", "Chapter",ExpressionUUID->"b0ccc2a0-e0e3-451d-a342-61cd704951a0"],

Cell["\<\
EhatHyb = E_H/(\[Nu] M) (eq. 47 at 0PA); HybridBindingEnergy[x, \[Nu], \
\[Chi]] = \[Nu] M EhatHyb with M = 1.\
\>", "Text",ExpressionUUID->"a1242a82-4425-4137-ad26-5c84bc5eaf50"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EhatHyb", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{
    RowBox[{"EhatGeo", "[", 
     RowBox[{"x", ",", " ", "\[Chi]"}], "]"}], " ", "+", " ", 
    RowBox[{"EhatPN", "[", 
     RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], " ", "-", 
    " ", 
    RowBox[{"EhatPN0", "[", 
     RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"HybridBindingEnergy", "[", 
   RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"\[Nu]", "*", 
   RowBox[{"EhatHyb", "[", 
    RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}]}]}]}], "Input",\
ExpressionUUID->"bac9707e-1268-4949-a85b-37fa6f1c1dcc"],

Cell["\<\
Newtonian-normalised energies E/(-\[Nu] M x/2) for q = 14 (as in Honet Figs. \
9-10), up to the ISCO (gray line).\
\>", "Text",ExpressionUUID->"acf87f48-a128-4961-bed0-e1d0ba0243dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"blue", " ", "=", " ", 
   RowBox[{
    RowBox[{"ColorData", "[", "97", "]"}], "[", "1", "]"}]}], ";"}], "\n", 
