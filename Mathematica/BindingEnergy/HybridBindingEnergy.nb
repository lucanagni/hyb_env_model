Cell["\<\
Quality of the comparison. 0PA and PN reproduce the paper's orange and blue \
curves to within 0.2% (|ours/Fig.10 - 1| = 0.18%, 0.14%, 0.15% for 0PA and \
0.11%, 0.06%, 0.02% for PN at \[Chi] = 0.5, 0, -0.5), i.e. at the reading \
precision of the figure (about 1 pixel). This validates eq. (48), the \
conservative PN energy, the spin map, \[Nu] = 14/225 and the shift convention.\
\>", "Text",ExpressionUUID->"de7dd3d9-3b6a-4e13-b64b-c227c69937e9"],

Cell["\<\
The 0PA hybrid does not reproduce the paper's red curve near the ISCO: at the \
right edge it is 1.1% (\[Chi] = 0.5), 4.5% (\[Chi] = 0) and 7.4% (\[Chi] = \
-0.5) less bound than the paper's Hybrid, and lies between the 0PA and PN \
curves. The difference is the missing 1PA term \[Nu]^2 M (E^SF_(1) - \
E^(SF|PN)_(1)), the 1SF energy beyond 4PN. In the paper this term partly \
cancels the 0PA beyond-4PN remainder \[Nu] M (EhatGeo - EhatPN0), so their \
Hybrid sits close to PN and NR; without it the 0PA hybrid is farther from NR \
than PN near the ISCO. The binding energy needs the 1PA redshift term before \
it is used in the waveform model.\
\>", "Text",ExpressionUUID->"33395b7e-c102-4c0d-9dd7-494882264d12"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Checks", "Chapter",ExpressionUUID->"afb50a3e-0fbe-4504-974c-059df67b1460"],

Cell[CellGroupData[{

Cell["PN sectors vs PNpedia", "Section",ExpressionUUID->"57325e7c-710e-4ed1-961c-927aa3b784e8"],

Cell["\<\
Expect {0, 0, 0}: (1) the four sectors sum back to the spinning conservative \
file; (2) the nonspinning sector equals the nonspinning conservative file; \
(3) binding = conservative + Schott in the PNpedia files.\
\>", "Text",ExpressionUUID->"1ce3007c-5a24-4830-bce3-0bf6f1250a31"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "pnDir", " ", "=", " ", 
   "\"\</home/luca/repos/PNpedia/Core post-Newtonian quantities/Circular \
orbits\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readPN", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"ToExpression", "[", 
     RowBox[{"Import", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"pnDir", ",", " ", "f"}], "}"}], "]"}], ",", " ", 
       "\"\<Text\>\""}], "]"}], "]"}], " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"c", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"G", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"m", " ", "->", " ", "1"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
  "eDir", " ", "=", " ", 
   "\"\<Spinning/Nonprecessing/Without tidal effects/Constants of \
motion/Energy/\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eCons", " ", "=", " ", 
   RowBox[{"readPN", "[", 
    RowBox[{"eDir", " ", "<>", " ", "\"\<energy_conservative.txt\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eBind", " ", "=", " ", 
   RowBox[{"readPN", "[", 
    RowBox[{"eDir", " ", "<>", " ", "\"\<energy_binding.txt\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"eSchott", " ", "=", " ", 
   RowBox[{"readPN", "[", 
    RowBox[{"eDir", " ", "<>", " ", "\"\<energy_Schott.txt\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"eConsNS", " ", "=", " ", 
   RowBox[{
   "readPN", "[", 
    "\"\<Nonspinning/Without tidal effects/Constants of \
motion/Energy/energy_conservative.txt\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"EPN", "[", 
      RowBox[{
      "x", ",", " ", "\[Nu]", ",", " ", "s", ",", " ", "\[Sigma]", ",", " ", 
       "\[Delta]"}], "]"}], " ", "-", " ", "eCons"}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"EOrb", "[", 
       RowBox[{"\[Nu]", ",", " ", "x"}], "]"}], " ", "-", " ", "eConsNS"}], 
     ",", " ", 
     RowBox[{"x", " ", ">", " ", "0"}]}], "]"}], ",", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"eBind", " ", "-", " ", "eCons", " ", "-", " ", "eSchott"}], 
    "]"}]}], "}"}]}], "Input",ExpressionUUID->"bc8b4de0-bf97-4df8-9479-\
272cbc375a6e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0"}], "}"}]], "Output",ExpressionUUID->\
