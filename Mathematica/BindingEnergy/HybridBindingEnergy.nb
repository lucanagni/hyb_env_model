       RowBox[{"-", "0.5"}], ",", " ", "0.079", ",", " ", "0.140", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.001"}], ",", " ", "0."}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Eshift", "[", 
    RowBox[{"f_", ",", " ", "xi_", ",", " ", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{"nuF", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], " ", "-", " ", 
      RowBox[{"f", "[", "xi", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"models", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"EhatHyb", "[", 
       RowBox[{"#", ",", " ", "nuF", ",", " ", "a"}], "]"}], " ", "&"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"EhatGeo", "[", 
       RowBox[{"#", ",", " ", "a"}], "]"}], " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"EhatPN", "[", 
       RowBox[{"#", ",", " ", "nuF", ",", " ", "a"}], "]"}], " ", "&"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fig10Panel", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", " ", "xi_", ",", " ", "xf_", ",", " ", "yr_"}], "}"}],
     "]"}], " ", ":=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Eshift", "[", 
         RowBox[{"#", ",", " ", "xi", ",", " ", "x"}], "]"}], " ", "&"}], " ",
        "/@", " ", 
       RowBox[{"models", "[", "a", "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xi", ",", " ", "xf"}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xi", ",", " ", "xf"}], "}"}], ",", " ", "yr"}], "}"}]}], 
     ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"red", ",", " ", "orange", ",", " ", "blue"}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\"\<Hybrid (0PA)\>\"", ",", " ", "\"\<0PA\>\"", ",", " ", 
          "\"\<PN\>\""}], "}"}], ",", " ", 
        RowBox[{"{", 
