Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"chis", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.9"}], ",", " ", 
     RowBox[{"-", "0.5"}], ",", " ", "0.", ",", " ", "0.5", ",", " ", "0.9"}],
     "}"}]}], ";"}], "\n", 
