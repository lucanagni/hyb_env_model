 RowBox[{
  RowBox[{"q", " ", "=", " ", "14"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuq", " ", "=", " ", 
   RowBox[{"q", "/", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "q"}], ")"}], "^", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"newtPlot", "[", "a_", "]"}], " ", ":=", " ", 
