     RowBox[{"\"\<x\>\"", ",", " ", "\"\<EhatGeo/(-x/2)\>\""}], "}"}]}], ",", 
   " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Row", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<\[Chi] = \>\"", ",", " ", "#"}], "}"}], "]"}], " ", 
       "&"}], " ", "/@", " ", "chis"}], ")"}]}]}], "]"}]}], "Input",Expression\
UUID->"514451bc-974a-44ef-be7d-368b3a28a104"],

