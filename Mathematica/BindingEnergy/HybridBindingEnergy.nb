          RowBox[{"-", "x"}], "/", "2"}], ")"}]}], ",", " ", 
       RowBox[{
        RowBox[{"EhatGeo", "[", 
         RowBox[{"x", ",", " ", "a"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "x"}], "/", "2"}], ")"}]}], ",", " ", 
       RowBox[{
        RowBox[{"EhatPN", "[", 
         RowBox[{"x", ",", " ", "nuq", ",", " ", "a"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "x"}], "/", "2"}], ")"}]}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0.01", ",", " ", 
       RowBox[{"xISCO", "[", "a", "]"}]}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
