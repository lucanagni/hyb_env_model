     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "\"\<Hybrid\>\"", ",", " ", "0.170", ",", " ", 
       RowBox[{"-", "0.001179"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5"}], ",", " ", "\"\<0PA\>\"", ",", " ", 
       "\"\<ISCO\>\"", ",", " ", 
       RowBox[{"-", "0.000668"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5"}], ",", " ", "\"\<PN\>\"", ",", " ", "0.140", ",", 
       " ", 
       RowBox[{"-", "0.000851"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.5"}], ",", " ", "\"\<Hybrid\>\"", ",", " ", "0.140", 
       ",", " ", 
       RowBox[{"-", "0.000814"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fig10Ours", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", " ", "mod_", ",", " ", "xp_", ",", " ", "ref_"}], 
     "}"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xi", " ", "=", " ", 
        RowBox[{
         RowBox[{"SelectFirst", "[", 
          RowBox[{"fig10", ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", "#", "]"}], " ", "==", " ", "a"}], " ", 
            "&"}]}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"xv", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"xp", " ", "===", " ", "\"\<ISCO\>\""}], ",", " ", 
          RowBox[{"xISCO", "[", "a", "]"}], ",", " ", "xp"}], "]"}]}], ",", 
       " ", "f", ",", " ", "e"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{"mod", ",", " ", "\"\<Hybrid\>\"", ",", " ", 
         RowBox[{
          RowBox[{"EhatHyb", "[", 
           RowBox[{"#", ",", " ", "nuF", ",", " ", "a"}], "]"}], " ", "&"}], 
         ",", " ", "\"\<0PA\>\"", ",", " ", 
         RowBox[{
          RowBox[{"EhatGeo", "[", 
           RowBox[{"#", ",", " ", "a"}], "]"}], " ", "&"}], ",", " ", 
         "\"\<PN\>\"", ",", " ", 
         RowBox[{
          RowBox[{"EhatPN", "[", 
           RowBox[{"#", ",", " ", "nuF", ",", " ", "a"}], "]"}], " ", "&"}]}],
         "]"}]}], ";", " ", 
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"Eshift", "[", 
        RowBox[{"f", ",", " ", "xi", ",", " ", "xv"}], "]"}]}], ";", " ", 
      RowBox[{"{", 
       RowBox[{
       "a", ",", " ", "mod", ",", " ", "xv", ",", " ", "ref", ",", " ", "e", 
        ",", " ", 
        RowBox[{
         RowBox[{"e", "/", "ref"}], " ", "-", " ", "1"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"fig10Ours", " ", "/@", " ", "fig10Ref"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{
       "\"\<\[Chi]\>\"", ",", " ", "\"\<model\>\"", ",", " ", "\"\<x\>\"", 
        ",", " ", "\"\<Fig. 10\>\"", ",", " ", "\"\<ours\>\"", ",", " ", 
        "\"\<ours/Fig.10 - 1\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",Expr\
essionUUID->"97962867-7fef-4108-a32b-fdaf97b0dc9f"],

