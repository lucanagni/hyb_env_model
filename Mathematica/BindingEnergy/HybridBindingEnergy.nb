Notebook[{

Cell[CellGroupData[{
Cell["Hybrid binding energy (0PA)", "Title",ExpressionUUID->"9a2f4e82-257a-4566-a9fe-f79cb691ef85"],

Cell["\<\
SF+PN hybrid binding energy after Honet+2025 Sec. III C, eq. (47), truncated \
at 0PA: the 1PA self-force term \[Nu]^2 M E^SF_(1) (eq. 49, from the 1SF \
redshift) and its PN overlap \[Nu]^2 M x \[CapitalSigma] E^(SF|PN)_(1) are \
left out. Divided by \[Nu] M:  \[CapitalEHat]_H(x, \[Nu], \[Chi]) = \
\[CapitalEHat]_geo(x, \[Chi]) + \[CapitalEHat]_PN(x, \[Nu], \[Chi]) - \
\[CapitalEHat]_PN(x, 0, \[Chi]),  the same composite as HybridInfFluxNewtNorm \
in Fluxes/HybridEnFluxes.nb. Units G = c = M = 1, x = (M \
\[CapitalOmega])^(2/3). The M vs m1 and evolving vs initial spin distinctions \
(\[Delta]M, \[Delta]\[Chi] terms of eq. 49) are 1PA and are ignored.\
\>", "Text",ExpressionUUID->"2629fdb7-e479-423a-b5f3-402636e61b2a"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",ExpressionUUID->"4d67efd2-354f-4f4e-a4e1-709f80c6cc99"],

Cell[CellGroupData[{

Cell["SF data: geodesic binding energy", "Chapter",ExpressionUUID->"12f99aeb-541a-4aa8-9a4a-da34b02b5731"],

Cell["\<\
EhatGeo[x, \[Chi]] = E_geo/(\[Nu] M), eq. (48), closed form from \
BindingEnergy.wl (also loads Fluxes/FluxInterpolation.wl for rISCO). xISCO[\
\[Chi]] = (rISCO^(3/2) + \[Chi])^(-2/3).\
\>", "Text",ExpressionUUID->"9f8d3773-64aa-4dad-a47a-d5649e5d0377"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "Get", "[", 
   "\"\</home/luca/repos/hyb_env_model/Mathematica/BindingEnergy/\
BindingEnergy.wl\>\"", "]"}], ";"}]], "Input",ExpressionUUID->"2f2aede7-0917-\
4813-a960-ab22e3a3a161"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EhatGeo", "[", 
  RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]], "Input",ExpressionUUID->\
"17499246-d9d4-40dd-a311-cbdead1ec42b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "1"}], "+", 
  FractionBox[
   RowBox[{"1", "-", 
    RowBox[{"2", " ", "x", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         SuperscriptBox["x", 
          RowBox[{"3", "/", "2"}]], " ", "\[Chi]"}]}], ")"}], 
      RowBox[{"1", "/", "3"}]]}]}], 
   SqrtBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox["x", 
         RowBox[{"3", "/", "2"}]], " ", "\[Chi]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{
        SuperscriptBox["x", 
         RowBox[{"3", "/", "2"}]], " ", "\[Chi]"}], "-", 
       RowBox[{"3", " ", "x", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            SuperscriptBox["x", 
             RowBox[{"3", "/", "2"}]], " ", "\[Chi]"}]}], ")"}], 
         RowBox[{"1", "/", "3"}]]}]}], ")"}]}]]]}]], "Output",ExpressionUUID->\
"9a4b5247-1424-430f-bffc-83d1c64435f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"xISCO", "[", "0.5", "]"}], ",", " ", 
   RowBox[{"xISCO", "[", "0.", "]"}], ",", " ", 
   RowBox[{"xISCO", "[", 
    RowBox[{"-", "0.5"}], "]"}]}], "}"}]], "Input",ExpressionUUID->"4a18aaf7-\
