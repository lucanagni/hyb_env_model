Cell[CellGroupData[{

Cell["Full PN binding energy", "Section",ExpressionUUID->"ad4b787b-dc5f-497b-b114-bfed82b9d0ca"],

Cell["\<\
Spin map for a spinning primary (m1, spin \[Chi]) and a nonspinning \
secondary, as in HybridEnFluxes.nb and HybridModes.nb (Honet eq. B6): s = (1 \
+ \[CapitalDelta])^2 \[Chi]/4, sg = -(1 + \[CapitalDelta]) \[Chi]/2, \
\[CapitalDelta] = Sqrt[1 - 4\[Nu]]. EhatPN = E_PN/(\[Nu] M); EhatPN0 is its \
\[Nu] -> 0 limit, i.e. the PN expansion of EhatGeo (the SF|PN overlap of eq. \
47).\
\>", "Text",ExpressionUUID->"deb470fb-2345-4cfb-83fb-5f7a6596af79"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EPN", "[", 
    RowBox[{
    "x_", ",", " ", "nu_", ",", " ", "s_", ",", " ", "sg_", ",", " ", "dl_"}],
     "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"EOrb", "[", 
     RowBox[{"nu", ",", " ", "x"}], "]"}], " ", "+", " ", 
    RowBox[{"ESO", "[", 
     RowBox[{
     "nu", ",", " ", "x", ",", " ", "s", ",", " ", "sg", ",", " ", "dl"}], 
     "]"}], " ", "+", " ", 
    RowBox[{"ESS", "[", 
     RowBox[{
     "nu", ",", " ", "x", ",", " ", "s", ",", " ", "sg", ",", " ", "dl"}], 
     "]"}], " ", "+", " ", 
    RowBox[{"ESSS", "[", 
     RowBox[{
     "nu", ",", " ", "x", ",", " ", "s", ",", " ", "sg", ",", " ", "dl"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]Of", "[", "\[Nu]_", "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"4", "*", "\[Nu]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sOf", "[", 
    RowBox[{"\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"\[Delta]Of", "[", "\[Nu]", "]"}]}], ")"}], "/", "2"}], 
      ")"}], "^", "2"}], "*", "\[Chi]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]Of", "[", 
    RowBox[{"\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", 
         RowBox[{"\[Delta]Of", "[", "\[Nu]", "]"}]}], ")"}], "/", "2"}], 
      ")"}]}], "*", "\[Chi]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"EhatPN", "[", 
    RowBox[{"x_", ",", " ", "\[Nu]_", ",", " ", "\[Chi]_"}], "]"}], " ", "=", 
   " ", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"EPN", "[", 
        RowBox[{"x", ",", " ", "\[Nu]", ",", " ", 
         RowBox[{"sOf", "[", 
          RowBox[{"\[Nu]", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
         RowBox[{"\[Sigma]Of", "[", 
          RowBox[{"\[Nu]", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
         RowBox[{"\[Delta]Of", "[", "\[Nu]", "]"}]}], "]"}], "/", "\[Nu]"}], 
      "]"}], ",", " ", "x", ",", " ", "Simplify"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"EhatPN0", "[", 
   RowBox[{"x_", ",", " ", "\[Chi]_"}], "]"}], " ", "=", " ", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"EhatPN", "[", 
        RowBox[{"x", ",", " ", "\[Nu]", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Nu]", ",", " ", "0", ",", " ", "0"}], "}"}]}], "]"}], 
     "]"}], ",", " ", "x", ",", " ", "Simplify"}], "]"}]}]}], "Input",Expressi\
onUUID->"e802ac6f-802a-4c3f-881a-63469572e4d0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["x", "2"]}], "+", 
