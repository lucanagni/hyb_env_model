Cell[CellGroupData[{

Cell["Test-mass limit", "Section",ExpressionUUID->"a077451b-1c99-46c0-9219-0f7b6592565a"],

Cell["\<\
EhatPN0 must equal the x-expansion of EhatGeo through x^5 (4PN): expect 0. \
The first missing terms are x^(11/2) (spin-orbit) and x^6.\
\>", "Text",ExpressionUUID->"e96b48ac-9af6-4225-8f6c-8fa2bd30327f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"EhatGeo", "[", 
       RowBox[{"x", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "]"}], 
   " ", "-", " ", 
   RowBox[{"EhatPN0", "[", 
    RowBox[{"x", ",", " ", "\[Chi]"}], "]"}]}], "]"}]], "Input",ExpressionUUID\
->"72d50b11-9751-4943-a3f1-c09ba1b085c0"],

Cell[BoxData["0"], "Output",ExpressionUUID->"357d31f0-6f73-4ed0-a91e-87a9b1214a20"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"nextGeo", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"EhatGeo", "[", 
        RowBox[{"x", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "6"}], "}"}]}], "]"}], "]"}], 
    " ", "-", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"EhatGeo", "[", 
        RowBox[{"x", ",", " ", "\[Chi]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}], "]"}]}], 
   "]"}]}]], "Input",ExpressionUUID->"c25dd530-1ce3-4d52-99ec-ec05ba3c72ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["5", "81"]}], " ", 
   SuperscriptBox["x", 
    RowBox[{"11", "/", "2"}]], " ", "\[Chi]", " ", 
   RowBox[{"(", 
    RowBox[{"729", "+", 
     RowBox[{"40", " ", 
      SuperscriptBox["\[Chi]", "2"]}]}], ")"}]}], "+", 
  FractionBox[
   RowBox[{"3", " ", 
    SuperscriptBox["x", "6"], " ", 
    RowBox[{"(", 
     RowBox[{"15309", "+", 
      RowBox[{"14688", " ", 
       SuperscriptBox["\[Chi]", "2"]}], "+", 
      RowBox[{"128", " ", 
       SuperscriptBox["\[Chi]", "4"]}]}], ")"}]}], "1024"]}]], "Output",Expres\
sionUUID->"a1f270ed-592d-41ae-8499-b9477c737e92"]
}, Open  ]],

Cell["Residual (EhatGeo - EhatPN0)/nextGeo: tends to 1 as x -> 0.", "Text",ExpressionUUID->"326150f9-4974-4f8d-918e-44815df6c9c2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"EhatGeo", "[", 
         RowBox[{"x0", ",", " ", "a"}], "]"}], " ", "-", " ", 
        RowBox[{"EhatPN0", "[", 
         RowBox[{"x0", ",", " ", "a"}], "]"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"nextGeo", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", " ", "->", " ", "x0"}], ",", " ", 
          RowBox[{"\[Chi]", " ", "->", " ", "a"}]}], "}"}]}], ")"}]}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"x0", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.02", ",", " ", "0.04", ",", " ", "0.06", ",", " ", "0.1"}],
         "}"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.5"}], ",", " ", "0.", ",", " ", "0.5"}], "}"}]}], 
      "}"}]}], "]"}], ",", " ", 
