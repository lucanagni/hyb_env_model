 CellLabel->"In[2]:=",ExpressionUUID->"ae11b85b-c05d-4498-89a7-0edd89689a45"],

Cell[CellGroupData[{

Cell["Try to reproduce flux grid ", "Section",
 CellChangeTimes->{{4.002085785951971*^9, 
  4.002085794790819*^9}},ExpressionUUID->"173b36cc-670a-44d1-92e6-\
8bfa61b49eca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", 
   RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nR", "=", "18"}], ";", 
  RowBox[{"nA", "=", "27"}], ";", 
  RowBox[{"lmax", "=", "8"}], ";", 
  RowBox[{"prec", "=", "60"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"node", "[", 
     RowBox[{"i_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "i"}], "+", "1"}], ")"}], " ", 
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "n"}], ")"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fluxAtNode", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rC", ",", "chi", ",", "a", ",", "x", ",", "rstar", ",", "r0", ",", 
       "orb", ",", 
       RowBox[{"FI", "=", "0"}], ",", 
       RowBox[{"FH", "=", "0"}], ",", "md"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rC", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"node", "[", 
          RowBox[{"i", ",", "nR"}], "]"}], ",", "prec"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"chi", "=", 
       RowBox[{"SetPrecision", "[", 
        RowBox[{
         RowBox[{"node", "[", 
          RowBox[{"j", ",", "nA"}], "]"}], ",", "prec"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{"Abs", "[", "chi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"x", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"chi", ">=", "0"}], ",", "1", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"retrograde", "=", 
        RowBox[{"x", "=", 
         RowBox[{"-", "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rstar", "=", 
       RowBox[{"KerrGeoISCO", "[", 
        RowBox[{"a", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"r0", "=", 
       RowBox[{"2", " ", 
        RowBox[{"rstar", "/", 
         RowBox[{"(", 
          RowBox[{"rC", "+", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"orb", "=", 
       RowBox[{"KerrGeoOrbit", "[", 
        RowBox[{"a", ",", "r0", ",", "0", ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"md", "=", 
          RowBox[{"TeukolskyPointParticleMode", "[", 
           RowBox[{
            RowBox[{"-", "2"}], ",", "l", ",", "m", ",", "orb"}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"FI", "+=", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"md", "[", "\"\<Fluxes\>\"", "]"}], "[", 
             "\"\<Energy\>\"", "]"}], "[", "\"\<\[ScriptCapitalI]\>\"", 
            "]"}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"factor", " ", "2"}], ":", "m"}], "<->", 
           RowBox[{"-", "m"}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"FH", "+=", 
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"md", "[", "\"\<Fluxes\>\"", "]"}], "[", 
             "\"\<Energy\>\"", "]"}], "[", "\"\<\[ScriptCapitalH]\>\"", 
            "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "2", ",", "lmax"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "1", ",", "l"}], "}"}]}], "\[IndentingNewLine]", 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"rC", ",", "chi", ",", 
        RowBox[{
         RowBox[{"r0", "^", "5"}], " ", "FI"}], ",", 
        RowBox[{
         RowBox[{"r0", "^", 
          RowBox[{"(", 
           RowBox[{"15", "/", "2"}], ")"}]}], " ", "FH"}]}], "}"}]}]}], 
    "             ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"f", "^", "inf"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "^", "H"}], " ", "of", " ", 
        RowBox[{"Eqs", ".", 
         RowBox[{"(", "A13", ")"}]}]}], "-", 
       RowBox[{"(", "A14", ")"}]}]}], "*)"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002084878170657*^9, 4.002084894323542*^9}, {
   4.002085035197609*^9, 4.002085039996729*^9}, {4.002085178540971*^9, 
