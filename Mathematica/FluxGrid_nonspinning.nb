Cell[BoxData[{
 RowBox[{
  RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ParallelEvaluate", "[", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<KerrGeodesics`\>\"", "]"}], ";", 
    RowBox[{"Needs", "[", "\"\<Teukolsky`\>\"", "]"}], ";"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
